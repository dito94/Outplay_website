---
import { getImage } from 'astro:assets';
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SectionHead from '../../../../components/SectionHead.astro';
import Img from '../../../../components/Img.astro';
import Icon from '../../../../components/Icon.astro';
import HotspotScene from '../../../../components/HotspotScene.astro';
import LamellaDemo from '../../../../components/LamellaDemo.astro';
import Lightbox from '../../../../components/Lightbox.astro';
import InquiryForm from '../../../../components/InquiryForm.astro';
import SpecPlate from '../../../../components/SpecPlate.astro';
import SubNav from '../../../../components/SubNav.astro';
import ProductGallery from '../../../../components/ProductGallery.astro';
import ProductGrid from '../../../../components/ProductGrid.astro';
import VideoEmbed from '../../../../components/VideoEmbed.astro';
import StickyCta from '../../../../components/StickyCta.astro';
import type { Product } from '../../../../data/types';
import { products } from '../../../../data/products';
import { categories } from '../../../../data/categories';
import { diagramHotspots } from '../../../../data/hotspots';
import { site } from '../../../../data/site';
import { ui } from '../../../../data/ui';
import { LANGS, DEFAULT_LANG, getLang, url, categoryUrl, t, fmt } from '../../../../lib/i18n';
import { productImages, img, altOf } from '../../../../lib/images';

export function getStaticPaths() {
  return LANGS.flatMap((l) =>
    products.map((p) => ({
      params: { lang: l === DEFAULT_LANG ? undefined : l, category: p.category, product: p.id },
      props: { product: p },
    })),
  );
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
const lang = getLang(Astro.params.lang);
const category = categories.find((c) => c.id === product.category)!;

const T = {
  products: { bg: 'Продукти', en: 'Products' },
  quote: { bg: 'Направете запитване', en: 'Request a quote' },
  quoteShort: { bg: 'Запитване', en: 'Get a quote' },
  navOverview: { bg: 'Описание', en: 'Overview' },
  navTech: { bg: 'Технология', en: 'Technology' },
  navSpecs: { bg: 'Параметри', en: 'Specifications' },
  navGallery: { bg: 'Галерия', en: 'Gallery' },
  navInquiry: { bg: 'Запитване', en: 'Inquiry' },
  techTitle: { bg: 'Конструкцията отблизо', en: 'The structure up close' },
  techIntroHotspots: {
    bg: 'Изберете номер върху схемата, за да видите какво е вградено в конструкцията.',
    en: 'Select a number on the drawing to see what is built into the structure.',
  },
  techIntroFeatures: {
    bg: 'Основните елементи на конструкцията, събрани на една схема.',
    en: 'The main elements of the structure on one drawing.',
  },
  lamTitle: { bg: 'Светлина, сянка и въздух', en: 'Light, shade and air' },
  lamBalance: {
    bg: 'Един мотор завърта ламелите от 0° до 120°. Изберете условия или плъзнете скалата, за да видите как реагира покривът.',
    en: 'A single motor turns the louvres from 0° to 120°. Pick the conditions or drag the slider to see how the roof responds.',
  },
  lamInfinity: {
    bg: 'Ламелите се завъртат от 0° до 120°, а втори мотор ги събира в края на конструкцията и открива небето. Изберете условия, за да видите разликата.',
    en: 'The louvres turn from 0° to 120°, and a second motor gathers them at one end to open the roof to the sky. Pick the conditions to see the difference.',
  },
  galleryIntro: {
    bg: 'Снимки и визуализации на {name}. Отворете изображение, за да го разгледате в цял размер.',
    en: 'Photos and visualisations of {name}. Open any image to view it full size.',
  },
  relatedIntro: {
    bg: 'Други системи, които си струва да разгледате заедно с {name}.',
    en: 'Other systems worth considering alongside {name}.',
  },
  talk: { bg: 'Предпочитате да говорим?', en: 'Prefer to talk?' },
  viber: { bg: 'Пишете ни във Viber', en: 'Message us on Viber' },
};

const name = t(product.name, lang);
const { hero, gallery, diagram } = productImages(product.id);
const hotspots = diagramHotspots[product.id] ?? [];
const ratioOf = (p: string | undefined) => {
  const m = img(p);
  return m ? m.width / m.height : 1.5;
};

// Every photo appears once per page: the hero stays in the hero, each editorial row gets its own photo and
// the gallery shows only what is left. A gallery needs at least 3 photos; when the rows would leave fewer,
// rows give photos back so the gallery keeps 3 (only if at least 4 exist), otherwise the gallery is dropped.
const landscape = (p: string) => ratioOf(p) >= 1.1;
const sectionCount = product.sections.length;
const maxRows = Math.min(sectionCount, gallery.length);
const rowCount = gallery.length - maxRows >= 3 ? maxRows : gallery.length >= 4 ? gallery.length - 3 : maxRows;
// Rows prefer landscape photos (stable order); everything else is left for the gallery.
const rowImages = [...gallery].sort((a, b) => Number(landscape(b)) - Number(landscape(a))).slice(0, rowCount);
const leftover = gallery.filter((p) => !rowImages.includes(p));
const galleryImages = leftover.length >= 3 ? leftover : [];
const unusedImages = galleryImages.length ? [] : leftover;
// Spread the row photos evenly over the sections, always starting with the first one.
const imageAt = new Map<number, string>();
rowImages.forEach((src, k) => imageAt.set(Math.round((k * sectionCount) / rowImages.length), src));

let imageRow = 0;
const norm = (v: string) => v.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
const taglineKey = norm(t(product.tagline, lang));
const LEAD_MAX = 200;
const rows = product.sections.map((s, i) => {
  const image = imageAt.get(i);
  const flip = image ? imageRow++ % 2 === 1 : false;
  const ratio = image ? Math.min(1.6, Math.max(0.95, ratioOf(image))) : 1;
  // The hero already shows the tagline; when the first section repeats it, open without a visible heading.
  const intro = i === 0 && norm(t(s.heading, lang)) === taglineKey;
  // Only a short opening paragraph is set as a display-type lead; long ones stay body text.
  const lead = intro && t(s.paragraphs[0], lang).length <= LEAD_MAX;
  return { ...s, image, flip, ratio, intro, lead };
});

const hasTech = !!diagram;
const techWithHotspots = hasTech && hotspots.length > 0;
const featuresInTech = hasTech && !techWithHotspots;
const lamellaSeries = product.id === 'balance' ? 'balance' : product.id === 'infinity' ? 'infinity' : undefined;
const hasGallery = galleryImages.length > 0;

// Video: a real YouTube link gets its own band with the click-to-load player (poster from an unused photo,
// or a dark plate); any other link (the catalogue's generic outplay.bg/video page) is a compact link row
// placed in the gallery, technology or specs band.
const videoUrl = product.video?.url;
const isYouTube = !!videoUrl && /(?:youtube(?:-nocookie)?\.com|youtu\.be)\//i.test(videoUrl);
const videoPoster = isYouTube ? unusedImages.find(landscape) : undefined;
const videoSpot = !videoUrl ? undefined : isYouTube ? 'band' : hasGallery ? 'gallery' : hasTech ? 'technology' : 'specs';

// Alternate day / light-grey bands down the page; the lamella demo is always a night band.
const order = ['overview', hasTech && 'technology', lamellaSeries && 'lamella', 'specs', hasGallery && 'gallery', 'inquiry', 'related'].filter(
  Boolean,
) as string[];
const band: Record<string, string> = {};
let grey = false;
for (const k of order) {
  if (k === 'lamella') {
    band[k] = 'night';
    continue;
  }
  band[k] = grey ? 'mist' : '';
  grey = !grey;
}
band.video = band.gallery ?? band.specs;

const navItems = [
  { id: 'overview', label: t(T.navOverview, lang) },
  ...(hasTech ? [{ id: 'technology', label: t(T.navTech, lang) }] : []),
  { id: 'specs', label: t(T.navSpecs, lang) },
  ...(hasGallery ? [{ id: 'gallery', label: t(T.navGallery, lang) }] : []),
  { id: 'inquiry', label: t(T.navInquiry, lang) },
];

const related = product.related
  .map((id) => products.find((p) => p.id === id))
  .filter((p): p is Product => !!p);

const phone = site.phones[0];
const viber = site.viberUrl;
const longName = name.length > 14;

// JSON-LD (no offers / prices: every system is quoted individually)
const siteUrl = Astro.site ?? new URL('https://dito94.github.io');
let ldImage: string | undefined;
const heroMeta = img(hero);
if (heroMeta) {
  const out = await getImage({ src: heroMeta, width: Math.min(1600, heroMeta.width), format: 'jpg', quality: 82 });
  ldImage = new URL(out.src, siteUrl).href;
}
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: t(product.fullName, lang),
  alternateName: name,
  description: t(product.summary, lang),
  ...(ldImage ? { image: [ldImage] } : {}),
  brand: { '@type': 'Brand', name: 'OUTPLAY' },
  category: t(category.name, lang),
  url: new URL(Astro.url.pathname, siteUrl).href,
};
---

<Base
  lang={lang}
  title={t(product.fullName, lang)}
  description={t(product.summary, lang)}
  ogImage={hero}
  jsonLd={jsonLd}
>
  <!-- 1. Product hero -->
  <section class="p-hero" aria-labelledby="p-title">
    <div class="wrap">
      <Breadcrumbs
        lang={lang}
        items={[
          { label: t(T.products, lang), href: url(lang, '/products/') },
          { label: t(category.name, lang), href: categoryUrl(lang, category.id) },
          { label: name },
        ]}
      />
      <!-- Source order = phone order (title, photo, summary, CTA); from 901px the photo moves under the text -->
      <div class:list={['p-top', { 'no-media': !heroMeta }]}>
        <div class="p-titles">
          <h1 id="p-title" class:list={['p-h1', { 'is-long': longName }]} data-pid={product.id} data-pfield="name">{name}</h1>
          <p class="p-full">{t(product.fullName, lang)}</p>
        </div>
        {
          heroMeta && (
            <div class="p-hero-media">
              <div class="media p-hero-img">
                <Img
                  src={hero}
                  lang={lang}
                  alt={altOf(hero, lang) || t(product.fullName, lang)}
                  priority
                  sizes="(min-width: 1440px) 1330px, calc(100vw - 2 * clamp(16px, 4vw, 56px))"
                />
              </div>
            </div>
          )
        }
        <div class="p-intro">
          <p class="p-tagline" data-pid={product.id} data-pfield="tagline">{t(product.tagline, lang)}</p>
          <p class="lead p-sum" data-pid={product.id} data-pfield="summary">{t(product.summary, lang)}</p>
          <div class="btn-row p-ctas" data-sticky-cta-start>
            <a class="btn" href="#inquiry">{t(T.quote, lang)} <Icon name="arrow-right" class="arrow" /></a>
            <a class="btn btn-viber p-alt" href={viber}><Icon name="viber" /> Viber</a>
            <a class="p-phone p-alt num" href={`tel:${phone.e164}`}><Icon name="phone" size={18} /> {phone.display}</a>
          </div>
        </div>
      </div>
      <SpecPlate lang={lang} highlights={product.highlights} name={name} title={t(ui.product.highlights, lang)} id="p-plate" />
    </div>
  </section>

  <!-- 3. In-page navigation -->
  <SubNav lang={lang} items={navItems} title={name} cta={{ label: t(T.quoteShort, lang), href: '#inquiry' }} />

  <!-- 4. Overview: editorial rows -->
  <section id="overview" data-sn-section="overview" class:list={['section', 'p-overview', band.overview]}>
    <div class="wrap rows">
      {
        rows.map((r) =>
          r.image ? (
            <article class:list={['row', { flip: r.flip }]} data-reveal>
              <div class="row-text">
                {r.intro ? <h2 class="sr-only">{t(T.navOverview, lang)}</h2> : <h2 class="h2 rule">{t(r.heading, lang)}</h2>}
                <div class:list={['prose', { 'has-intro': r.intro, 'has-lead': r.lead }]}>
                  {r.paragraphs.map((p) => (
                    <p>{t(p, lang)}</p>
                  ))}
                </div>
              </div>
              <div class="row-media media" style={`aspect-ratio:${r.ratio.toFixed(3)}`}>
                <Img
                  src={r.image}
                  lang={lang}
                  alt={altOf(r.image, lang) || name}
                  sizes="(min-width: 1440px) 720px, (min-width: 900px) 52vw, 100vw"
                  widths={[480, 768, 1080, 1440]}
                />
              </div>
            </article>
          ) : (
            <article class="row-solo" data-reveal>
              {r.intro ? <h2 class="sr-only">{t(T.navOverview, lang)}</h2> : <h2 class="h2 rule">{t(r.heading, lang)}</h2>}
              <div class:list={['prose', { 'has-intro': r.intro, 'has-lead': r.lead }]}>
                {r.paragraphs.map((p) => (
                  <p>{t(p, lang)}</p>
                ))}
              </div>
            </article>
          ),
        )
      }
    </div>
  </section>

  <!-- 5. Technology in detail -->
  {
    hasTech && diagram && (
      <section id="technology" data-sn-section="technology" class:list={['section', band.technology]} aria-labelledby="tech-title">
        <div class="wrap">
          <SectionHead id="tech-title" title={t(T.techTitle, lang)} intro={t(techWithHotspots ? T.techIntroHotspots : T.techIntroFeatures, lang)} />
          <div class="tech-visual" style={`--dw:${img(diagram)?.width ?? 1000}px`} data-reveal>
            {techWithHotspots ? (
              <HotspotScene
                lang={lang}
                id={`${product.id}-diagram`}
                image={diagram}
                hotspots={hotspots}
                sizes="(min-width: 1440px) 860px, (min-width: 1000px) 62vw, 100vw"
              />
            ) : (
              <div class="tech-split">
                <div class="tech-diagram" style={`aspect-ratio:${ratioOf(diagram).toFixed(3)}`}>
                  <Img src={diagram} lang={lang} sizes="(min-width: 1440px) 860px, (min-width: 1000px) 62vw, 100vw" />
                </div>
                <ul class="ticks tech-ticks">
                  {product.features.map((f) => (
                    <li>{t(f, lang)}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
          {videoSpot === 'technology' && videoUrl && product.video && (
            <div class="p-vlink">
              <VideoEmbed lang={lang} url={videoUrl} title={t(product.video.title, lang)} id={`${product.id}-video`} />
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- 6. Lamella demo (Balance / Infinity) -->
  {
    lamellaSeries && (
      <section class="section night" data-sn-section="technology" aria-labelledby="lam-title">
        <div class="wrap">
          <SectionHead id="lam-title" title={t(T.lamTitle, lang)} intro={t(lamellaSeries === 'balance' ? T.lamBalance : T.lamInfinity, lang)} />
          <LamellaDemo lang={lang} series={lamellaSeries} id={`${product.id}-lamella`} />
        </div>
      </section>
    )
  }

  <!-- 7. Features, specifications, configurations, options -->
  <section id="specs" data-sn-section="specs" class:list={['section', band.specs]}>
    <div class="wrap">
      <div class:list={['spec-grid', { 'spec-only': featuresInTech }]}>
        {
          !featuresInTech && (
            <div class="spec-col" data-reveal>
              <h2 class="h3 rule">{t(ui.product.features, lang)}</h2>
              <ul class="ticks">
                {product.features.map((f) => (
                  <li>{t(f, lang)}</li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="spec-col" data-reveal>
          <h2 class="h3 rule" id="specs-title">{t(ui.product.specs, lang)}</h2>
          <table class="spec-table" aria-labelledby="specs-title">
            <tbody>
              {
                product.specs.map((s) => (
                  <tr>
                    <th scope="row">{t(s.label, lang)}</th>
                    <td>{t(s.value, lang)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="spec-note small muted">{t(ui.product.specsNote, lang)} {t(ui.product.noPrices, lang)}</p>
        </div>
      </div>

      {
        product.configurations && product.configurations.length > 0 && (
          <div class="confs" data-reveal>
            <h2 class="h3 rule">{t(ui.product.configurations, lang)}</h2>
            <ul
              class="conf-grid"
              data-n={product.configurations.length}
              style={`--cols:${product.configurations.length === 5 ? 6 : Math.min(product.configurations.length, 4)}`}
            >
              {product.configurations.map((c) => (
                <li class="conf">
                  <h3 class="conf-title">{t(c.title, lang)}</h3>
                  {c.text && <p class="conf-text">{t(c.text, lang)}</p>}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        product.options && product.options.length > 0 && (
          <div class="opts" data-reveal>
            <h2 class="h4 opts-title">{t(ui.product.options, lang)}</h2>
            <ul class="ticks opts-list">
              {product.options.map((o) => (
                <li>{t(o, lang)}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        videoSpot === 'specs' && videoUrl && product.video && (
          <div class="p-vlink">
            <VideoEmbed lang={lang} url={videoUrl} title={t(product.video.title, lang)} id={`${product.id}-video`} />
          </div>
        )
      }
    </div>
  </section>

  <!-- 8. Gallery (only photos not already shown above) -->
  {
    hasGallery && (
      <section id="gallery" data-sn-section="gallery" class:list={['section', band.gallery]} aria-labelledby="gallery-title">
        <div class="wrap">
          <SectionHead id="gallery-title" title={t(ui.product.gallery, lang)} intro={fmt(t(T.galleryIntro, lang), { name })} />
          <ProductGallery lang={lang} images={galleryImages} group="product" name={name} />
          {videoSpot === 'gallery' && videoUrl && product.video && (
            <div class="p-vlink">
              <VideoEmbed lang={lang} url={videoUrl} title={t(product.video.title, lang)} id={`${product.id}-video`} />
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- 9. Video (real YouTube links only) -->
  {
    videoSpot === 'band' && videoUrl && product.video && (
      <section class:list={['section', 'p-video', band.video, { joined: hasGallery }]} data-sn-section={hasGallery ? 'gallery' : 'specs'} aria-labelledby="video-title">
        <div class="wrap video-grid">
          <div class="video-copy" data-reveal>
            <h2 id="video-title" class="h2 rule">
              {t(ui.product.video, lang)}
            </h2>
            <p class="lead">{t(product.video.title, lang)}</p>
          </div>
          <VideoEmbed
            lang={lang}
            url={videoUrl}
            title={t(product.video.title, lang)}
            poster={videoPoster}
            showTitle={false}
            id={`${product.id}-video`}
          />
        </div>
      </section>
    )
  }

  <!-- 10. Inquiry -->
  <section id="inquiry" data-sn-section="inquiry" data-sticky-cta-hide class:list={['section', 'p-inquiry', band.inquiry]} aria-labelledby="inquiry-title">
    <div class="wrap inq-grid">
      <div class="inq-copy">
        <h2 id="inquiry-title" class="h2 rule">{fmt(t(ui.product.quoteTitle, lang), { product: name })}</h2>
        <p class="lead">{t(ui.product.quoteLead, lang)}</p>
        <p class="small muted">{t(ui.product.noPrices, lang)}</p>
      </div>
      <div class="inq-form">
        <InquiryForm lang={lang} productId={product.id} compact id="inquiry-form" />
      </div>
      <div class="inq-contacts">
        <p class="inq-k">{t(T.talk, lang)}</p>
        <ul>
          {
            site.phones.map((p) => (
              <li>
                <a class="num" href={`tel:${p.e164}`}>
                  <Icon name="phone" size={18} /> {p.display}
                </a>
              </li>
            ))
          }
          <li>
            <a href={viber}><Icon name="viber" size={18} /> {t(T.viber, lang)}</a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 11. Related -->
  {
    related.length > 0 && (
      <section class:list={['section', band.related]} aria-labelledby="related-title">
        <div class="wrap">
          <SectionHead id="related-title" title={t(ui.product.related, lang)} intro={fmt(t(T.relatedIntro, lang), { name })} />
          <ProductGrid lang={lang} products={related} headingLevel="h3" />
        </div>
      </section>
    )
  }

  {hasGallery && <Lightbox lang={lang} />}
  <StickyCta lang={lang} href="#inquiry" />
</Base>

<style>
  /* Hero */
  .p-hero {
    padding-top: var(--s-5);
    padding-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }
  .p-top {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-areas:
      'titles intro'
      'media media';
    gap: clamp(2.5rem, 1.5rem + 3vw, 4.5rem) clamp(2rem, 1rem + 4vw, 6rem);
    align-items: end;
    padding-top: clamp(2rem, 1.2rem + 3vw, 4.5rem);
  }
  .p-titles {
    grid-area: titles;
    display: grid;
    gap: var(--s-4);
    align-content: end;
  }
  .p-intro {
    grid-area: intro;
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }
  .p-hero-media {
    grid-area: media;
  }
  .p-h1 {
    font-weight: 300;
    font-size: clamp(3rem, 1.6rem + 6vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }
  .p-h1.is-long {
    font-size: clamp(2.3rem, 1.5rem + 3.4vw, 4.6rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }
  .p-full {
    max-width: 44ch;
    color: var(--muted);
    font-size: var(--step-0);
    padding-top: var(--s-4);
    border-top: 1px solid var(--hair);
  }
  .p-tagline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--step-3);
    line-height: 1.12;
    letter-spacing: -0.01em;
    max-width: 22ch;
    text-wrap: balance;
  }
  .p-sum {
    max-width: 52ch;
  }
  .p-ctas {
    margin-top: var(--s-3);
    align-items: center;
  }
  .p-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 52px;
    padding: 0 0.4rem;
    font-weight: 600;
    text-decoration: none;
  }
  .p-phone:hover {
    text-decoration: underline;
  }

  /* Hero photo: flush with the content grid; the brand bracket is drawn on the photo's own corners
     (black L-brackets on top, yellow at the bottom) and never reaches into the gutter. */
  .p-hero-media {
    --bw: 8px;
    --bl: clamp(40px, 2rem + 3vw, 88px);
    position: relative;
  }
  .p-hero-media::before,
  .p-hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
