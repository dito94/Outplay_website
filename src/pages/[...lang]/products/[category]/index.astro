---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SectionHead from '../../../../components/SectionHead.astro';
import Img from '../../../../components/Img.astro';
import Icon from '../../../../components/Icon.astro';
import CtaBand from '../../../../components/CtaBand.astro';
import ProductGrid from '../../../../components/ProductGrid.astro';
import type { Category, Product } from '../../../../data/types';
import { categories } from '../../../../data/categories';
import { products } from '../../../../data/products';
import { pages } from '../../../../data/pages';
import { ui } from '../../../../data/ui';
import { LANGS, DEFAULT_LANG, getLang, url, categoryUrl, productUrl, t } from '../../../../lib/i18n';
import { productImages, img } from '../../../../lib/images';

export function getStaticPaths() {
  return LANGS.flatMap((l) =>
    categories.map((c) => ({
      params: { lang: l === DEFAULT_LANG ? undefined : l, category: c.id },
      props: { category: c },
    })),
  );
}

interface Props {
  category: Category;
}
const { category } = Astro.props;
const lang = getLang(Astro.params.lang);

const T = {
  products: { bg: 'Продукти', en: 'Products' },
  quote: { bg: 'Направете запитване', en: 'Request a quote' },
  more: { bg: 'Прочетете повече', en: 'Read more' },
  less: { bg: 'Покажи по-малко', en: 'Show less' },
  inCat: { bg: 'продукта в категорията', en: 'products in this category' },
  inCatOne: { bg: 'продукт в категорията', en: 'product in this category' },
};

const isBio = category.id === 'bioclimatic-pergolas';
const inCat = products.filter((p) => p.category === category.id).sort((a, b) => a.order - b.order);

// No photo twice on a page: when the category photo is the same file as a listed product's card photo,
// the hero uses one of that product's gallery photos instead (wide ones first).
const fingerprint = (p: string | undefined) => {
  if (!p) return '';
  try {
    return createHash('md5')
      .update(readFileSync(join(process.cwd(), 'src/assets/img', p)))
      .digest('hex');
  } catch {
    return '';
  }
};
const catImage = `categories/${category.id}.jpg`;
const catPrint = fingerprint(catImage);
const clash = catPrint ? inCat.find((p) => fingerprint(productImages(p.id).hero) === catPrint) : undefined;
const heroImage =
  (clash &&
    [...productImages(clash.id).gallery].sort((a, b) => {
      const r = (x: string) => (img(x)?.width ?? 1) / (img(x)?.height ?? 1);
      return r(b) - r(a);
    })[0]) ||
  catImage;

// `sizes` for cropped photos (object-fit: cover): a photo wider than its box must be rendered at
// box height × photo ratio, or the browser picks a file that gets upscaled. Category photos are 2.4:1.
const arOf = (p: string) => {
  const m = img(p);
  return m ? m.width / m.height : 1.5;
};
// Hero: full-bleed, height clamp(540px, 82svh, 860px); phones clamp(460px, 64svh, 600px)
const heroAr = arOf(heroImage);
const heroSizes = [
  `(max-width: 600px) ${Math.ceil(64 * heroAr)}vh`,
  `(min-width: ${Math.ceil(860 * heroAr)}px) 100vw`,
  `${Math.ceil(82 * heroAr)}vh`,
].join(', ');
// "Other categories" tiles: 3 columns from 901px (427px × clamp(280px, 24vw, 360px) at 1440),
// one column below (content width × min 240px)
const tileSizes = (p: string) => {
  const ar = arOf(p);
  const phoneMin = Math.ceil(240 * ar);
  return [
    `(min-width: 1440px) ${Math.ceil(Math.max(427, 360 * ar))}px`,
    `(min-width: 1167px) ${Math.ceil(Math.max(31, 24 * ar))}vw`,
    `(min-width: 901px) ${Math.ceil(Math.max(361, 280 * ar))}px`,
    `(min-width: ${phoneMin}px) 100vw`,
    `${phoneMin}px`,
  ].join(', ');
};
const countLabel = t(inCat.length === 1 ? T.inCatOne : T.inCat, lang);

type Group = { id: string; title: string; intro?: string; items: Product[] };
const groups: Group[] = category.subgroups?.length
  ? category.subgroups.map((sg) => ({
      id: sg.id,
      title: t(sg.name, lang),
      intro: sg.description ? t(sg.description, lang) : undefined,
      items: sg.productIds.map((id) => inCat.find((p) => p.id === id)).filter((p): p is Product => !!p),
    }))
  : [{ id: 'all', title: t(ui.category.productsIn, lang), items: inCat }];
// Products not listed in any subgroup still need a home
const listed = new Set(groups.flatMap((g) => g.items.map((p) => p.id)));
const rest = inCat.filter((p) => !listed.has(p.id));
if (rest.length) groups.push({ id: 'more', title: t(ui.category.productsIn, lang), items: rest });

const others = categories.filter((c) => c.id !== category.id).sort((a, b) => a.order - b.order);
const [introLead, ...introRest] = category.intro;
const options = pages.home.options;

// Alternate grey / white after the intro
let grey = true;
const nextBand = () => {
  const b = grey ? 'mist' : '';
  grey = !grey;
  return b;
};
const groupBands = groups.map(() => nextBand());
const optionsBand = isBio ? nextBand() : '';
const othersBand = nextBand();
---

<Base
  lang={lang}
  title={t(category.title, lang)}
  description={`${t(category.tagline, lang)} ${t(introLead, lang)}`.slice(0, 300)}
  ogImage={`categories/${category.id}.jpg`}
  header="overlay"
>
  <!-- Hero -->
  <section class="c-hero night" aria-labelledby="c-title">
    <div class="c-media">
      <Img src={heroImage} lang={lang} priority sizes={heroSizes} class="c-img" />
      <div class="c-scrim" aria-hidden="true"></div>
    </div>
    <div class="wrap c-content">
      <Breadcrumbs lang={lang} tone="light" items={[{ label: t(T.products, lang), href: url(lang, '/products/') }, { label: t(category.name, lang) }]} />
      <h1 id="c-title" class="display c-title">{t(category.title, lang)}</h1>
      <div class="c-foot">
        <p class="c-tag">{t(category.tagline, lang)}</p>
        <ul class="c-jump" aria-label={t(ui.category.productsIn, lang)}>
          {
            inCat.map((p) => (
              <li>
                <a href={productUrl(lang, p.category, p.id)} data-pid={p.id} data-pfield="name">{t(p.name, lang)}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Intro (phones: the paragraphs after the lead fold behind "Read more" so the products come sooner) -->
  <section class="section c-intro">
    <div class="wrap c-intro-grid" data-intro>
      <div class="c-intro-head" data-reveal>
        <p class="c-intro-lead">{t(introLead, lang)}</p>
        <button
          type="button"
          class="c-more"
          aria-expanded="false"
          aria-controls="c-intro-rest"
          data-intro-toggle
          data-more={t(T.more, lang)}
          data-less={t(T.less, lang)}
        >
          <span data-intro-label>{t(T.more, lang)}</span>
          <Icon name="chevron-down" size={18} />
        </button>
      </div>
      <div class="c-intro-rest" id="c-intro-rest" data-reveal>
        <div class="prose">
          {introRest.map((p) => <p>{t(p, lang)}</p>)}
        </div>
        <p class="c-count">
          <span class="num" data-pcount={category.id} data-pcount-n={inCat.length} data-pcount-mode="num">{inCat.length}</span>
          <span data-pcount={category.id} data-pcount-n={inCat.length} data-pcount-mode="label" data-one={t(T.inCatOne, lang)} data-many={t(T.inCat, lang)}>{countLabel}</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Product groups -->
  {
    groups.map((g, i) => (
      <section class:list={['section', groupBands[i]]} id={g.id} aria-labelledby={`group-${g.id}`}>
        <div class="wrap">
          <SectionHead id={`group-${g.id}`} title={g.title} intro={g.intro} />
          <ProductGrid lang={lang} products={g.items} headingLevel="h3" />
        </div>
      </section>
    ))
  }

  {
    isBio && (
      <section class:list={['section', optionsBand]} aria-labelledby="opts-title">
        <div class="wrap opts-grid">
          <div class="opts-copy" data-reveal>
            <h2 id="opts-title" class="h2 rule">
              {t(options.title, lang)}
            </h2>
            <p class="lead">{t(options.intro, lang)}</p>
          </div>
          <ul class="opts-list" data-reveal>
            {options.items.map((o) => (
              <li>{t(o.label, lang)}</li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Other categories -->
  <section class:list={['section', othersBand]} aria-labelledby="others-title">
    <div class="wrap">
      <SectionHead id="others-title" title={t(ui.category.otherCategories, lang)} />
      <ul class="others">
        {
          others.map((c) => (
            <li class="other" data-reveal>
              <div class="media other-media">
                <Img src={`categories/${c.id}.jpg`} lang={lang} alt="" sizes={tileSizes(`categories/${c.id}.jpg`)} widths={[480, 768, 1080, 1440, 1920]} />
              </div>
              <div class="other-body">
                <h3 class="other-title">
                  <a href={categoryUrl(lang, c.id)} class="other-link">
                    {t(c.name, lang)}
                  </a>
                </h3>
                <p class="other-tag">{t(c.tagline, lang)}</p>
              </div>
              <span class="other-go" aria-hidden="true">
                <Icon name="arrow-up-right" size={20} />
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-intro]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-intro-toggle]');
    const label = root.querySelector<HTMLElement>('[data-intro-label]');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      root.classList.toggle('is-open', open);
      if (label) label.textContent = (open ? btn.dataset.less : btn.dataset.more) ?? '';
    });
  });
</script>

<style>
  /* Hero */
  .c-hero {
    position: relative;
    min-height: clamp(540px, 82svh, 860px);
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
  }
  .c-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .c-media :global(.c-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .c-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(10, 10, 8, 0.86) 0%, rgba(10, 10, 8, 0.45) 40%, rgba(10, 10, 8, 0.05) 72%),
      linear-gradient(to right, rgba(10, 10, 8, 0.5) 0%, rgba(10, 10, 8, 0) 60%);
  }
  .c-content {
    position: relative;
    padding-top: calc(var(--header-h) + var(--s-8));
    padding-bottom: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    display: grid;
    gap: var(--s-5);
    color: #fff;
  }
  .c-title {
    max-width: 16ch;
    color: #fff;
    font-size: clamp(2.5rem, 1.5rem + 4.4vw, 5.6rem);
  }
  .c-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--s-5) var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }
  .c-tag {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--step-2);
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.92);
    max-width: 30ch;
  }
  .c-jump {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 var(--s-5);
    max-width: 60ch;
  }
  .c-jump a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--step--1);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .c-jump a:hover {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 2px;
  }
  @media (max-width: 700px) {
    .c-jump {
      justify-content: flex-start;
    }
  }
  @media (max-width: 600px) {
    .c-jump {
      display: none;
    }
    /* Shorter photo hero on phones so the product list starts sooner */
    .c-hero {
      min-height: clamp(460px, 64svh, 600px);
    }
  }

  /* Intro */
  .c-intro-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--s-7) var(--s-5);
    align-items: start;
  }
  .c-intro-head {
    grid-column: 1 / span 6;
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .c-intro-lead {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--step-2);
    line-height: 1.38;
    text-wrap: pretty;
  }
  .c-intro-rest {
    grid-column: 8 / span 5;
    display: grid;
    gap: var(--s-6);
    padding-top: 0.6rem;
  }
  .c-intro-rest .prose {
    color: var(--muted);
  }
  .c-count {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding-top: var(--s-5);
    border-top: 1px solid var(--hair);
    font-size: var(--step--1);
    font-weight: 500;
  }
  .c-count .num {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--step-3);
    line-height: 1;
  }
  .c-more {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }
  .c-more:hover {
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 2px;
  }
  .c-more :global(svg) {
    transition: transform 0.25s var(--ease);
  }
  .c-more[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }
  @media (max-width: 900px) {
    .c-intro-head,
    .c-intro-rest {
      grid-column: 1 / -1;
    }
    .c-intro-lead {
      font-size: var(--step-1);
    }
    .c-intro {
      padding-block: clamp(2.5rem, 2rem + 3vw, 4rem);
    }
    /* With JS: fold the rest of the intro behind the toggle (without JS everything stays visible) */
    :global(html.js) .c-more {
      display: inline-flex;
    }
    :global(html.js) .c-intro-grid:not(.is-open) .c-intro-rest {
      display: none;
    }
    :global(html.js) .c-intro-grid:not(.is-open) {
      row-gap: 0;
    }
  }

  /* Integrated options: a compact typographic list */
  .opts-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
    gap: var(--s-7) clamp(2rem, 1rem + 4vw, 6rem);
    align-items: start;
  }
  .opts-copy {
    display: grid;
    gap: var(--s-5);
  }
  .opts-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--fg);
  }
  .opts-list li {
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--hair);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 300;
    line-height: 1.2;
  }
  @media (max-width: 900px) {
    .opts-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Other categories */
  .others {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
  }
  .other {
    position: relative;
    background: var(--graphite);
    display: grid;
    align-items: end;
    min-height: clamp(280px, 24vw, 360px);
    overflow: hidden;
    isolation: isolate;
    color: #fff;
  }
  .other-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .other-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 10, 8, 0.85) 0%, rgba(10, 10, 8, 0.35) 55%, rgba(10, 10, 8, 0.1) 100%);
    transition: background-color 0.3s var(--ease);
  }
  .other:hover .other-media::after {
    background-color: rgba(10, 10, 8, 0.12);
  }
  .other-body {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-5) var(--s-6) var(--s-6);
  }
  .other-title {
    font-size: var(--step-2);
    font-weight: 400;
  }
  .other-link {
    text-decoration: none;
  }
  .other-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .other-link:focus-visible {
    outline: none;
  }
  .other:focus-within {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }
  .other-tag {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--step--1);
  }
  .other-go {
    position: absolute;
    top: var(--s-5);
    right: var(--s-5);
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
    transition: transform 0.3s var(--ease);
  }
  .other:hover .other-go {
    transform: rotate(45deg);
  }
  @media (max-width: 900px) {
    .others {
      grid-template-columns: minmax(0, 1fr);
    }
    .other {
      min-height: 240px;
    }
  }
</style>
