---
import Base from '../../layouts/Base.astro';
import HomeHero from '../../components/HomeHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import HotspotScene from '../../components/HotspotScene.astro';
import LamellaDemo from '../../components/LamellaDemo.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import { categories } from '../../data/categories';
import { products } from '../../data/products';
import { faq } from '../../data/faq';
import { site } from '../../data/site';
import { pages } from '../../data/pages';
import { houseHotspots } from '../../data/hotspots';
import { beforeAfter } from '../../data/before-after';
import { references } from '../../data/references';
import { langParams, getLang, url, categoryUrl, productUrl, productCount, t } from '../../lib/i18n';

export function getStaticPaths() {
  return langParams();
}
const lang = getLang(Astro.params.lang);
const home = pages.home;

const C = {
  metaTitle: { bg: 'OUTPLAY – биоклиматични перголи, стъклени системи и слънцезащита', en: 'OUTPLAY – bioclimatic pergolas, glass systems and sun protection' },
  explore: { bg: 'Разгледайте продуктите', en: 'Explore the products' },
  quote: { bg: 'Направете запитване', en: 'Request a quote' },
  climateLink: { bg: 'Серии Balance и Infinity', en: 'Balance and Infinity series' },
  baLink: { bg: 'Още проекти и галерия', en: 'More projects and gallery' },
  faqLink: { bg: 'Всички въпроси', en: 'All questions' },
};

const cats = [...categories].sort((a, b) => a.order - b.order);
const countOf = (id: string) => products.filter((p) => p.category === id).length;
const productsOf = (id: string) => products.filter((p) => p.category === id).sort((a, b) => a.order - b.order);
const pair = beforeAfter[0];
const faqItems = faq.flatMap((g) => g.items).slice(0, 5);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: 'OUTPLAY',
  description: t(site.tagline, lang),
  url: new URL(url(lang, '/'), Astro.site).href,
  telephone: site.phones.map((p) => p.e164),
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: t(site.postalAddress.street, lang),
    addressLocality: t(site.postalAddress.locality, lang),
    postalCode: site.postalAddress.postalCode,
    addressCountry: site.postalAddress.country,
  },
};
---

<Base lang={lang} title={t(C.metaTitle, lang)} description={t(site.description, lang)} header="overlay" jsonLd={jsonLd}>
  <HomeHero
    lang={lang}
    image="home/hero.jpg"
    title={t(home.heroTitle, lang)}
    lead={t(home.heroLead, lang)}
    primary={{ label: t(C.explore, lang), href: url(lang, '/products/') }}
    secondary={{ label: t(C.quote, lang), href: url(lang, '/contact/#inquiry') }}
  />

  <!-- Category quick strip -->
  <nav class="cat-strip night" aria-label={t(home.categories.title, lang)}>
    <ul class="wrap">
      {
        cats.map((c) => (
          <li>
            <a href={categoryUrl(lang, c.id)}>
              <span class="cs-name">{t(c.name, lang)}</span>
              <span class="cs-count">{productCount(lang, countOf(c.id))}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- What we do: interactive villa -->
  <section class="section" aria-labelledby="what-title">
    <div class="wrap">
      <SectionHead id="what-title" title={t(home.whatWeDo.title, lang)} intro={t(home.whatWeDo.intro, lang)} />
      <HotspotScene lang={lang} id="villa" image="home/what-we-do.jpg" hotspots={houseHotspots} sizes="(min-width: 1440px) 1330px, 100vw" />
    </div>
  </section>

  <!-- Categories mosaic -->
  <section class="section mist" aria-labelledby="cats-title">
    <div class="wrap">
      <SectionHead id="cats-title" title={t(home.categories.title, lang)} intro={t(home.categories.intro, lang)} />
      <div class="mosaic">
        {
          cats.map((c, i) => (
            <article class={`tile tile-${i + 1}`}>
              <div class="media tile-media">
                <Img
                  src={`categories/${c.id}.jpg`}
                  lang={lang}
                  sizes={i === 0 ? '(min-width: 900px) 60vw, 100vw' : i === 3 ? '100vw' : '(min-width: 900px) 40vw, 100vw'}
                />
              </div>
              <div class="tile-body">
                <h3 class="tile-title">
                  <a href={categoryUrl(lang, c.id)} class="tile-link">
                    {t(c.name, lang)}
                  </a>
                </h3>
                <p class="tile-tag">{t(c.tagline, lang)}</p>
                <p class="tile-list small">
                  {productsOf(c.id)
                    .map((p) => t(p.name, lang))
                    .join(' · ')}
                </p>
              </div>
              <span class="tile-go" aria-hidden="true">
                <Icon name="arrow-up-right" size={22} />
              </span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Climate control -->
  <section class="section night" aria-labelledby="climate-title">
    <div class="wrap">
      <SectionHead id="climate-title" title={t(home.adaptive.title, lang)} intro={t(home.adaptive.intro, lang)}>
        <a class="link-arrow" href={productUrl(lang, 'bioclimatic-pergolas', 'balance')}>
          {t(C.climateLink, lang)}
          <Icon name="arrow-right" size={16} />
        </a>
      </SectionHead>
      <LamellaDemo lang={lang} id="home-lamella" />
    </div>
  </section>

  <!-- Before / after -->
  {
    pair && (
      <section class="section" aria-labelledby="ba-title">
        <div class="wrap ba-grid">
          <div class="ba-copy">
            <h2 id="ba-title" class="h2 rule">
              {t(home.beforeAfter.title, lang)}
            </h2>
            <p class="lead">{t(home.beforeAfter.intro, lang)}</p>
            <a class="link-arrow" href={url(lang, '/projects/')}>
              {t(C.baLink, lang)} <Icon name="arrow-right" size={16} />
            </a>
          </div>
          <BeforeAfter lang={lang} pair={pair} />
        </div>
      </section>
    )
  }

  <!-- Process -->
  <section class="section mist" aria-labelledby="process-title">
    <div class="wrap">
      <SectionHead id="process-title" title={t(home.process.title, lang)} intro={t(home.process.intro, lang)} />
      <ol class="steps">
        {
          home.process.steps.map((s, i) => (
            <li class="step">
              <span class="step-n num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="step-title">{t(s.title, lang)}</h3>
              <p class="muted small">{t(s.text, lang)}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- References -->
  {
    references.length > 0 && (
      <section class="section" aria-labelledby="refs-title">
        <div class="wrap">
          <SectionHead id="refs-title" title={t(home.references.title, lang)} intro={t(home.references.intro, lang)} />
          <ul class="refs">
            {references.map((r) => (
              <li class="ref">
                <div class="media ref-media">
                  <Img src={r.image} lang={lang} sizes="(min-width: 900px) 33vw, 50vw" widths={[480, 768, 1080]} />
                </div>
                <p class="ref-name">{lang === 'en' && r.nameEn ? r.nameEn : r.name}</p>
                <p class="muted small">{t(r.type, lang)}</p>
              </li>
            ))}
          </ul>
          <p class="partners">
            <span class="muted small">{t(home.partners.title, lang)}</span>
            <span class="partner-list">
              {site.partners.map((p) => (
                <span>{p}</span>
              ))}
            </span>
          </p>
        </div>
      </section>
    )
  }

  <!-- FAQ teaser -->
  <section class="section mist" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <div class="faq-copy">
        <h2 id="faq-title" class="h2 rule">{t(home.faq.title, lang)}</h2>
        <p class="lead">{t(home.faq.intro, lang)}</p>
        <a class="link-arrow" href={url(lang, '/faq/')}>{t(C.faqLink, lang)} <Icon name="arrow-right" size={16} /></a>
      </div>
      <FaqAccordion lang={lang} items={faqItems} idPrefix="home-faq" />
    </div>
  </section>

  <CtaBand lang={lang} title={t(home.cta.title, lang)} text={t(home.cta.intro, lang)} />
</Base>

<style>
  /* Category strip */
  .cat-strip {
    border-top: 1px solid var(--line-dark);
  }
  .cat-strip ul {
    list-style: none;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .cat-strip li:not(:first-child) {
    border-left: 1px solid var(--line-dark);
  }
  .cat-strip a {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    padding: 1.1rem var(--s-5);
    text-decoration: none;
    transition: background-color 0.2s var(--ease);
  }
  .cat-strip li:first-child a {
    padding-left: 0;
  }
  .cat-strip a:hover {
    background: var(--ink-2);
  }
  .cs-name {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .cs-count {
    flex: none;
    color: var(--alu);
    font-size: var(--step--1);
    font-weight: 500;
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .cat-strip ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* 2 × 2: one vertical divider between the columns, one horizontal between the rows */
    .cat-strip li:not(:first-child) {
      border-left: 0;
    }
    .cat-strip li:nth-child(2n) {
      border-left: 1px solid var(--line-dark);
    }
    .cat-strip li:nth-child(n + 3) {
      border-top: 1px solid var(--line-dark);
    }
    .cat-strip li:nth-child(odd) a {
      padding-left: 0;
    }
  }
  @media (max-width: 520px) {
    .cat-strip a {
      padding-inline: var(--s-3);
    }
    .cs-name {
      font-size: var(--step-0);
    }
  }

  /* Mosaic */
  .mosaic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: minmax(260px, auto);
    gap: var(--s-4);
  }
  .tile {
    position: relative;
    background: var(--graphite);
    min-height: 320px;
    display: grid;
    align-items: end;
    overflow: hidden;
    color: #fff;
    isolation: isolate;
  }
  .tile-1 {
    grid-column: span 8;
    grid-row: span 2;
    min-height: 620px;
  }
  .tile-2,
  .tile-3 {
    grid-column: span 4;
  }
  .tile-4 {
    grid-column: span 12;
    min-height: 340px;
  }
  .tile-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .tile-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 10, 8, 0.88) 0%, rgba(10, 10, 8, 0.55) 40%, rgba(10, 10, 8, 0.12) 72%, rgba(10, 10, 8, 0) 100%);
    transition: background-color 0.3s var(--ease);
  }
  .tile:hover .tile-media::after {
    background-color: rgba(10, 10, 8, 0.12);
  }
  .tile-body {
    padding: var(--s-6);
    display: grid;
    gap: var(--s-2);
    max-width: 60ch;
  }
  .tile-title {
    font-size: var(--step-3);
    font-weight: 400;
  }
  .tile-2 .tile-title,
  .tile-3 .tile-title {
    font-size: var(--step-2);
  }
  .tile-link {
    text-decoration: none;
  }
  .tile-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .tile-tag {
    color: rgba(255, 255, 255, 0.88);
  }
  .tile-list {
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.01em;
  }
  .tile-go {
    position: absolute;
    top: var(--s-5);
    right: var(--s-5);
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
    transition: transform 0.3s var(--ease);
  }
  .tile:hover .tile-go {
    transform: rotate(45deg);
  }
  .tile:focus-within {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }
  .tile-link:focus-visible {
    outline: none;
  }
  @media (max-width: 900px) {
    .tile-1,
    .tile-2,
    .tile-3,
    .tile-4 {
      grid-column: 1 / -1;
      grid-row: auto;
      min-height: 380px;
    }
  }

  /* Before / after */
  .ba-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: var(--s-7);
    align-items: center;
  }
  .ba-copy {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  @media (max-width: 900px) {
    .ba-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Process */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--s-5);
    counter-reset: step;
  }
  .step {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding-top: var(--s-5);
    border-top: 1px solid var(--ink);
    position: relative;
  }
  .step::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 40px;
    height: 3px;
    background: var(--yellow);
  }
  .step-n {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 300;
    color: var(--steel);
  }
  .step-title {
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1.25;
  }
  @media (max-width: 1100px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: var(--s-7);
    }
  }
  @media (max-width: 600px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s-6);
    }
    .step p {
      font-size: var(--step-0);
    }
  }

  /* References */
  .refs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-7) var(--s-5);
  }
  .ref {
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }
  .ref-media {
    aspect-ratio: 4 / 3;
    margin-bottom: var(--s-2);
  }
  .ref-name {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .partners {
    margin-top: var(--s-8);
    padding-top: var(--s-6);
    border-top: 1px solid var(--hair);
    display: grid;
    gap: var(--s-4);
  }
  .partner-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: 0.08em;
    color: var(--steel);
  }
  @media (max-width: 900px) {
    .refs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .refs {
      gap: var(--s-5) var(--s-3);
    }
    .ref-name {
      font-size: var(--step-0);
    }
  }

  /* FAQ */
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: var(--s-7);
    align-items: start;
  }
  .faq-copy {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }
  @media (max-width: 900px) {
    .faq-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .faq-copy {
      position: static;
    }
  }
</style>
