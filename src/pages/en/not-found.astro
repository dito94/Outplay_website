---
// English 404 page; the shared 404.html redirects misses under /en/ here.
import Base from '../../layouts/Base.astro';
import NotFound from '../../components/NotFound.astro';
import { pages } from '../../data/pages';
import { url, t } from '../../lib/i18n';
const nf = pages.notFound;
---

<Base lang="en" title={t(nf.title, 'en')} description={t(nf.intro, 'en')}>
  <NotFound langs={['en']} />
</Base>

<script is:inline define:vars={{ homes: { bg: url('bg', '/'), en: url('en', '/') } }}>
  // The header/footer language switch points at /not-found/ pages; send it to the home page in each language instead.
  document.querySelectorAll('a[href$="/not-found/"]').forEach((a) => {
    const href = a.getAttribute('href') || '';
    a.setAttribute('href', href === homes.en + 'not-found/' ? homes.en : homes.bg);
  });
</script>
