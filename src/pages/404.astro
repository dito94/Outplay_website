---
// Shared 404 (GitHub Pages serves dist/404.html for any missing path). Bulgarian by default; misses under /en/ are sent
// to the fully English /en/not-found/ page before first paint, so the header and footer are English too.
import Base from '../layouts/Base.astro';
import NotFound from '../components/NotFound.astro';
import { pages } from '../data/pages';
import { url, t } from '../lib/i18n';
const nf = pages.notFound;
---

<Base lang="bg" title={t(nf.title, 'bg')} description={t(nf.intro, 'bg')}>
  <script is:inline slot="head" define:vars={{ enPage: url('en', '/not-found/'), enHome: url('en', '/') }}>
    // only a real /en/ language prefix right after the base path counts
    const p = location.pathname;
    if (p.startsWith(enHome) || p === enHome.slice(0, -1)) location.replace(enPage);
  </script>
  <NotFound langs={['bg']} />
</Base>

<script is:inline define:vars={{ homes: { bg: url('bg', '/'), en: url('en', '/') } }}>
  // The shared header/footer build their language switch from the current path, which here is /404/.
  // Send those links to the home page in each language instead.
  document.querySelectorAll('a[href$="/404/"]').forEach((a) => {
    const href = a.getAttribute('href') || '';
    a.setAttribute('href', href === homes.en + '404/' ? homes.en : homes.bg);
  });
</script>
