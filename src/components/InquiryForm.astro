    align-items: center;
    justify-content: space-between;
    gap: 0 var(--s-4);
  }
  .iq-fixed-name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.2;
  }
  html:not(.js) .iq-fixed {
    display: none;
  }

  /* Dimension fields */
  .iq-dims {
    display: grid;
    gap: var(--s-5);
  }
  .iq-dim {
    gap: 0.3rem;
  }
  .iq-dim-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .iq .iq-dim-top label {
    font-size: var(--step-0);
    font-weight: 600;
  }
  .iq-num {
    position: relative;
    flex: none;
    width: 7.5rem;
  }
  .iq-num .input {
    padding-right: 2.2rem;
    text-align: right;
    font-size: var(--step-1);
    font-weight: 500;
  }
  .iq-unit {
    position: absolute;
    right: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    pointer-events: none;
  }
  .iq-range {
    --pct: 50%;
    width: 100%;
    height: 44px;
    margin: 0;
    background: transparent;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
  }
  .iq-range::-webkit-slider-runnable-track {
    height: 3px;
