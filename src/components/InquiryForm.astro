  }
  .js .iq-product.is-collapsed {
    display: none;
  }
  .iq-fixed {
    display: grid;
    gap: 0.15rem;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--line);
    border-left: 3px solid var(--yellow);
    background: var(--mist);
  }
  .iq-fixed-k {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .iq-fixed-row {
