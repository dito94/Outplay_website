---
// Three-step inquiry form: product + approximate dimensions (live scale sketch) → configuration → contact.
// Static site: on submit the request is stored in this browser (src/lib/store.ts) and a demo notice says so.
// Progressive enhancement: without JS every step renders as readable fields and points to phone/email.
import type { Lang, OptionGroup } from '../data/types';
import { products } from '../data/products';
import { categories } from '../data/categories';
import { inquiryFamilies, inquiryCommon, inquiryTextFields, productOptionDefaults } from '../data/inquiry';
import { ui } from '../data/ui';
import { pages } from '../data/pages';
import { site } from '../data/site';
import { t } from '../lib/i18n';
import Icon from './Icon.astro';
import CopyButton from './CopyButton.astro';

interface Props {
  lang: Lang;
  /** preselected product id (from product page or ?product= query) */
  productId?: string;
  /** compact variant embedded on product pages */
  compact?: boolean;
  id?: string;
}
const { lang, productId, compact = false, id = 'inquiry' } = Astro.props;

/** Demo build: nothing is sent anywhere. Set to false once a real endpoint exists. */
const DEMO = true;
const MAX_FILES = 10;
const MAX_MB = 15;

const T = {
  step1: { bg: 'Продукт и размери', en: 'Product and size' },
  step2: { bg: 'Конфигурация', en: 'Configuration' },
  step3: { bg: 'Контакти', en: 'Contact details' },
  progress: { bg: 'Стъпки на запитването', en: 'Request steps' },
  productHint: {
    bg: 'Не сте сигурни? Изберете най-близкия продукт и опишете идеята си в следващата стъпка.',
    en: 'Not sure? Pick the closest product and describe your idea in the next step.',
  },
  multi: { bg: 'изберете колкото желаете', en: 'choose any' },
  dropMain: { bg: 'Плъзнете снимки тук или', en: 'Drag photos here or' },
  dropPick: { bg: 'изберете файлове', en: 'choose files' },
  dropFormats: { bg: 'JPG, PNG или WEBP · до {n} снимки', en: 'JPG, PNG or WEBP · up to {n} photos' },
  photosLocal: {
    bg: 'Снимките остават във Вашия браузър – в демо версията не се качват никъде.',
    en: 'Photos stay in your browser; in this demo they are not uploaded anywhere.',
  },
  removePhoto: { bg: 'Премахни снимката {name}', en: 'Remove photo {name}' },
  tooMany: { bg: 'Може да добавите до {n} снимки.', en: 'You can add up to {n} photos.' },
  tooLarge: { bg: 'Файлът {name} е по-голям от {n} MB.', en: '{name} is larger than {n} MB.' },
  privacyLink: { bg: 'Как използваме данните Ви', en: 'How we use your details' },
  privacyText: {
    bg: 'Използваме името, телефона и имейла Ви само за да отговорим на това запитване и да подготвим оферта. В тази демо версия данните остават единствено във Вашия браузър и не се изпращат никъде.',
    en: 'We use your name, phone number and email only to reply to this request and prepare a quote. In this demo your details stay in your browser and are not sent anywhere.',
  },
  demoHint: {
    bg: 'Демо версия: запитването ще бъде запазено само в този браузър и няма да бъде изпратено.',
    en: 'Demo: your request will be saved in this browser only and will not be sent.',
  },
  draft: {
    bg: 'Продължавате незавършено запитване, запазено в този браузър.',
    en: 'You are continuing a request saved in this browser.',
  },
  startOver: { bg: 'Започнете отначало', en: 'Start over' },
  noscript: {
    bg: 'За да изпратите запитването онлайн, е нужен JavaScript. Можете да ни се обадите, да пишете във Viber или на имейл:',
    en: 'Sending the request online needs JavaScript. You can call us, message us on Viber or email:',
  },
  storageFailed: {
    bg: 'Не успяхме да запазим запитването в този браузър – съхранението на данни може да е изключено. Обобщението по-долу е пълно: копирайте го или ни се обадете.',
    en: 'We could not save the request in this browser; site storage may be turned off. The summary below is complete: copy it or give us a call.',
  },
  copySummary: { bg: 'Копирай обобщението', en: 'Copy summary' },
  copied: { bg: 'Копирано', en: 'Copied' },
  preferCall: { bg: 'Предпочитате разговор?', en: 'Prefer to talk?' },
  facade: { bg: 'Фасада', en: 'Façade' },
  sketchNote: { bg: 'Схема по въведените размери', en: 'Sketch drawn to your dimensions' },
  dec: { bg: 'Намали', en: 'Decrease' },
  inc: { bg: 'Увеличи', en: 'Increase' },
  fixErrors: { bg: 'Проверете отбелязаните полета.', en: 'Please check the highlighted fields.' },
  secProduct: { bg: 'Продукт', en: 'Product' },
  secDims: { bg: 'Размери', en: 'Dimensions' },
  secPhotos: { bg: 'Снимки', en: 'Photos' },
  secMessage: { bg: 'Съобщение', en: 'Message' },
  secContact: { bg: 'Контакти', en: 'Contact' },
  channelShort: { bg: 'Връзка', en: 'Contact by' },
  short: {
    width: { bg: 'Ширина', en: 'Width' },
    depth: { bg: 'Дълбочина', en: 'Depth' },
    height: { bg: 'Височина', en: 'Height' },
    length: { bg: 'Дължина', en: 'Length' },
    units: { bg: 'Брой', en: 'Units' },
  },
};

const tx = (v: { bg: string; en: string }) => t(v, lang);
const fid = (s: string) => `${id}-${s}`;
const locale = lang === 'bg' ? 'bg-BG' : 'en-GB';
const nf = new Intl.NumberFormat(locale, { maximumFractionDigits: 2 });
const fmtN = (v: number) => nf.format(v);

const preselected = productId ? products.find((p) => p.id === productId) : undefined;
const isCompact = compact && !!preselected;
const initialFamily = preselected?.family ?? 'pergola';
const preset = (preselected && productOptionDefaults[preselected.id]) || {};

const cats = [...categories].sort((a, b) => a.order - b.order);
const byCat = (cid: string) => products.filter((p) => p.category === cid).sort((a, b) => a.order - b.order);
const families = Object.values(inquiryFamilies);

function isChecked(g: OptionGroup, choice: string, family: string): boolean {
  const v = family === initialFamily && preset[g.id] !== undefined ? preset[g.id] : g.default;
  return Array.isArray(v) ? v.includes(choice) : v === choice;
}
/** Short label used on the drawing (long field labels like "Ширина на отвора" → "Ширина") */
const shortLabel = (did: keyof typeof T.short, label: string) => (label.length <= 12 ? label : tx(T.short[did]));

const config = {
  lang,
  demo: DEMO,
  maxFiles: MAX_FILES,
  maxMb: MAX_MB,
  defaults: productOptionDefaults,
  products: Object.fromEntries(
    products.map((p) => [
      p.id,
      { family: p.family, name: t(p.name, lang), full: t(p.fullName, lang), cat: t(categories.find((c) => c.id === p.category)?.name, lang) },
    ]),
  ),
  s: {
    required: tx(ui.form.errors.required),
    product: tx(ui.form.errors.product),
    phone: tx(ui.form.errors.phone),
    email: tx(ui.form.errors.email),
    range: tx(ui.form.errors.range),
    rangePcs: tx(ui.form.errors.rangePcs),
    number: tx(ui.form.errors.number),
    consent: tx(ui.form.errors.consent),
    fileType: tx(ui.form.errors.fileType),
    tooMany: tx(T.tooMany),
    tooLarge: tx(T.tooLarge),
    removePhoto: tx(T.removePhoto),
    stepOf: tx(ui.inquiry.stepOf),
    planView: tx(ui.inquiry.planView),
    elevationView: tx(ui.inquiry.elevationView),
    area: tx(ui.inquiry.area),
    approx: tx(ui.inquiry.approx),
    facade: tx(T.facade),
    m: tx(ui.units.m),
    m2: tx(ui.units.m2),
    pcs: tx(ui.units.pcs),
    fixErrors: tx(T.fixErrors),
    edit: tx(ui.actions.edit),
    secProduct: tx(T.secProduct),
    secDims: tx(T.secDims),
    secOptions: tx(inquiryCommon.optionsTitle),
    secProject: tx(inquiryCommon.projectTitle),
    secPhotos: tx(T.secPhotos),
    secMessage: tx(T.secMessage),
    secContact: tx(T.secContact),
    channelShort: tx(T.channelShort),
    noneSelected: tx(ui.inquiry.noneSelected),
    copied: tx(T.copied),
  },
};

const success = pages.inquiry.success;
const nextSteps = success.next;
const projectGroups = inquiryCommon.projectGroups;
const channel = inquiryCommon.contactChannel;
const optional = tx(ui.form.hints.optional);
---

<div
  class:list={['iq', { 'iq-compact': isCompact }]}
  id={id}
  data-inquiry
  data-product={preselected?.id ?? ''}
  data-family={initialFamily}
>
  <script type="application/json" data-iq-config set:html={JSON.stringify(config)} />

  <ol class="iq-progress" aria-label={tx(T.progress)} data-iq-progress>
    {
      [T.step1, T.step2, T.step3].map((s, i) => (
        <li class:list={['iq-pi', { 'is-current': i === 0 }]} data-pi={i + 1}>
          <button type="button" class="iq-pi-btn" data-goto={i + 1} aria-current={i === 0 ? 'step' : undefined}>
            <span class="iq-pi-n num" aria-hidden="true">
              {i + 1}
            </span>
            <span class="iq-pi-l">
              <span class="sr-only">{t(ui.inquiry.stepOf, lang).replace('{n}', String(i + 1)).replace('{total}', '3')}: </span>
              {tx(s)}
            </span>
          </button>
        </li>
      ))
    }
  </ol>

  <form class="iq-card iq-form" novalidate data-iq-form autocomplete="on">
    <p class="iq-draft" data-iq-draft hidden>
      <span>{tx(T.draft)}</span>
      <button type="button" class="iq-textbtn" data-iq-reset>{tx(T.startOver)}</button>
    </p>

    <!-- Step 1 · product and dimensions -->
    <section class="iq-step is-active" data-step="1" aria-labelledby={fid('s1-title')}>
      <header class="iq-step-head">
        <h3 class="iq-step-title" id={fid('s1-title')} tabindex="-1" data-step-title>
          <span class="sr-only">{t(ui.inquiry.stepOf, lang).replace('{n}', '1').replace('{total}', '3')}: </span>
          {tx(T.step1)}
        </h3>
        <p class="iq-step-lead">{tx(inquiryCommon.dimensionsNote)}</p>
      </header>

      <div class="iq-s1">
        <div class="iq-s1-product">
          {
            isCompact && preselected && (
              <div class="iq-fixed" data-iq-fixed>
                <span class="iq-fixed-k">{tx(ui.inquiry.selectedProduct)}</span>
                <div class="iq-fixed-row">
                  <span class="iq-fixed-name" data-iq-fixed-name>
                    {t(preselected.name, lang)}
                  </span>
                  <button
                    type="button"
                    class="iq-textbtn"
                    data-iq-change
                    aria-expanded="false"
                    aria-controls={fid('product-wrap')}
                  >
                    {tx(ui.inquiry.changeProduct)}
                  </button>
                </div>
              </div>
            )
          }
          <div
            class:list={['field', 'iq-product', { 'is-collapsed': isCompact }]}
            id={fid('product-wrap')}
            data-iq-product-wrap
          >
            <label for={fid('product')}>{tx(ui.form.labels.product)}</label>
            <select
              class="select"
              id={fid('product')}
              name="product"
              required
              aria-required="true"
              aria-describedby={fid('product-hint')}
              data-iq-select
            >
              <option value="" selected={!preselected}>
                {tx(ui.form.placeholders.product)}
              </option>
              {
                cats.map((c) => (
                  <optgroup label={t(c.name, lang)}>
                    {byCat(c.id).map((p) => (
                      <option value={p.id} data-family={p.family} selected={p.id === preselected?.id}>
                        {t(p.name, lang)}
                      </option>
                    ))}
                  </optgroup>
                ))
              }
            </select>
            <p class="hint" id={fid('product-hint')}>{tx(T.productHint)}</p>
            <p class="error" id={fid('product-err')}></p>
          </div>
        </div>

        <figure class="iq-preview" data-iq-preview>
          <div class="iq-board" data-iq-board>
            <svg class="iq-svg" role="img" aria-label={tx(ui.inquiry.preview)} data-iq-svg viewBox="0 0 520 340"></svg>
          </div>
          <figcaption class="iq-readout">
            <span class="iq-readout-k">{tx(ui.inquiry.area)} <span class="iq-approx">{tx(ui.inquiry.approx)}</span></span>
            <span class="iq-readout-v num"><span data-iq-area>—</span> <span class="iq-readout-u">{tx(ui.units.m2)}</span></span>
            <span class="iq-readout-d num" data-iq-area-detail></span>
            <span class="iq-readout-note">{tx(T.sketchNote)}</span>
          </figcaption>
          <p class="sr-only" aria-live="polite" data-iq-area-live></p>
        </figure>

        <div class="iq-s1-dims">
          {
            families.map((f) => (
              <fieldset
                class="iq-dims"
                data-family-block={f.family}
                data-preview={f.preview}
                hidden={f.family !== initialFamily}
                disabled={f.family !== initialFamily}
              >
                <legend class="iq-legend">{tx(inquiryCommon.dimensionsTitle)}</legend>
                {f.dimensions.map((d) => {
                  const inputId = fid(`${f.family}-${d.id}`);
                  const hintId = `${inputId}-hint`;
                  const label = t(d.label, lang);
                  const pct = ((d.default - d.min) / (d.max - d.min)) * 100;
                  return d.unit === 'pcs' ? (
                    <div class="field iq-dim iq-dim-pcs" data-dim={d.id} data-min={d.min} data-max={d.max} data-inc={d.step} data-unit={d.unit} data-label={label} data-short={shortLabel(d.id, label)}>
                      <label for={inputId}>{label}</label>
                      <div class="iq-stepper">
                        <button type="button" class="iq-stepper-btn" data-stepper="-1" aria-label={`${tx(T.dec)}: ${label}`} aria-controls={inputId}>
                          <Icon name="minus" size={18} />
                        </button>
                        <input
                          class="input num iq-num-input"
                          id={inputId}
                          name={`dim.${f.family}.${d.id}`}
                          type="text"
                          inputmode="numeric"
                          autocomplete="off"
                          value={fmtN(d.default)}
                          aria-describedby={d.hint ? hintId : undefined}
                          data-dim-input
                        />
                        <button type="button" class="iq-stepper-btn" data-stepper="1" aria-label={`${tx(T.inc)}: ${label}`} aria-controls={inputId}>
                          <Icon name="plus" size={18} />
                        </button>
                      </div>
                      {d.hint && <p class="hint" id={hintId}>{t(d.hint, lang)}</p>}
                      <p class="error" id={`${inputId}-err`}></p>
                    </div>
                  ) : (
                    <div class="field iq-dim" data-dim={d.id} data-min={d.min} data-max={d.max} data-inc={d.step} data-unit={d.unit} data-label={label} data-short={shortLabel(d.id, label)}>
                      <div class="iq-dim-top">
                        <label for={inputId}>
                          {label}
                          <span class="sr-only"> ({tx(ui.units.m)})</span>
                        </label>
                        <span class="iq-num">
                          <input
                            class="input num iq-num-input"
                            id={inputId}
                            name={`dim.${f.family}.${d.id}`}
                            type="text"
                            inputmode="decimal"
                            autocomplete="off"
                            value={fmtN(d.default)}
                            aria-describedby={d.hint ? hintId : undefined}
                            data-dim-input
                          />
                          <span class="iq-unit" aria-hidden="true">
                            {tx(ui.units.m)}
                          </span>
                        </span>
                      </div>
                      <input
                        class="iq-range"
                        type="range"
                        min={d.min}
                        max={d.max}
                        step={d.step}
                        value={d.default}
                        aria-label={label}
                        aria-valuetext={`${fmtN(d.default)} ${tx(ui.units.m)}`}
                        style={`--pct:${pct}%`}
                        data-dim-range
                      />
                      <span class="iq-scale num" aria-hidden="true">
                        <span>{fmtN(d.min)} {tx(ui.units.m)}</span>
                        <span>{fmtN(d.max)} {tx(ui.units.m)}</span>
                      </span>
                      {d.hint && <p class="hint" id={hintId}>{t(d.hint, lang)}</p>}
                      <p class="error" id={`${inputId}-err`}></p>
                    </div>
                  );
                })}
              </fieldset>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Step 2 · configuration -->
    <section class="iq-step" data-step="2" aria-labelledby={fid('s2-title')}>
      <header class="iq-step-head">
        <h3 class="iq-step-title" id={fid('s2-title')} tabindex="-1" data-step-title>
          <span class="sr-only">{t(ui.inquiry.stepOf, lang).replace('{n}', '2').replace('{total}', '3')}: </span>
          {tx(T.step2)}
        </h3>
      </header>

      <div class="iq-s2">
        <div class="iq-block">
          <h4 class="iq-sub">{tx(inquiryCommon.optionsTitle)}</h4>
          {
            families.map((f) => (
              <div class="iq-opts" data-family-block={f.family} hidden={f.family !== initialFamily}>
                {f.optionGroups.map((g) => (
                  <fieldset class="iq-group" data-group={g.id} data-type={g.type} data-label={t(g.label, lang)} disabled={f.family !== initialFamily}>
                    <legend class="iq-legend-v">
                      {t(g.label, lang)}
                      {g.type === 'multi' && <span class="iq-opt"> · {tx(T.multi)}</span>}
                    </legend>
                    <div class="chips">
                      {g.choices.map((c) => (
                        <label class="chip">
                          <input
                            type={g.type === 'single' ? 'radio' : 'checkbox'}
                            name={`opt.${f.family}.${g.id}`}
                            value={c.id}
                            checked={isChecked(g, c.id, f.family)}
                          />
                          <span>{t(c.label, lang)}</span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                ))}
                <div class="iq-texts">
                  {inquiryTextFields[f.family].map((tf) => (
                    <div class="field">
                      <label for={fid(`${f.family}-${tf.id}`)}>
                        {t(tf.label, lang)} <span class="iq-opt">· {optional}</span>
                      </label>
                      <input
                        class="input"
                        type="text"
                        id={fid(`${f.family}-${tf.id}`)}
                        name={`txt.${f.family}.${tf.id}`}
                        placeholder={t(tf.placeholder, lang)}
                        data-text-field={tf.id}
                        data-label={t(tf.label, lang)}
                        disabled={f.family !== initialFamily}
                      />
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <div class="iq-block" data-iq-project>
          <h4 class="iq-sub">{tx(inquiryCommon.projectTitle)}</h4>
          {
            projectGroups.map((g) => (
              <fieldset class="iq-group" data-group={g.id} data-type={g.type} data-label={t(g.label, lang)}>
                <legend class="iq-legend-v">{t(g.label, lang)}</legend>
                <div class="chips">
                  {g.choices.map((c) => (
                    <label class="chip">
                      <input type="radio" name={`proj.${g.id}`} value={c.id} checked={g.default === c.id} />
                      <span>{t(c.label, lang)}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ))
          }
        </div>

        <div class="iq-block iq-photos">
          <span class="iq-legend-v" id={fid('photos-label')}>
            {tx(ui.form.labels.photos)} <span class="iq-opt">· {optional}</span>
          </span>
          <label class="iq-drop" data-iq-drop>
            <input
              class="iq-file"
              type="file"
              accept="image/jpeg,image/png,image/webp"
              multiple
              aria-labelledby={fid('photos-label')}
              aria-describedby={`${fid('photos-hint')} ${fid('photos-err')}`}
              data-iq-file
            />
            <Icon name="upload" size={26} />
            <span class="iq-drop-main">
              {tx(T.dropMain)} <span class="iq-drop-pick">{tx(T.dropPick)}</span>
            </span>
            <span class="iq-drop-sub">{tx(T.dropFormats).replace('{n}', String(MAX_FILES))}</span>
          </label>
          <p class="hint" id={fid('photos-hint')}>{tx(ui.form.hints.photos)} {tx(T.photosLocal)}</p>
          <p class="error" id={fid('photos-err')} aria-live="polite"></p>
          <ul class="iq-thumbs" data-iq-thumbs></ul>
        </div>

        <div class="iq-block field">
          <label for={fid('message')} class="iq-legend-v">
            {tx(ui.form.labels.message)} <span class="iq-opt">· {optional}</span>
          </label>
          <textarea class="textarea" id={fid('message')} name="message" rows="4" placeholder={tx(ui.form.placeholders.message)}></textarea>
        </div>
      </div>
    </section>

    <!-- Step 3 · contact -->
    <section class="iq-step" data-step="3" aria-labelledby={fid('s3-title')}>
      <header class="iq-step-head">
        <h3 class="iq-step-title" id={fid('s3-title')} tabindex="-1" data-step-title>
          <span class="sr-only">{t(ui.inquiry.stepOf, lang).replace('{n}', '3').replace('{total}', '3')}: </span>
          {tx(T.step3)}
        </h3>
        <p class="iq-step-lead">{tx(ui.form.hints.contactRequired)}</p>
      </header>

      <div class="iq-s3">
        <div class="iq-s3-fields">
          <div class="field iq-full">
            <label for={fid('name')}>{tx(ui.form.labels.name)}</label>
            <input class="input" type="text" id={fid('name')} name="contact.name" autocomplete="name" required aria-required="true" placeholder={tx(ui.form.placeholders.name)} />
            <p class="error" id={fid('name-err')}></p>
          </div>

          <fieldset class="iq-group iq-full" data-group={channel.id} data-type="single" data-label={t(channel.label, lang)}>
            <legend class="iq-legend-v">{t(channel.label, lang)}</legend>
            <div class="chips">
              {
                channel.choices.map((c) => (
                  <label class="chip">
                    <input type="radio" name="contact.channel" value={c.id} checked={channel.default === c.id} data-iq-channel />
                    <span>
                      {c.id === 'phone' && <Icon name="phone" size={16} />}
                      {c.id === 'viber' && <Icon name="viber" size={16} />}
                      {c.id === 'email' && <Icon name="mail" size={16} />}
                      {t(c.label, lang)}
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="field">
            <label for={fid('phone')}>
              {tx(ui.form.labels.phone)} <span class="iq-opt" data-opt-mark="phone" hidden>· {optional}</span>
            </label>
            <input
              class="input num"
              type="tel"
              id={fid('phone')}
              name="contact.phone"
              autocomplete="tel"
              inputmode="tel"
              placeholder={tx(ui.form.placeholders.phone)}
              aria-describedby={fid('phone-hint')}
              data-iq-phone
            />
            <p class="hint" id={fid('phone-hint')}>{tx(ui.form.hints.phone)}</p>
            <p class="error" id={fid('phone-err')}></p>
          </div>

          <div class="field">
            <label for={fid('email')}>
              {tx(ui.form.labels.email)} <span class="iq-opt" data-opt-mark="email">· {optional}</span>
            </label>
            <input
              class="input"
              type="email"
              id={fid('email')}
              name="contact.email"
              autocomplete="email"
              inputmode="email"
              spellcheck="false"
              placeholder={tx(ui.form.placeholders.email)}
              data-iq-email
            />
            <p class="error" id={fid('email-err')}></p>
          </div>

          <div class="field iq-full">
            <label for={fid('city')}>
              {tx(ui.form.labels.city)} <span class="iq-opt">· {optional}</span>
            </label>
            <input class="input" type="text" id={fid('city')} name="contact.city" autocomplete="address-level2" placeholder={tx(ui.form.placeholders.city)} />
          </div>

          <div class="iq-consent iq-full">
            <label class="iq-check" for={fid('consent')}>
              <input type="checkbox" id={fid('consent')} name="consent" required aria-required="true" data-iq-consent />
              <span>{tx(ui.form.labels.consent)}</span>
            </label>
            <p class="error iq-consent-err" id={fid('consent-err')}></p>
            <details class="iq-privacy">
              <summary>{tx(T.privacyLink)}</summary>
              <p>{tx(T.privacyText)}</p>
            </details>
          </div>
        </div>

        <aside class="iq-summary" aria-labelledby={fid('sum-title')}>
          <h4 class="iq-sub" id={fid('sum-title')}>{tx(pages.inquiry.summaryTitle)}</h4>
          <div data-iq-summary></div>
        </aside>
      </div>
    </section>

    <div class="iq-nav" data-iq-nav>
      <button type="button" class="btn btn-ghost iq-back" data-iq-back hidden>
        <Icon name="arrow-left" />
        {tx(ui.actions.back)}
      </button>
      <span class="iq-nav-step num" data-iq-steptext aria-hidden="true">
        {t(ui.inquiry.stepOf, lang).replace('{n}', '1').replace('{total}', '3')}
      </span>
      <button type="button" class="btn iq-next" data-iq-next>
        {tx(ui.actions.continue)}
        <Icon name="arrow-right" class="arrow" />
      </button>
      <button type="submit" class="btn iq-submit" data-iq-submit hidden>
        {tx(ui.actions.submit)}
        <Icon name="arrow-right" class="arrow" />
      </button>
    </div>
    {DEMO && <p class="iq-demo-hint" data-iq-demo-hint hidden>{tx(T.demoHint)}</p>}
    <p class="sr-only" aria-live="polite" data-iq-live></p>

    <noscript>
      <div class="iq-noscript">
        <p>{tx(T.noscript)}</p>
        <p class="iq-noscript-links">
          {site.phones.map((p) => <a class="num" href={`tel:${p.e164}`}>{p.display}</a>)}
          <a href={site.viberUrl}>Viber</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </noscript>
  </form>

  <!-- Success state -->
  <div class="iq-card iq-success" data-iq-success hidden>
    <div class="iq-success-head">
      <span class="iq-success-mark" aria-hidden="true"><Icon name="check" size={26} /></span>
      <h3 class="iq-success-title" tabindex="-1" data-iq-success-title>{tx(success.title)}</h3>
    </div>
    {
      DEMO ? (
        <p class="iq-demo-note" role="note">
          <strong>{tx(ui.misc.demo)}</strong>
          <span>{tx(pages.inquiry.demoNotice)}</span>
        </p>
      ) : (
        <p class="lead">{tx(success.text)}</p>
      )
    }
    <p class="iq-storage-note" data-iq-storage-note hidden>{tx(T.storageFailed)}</p>

    <div class="iq-success-grid">
      <section class="iq-success-sum" aria-labelledby={fid('ok-sum')}>
        <div class="iq-success-sum-head">
          <h4 class="iq-sub" id={fid('ok-sum')}>{tx(pages.inquiry.summaryTitle)}</h4>
          <button type="button" class="iq-textbtn" data-iq-copy-summary>
            <Icon name="copy" size={16} />
            <span data-iq-copy-label>{tx(T.copySummary)}</span>
          </button>
        </div>
        <div data-iq-success-summary></div>
      </section>
      <div class="iq-success-side">
        <section aria-labelledby={fid('ok-next')}>
          <h4 class="iq-sub" id={fid('ok-next')}>{tx(success.nextTitle)}</h4>
          <ol class="iq-next-steps">
            {
              nextSteps.map((s, i) => (
                <li>
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  {tx(s)}
                </li>
              ))
            }
          </ol>
        </section>
        <section aria-labelledby={fid('ok-direct')}>
          <h4 class="iq-sub" id={fid('ok-direct')}>{tx(T.preferCall)}</h4>
          <ul class="iq-direct">
            {
              site.phones.map((p) => (
                <li>
                  <a class="iq-direct-link num" href={`tel:${p.e164}`}>
                    <Icon name="phone" size={18} />
                    {p.display}
                  </a>
                  <CopyButton text={p.display} lang={lang} />
                </li>
              ))
            }
            <li>
              <a class="iq-direct-link" href={`mailto:${site.email}`}>
                <Icon name="mail" size={18} />
                {site.email}
              </a>
              <CopyButton text={site.email} lang={lang} />
            </li>
            <li>
              <a class="btn btn-viber btn-sm" href={site.viberUrl}>
                <Icon name="viber" size={18} />
                {tx(ui.actions.viber)}
              </a>
            </li>
          </ul>
        </section>
      </div>
    </div>
    <div class="iq-success-actions">
      <button type="button" class="btn btn-ghost" data-iq-new>
        <Icon name="plus" />
        {tx(ui.actions.newInquiry)}
      </button>
    </div>
  </div>
</div>

<style is:global>
  /* ---------- Inquiry form (all selectors scoped under .iq; global because parts are rendered by JS) ---------- */
  .iq {
    --bg: var(--paper);
    --fg: var(--ink);
    --muted: var(--steel);
    --hair: var(--line);
    --focus: var(--ink);
    --surface: var(--mist);
    --iq-pad: clamp(1.25rem, 0.8rem + 2vw, 2.5rem);
    --iq-gap: var(--s-6);
    container: iq / inline-size;
    color: var(--fg);
    color-scheme: light;
    min-width: 0;
  }
  .iq-compact {
    --iq-pad: clamp(1rem, 0.7rem + 1.4vw, 1.75rem);
    --iq-gap: var(--s-5);
  }
  .iq .error {
    color: var(--danger);
  }
  .iq .field {
    align-content: start;
  }
  .iq .error:empty {
    display: none;
  }
  .iq .chips .chip input:checked + span {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .iq .chip span svg {
    flex: none;
  }
  .iq fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .iq-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--iq-pad);
  }
  .iq-opt {
    font-weight: 400;
    color: var(--muted);
  }
  .iq-textbtn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0 0.15rem;
    border: 0;
    background: none;
    color: var(--fg);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  .iq-textbtn:hover {
    text-decoration-color: var(--yellow-deep);
    text-decoration-thickness: 2px;
  }

  /* Progress */
  .iq-progress {
    list-style: none;
    margin: 0 0 var(--s-4);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-2);
  }
  .iq-pi {
    position: relative;
    border-top: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
  }
  .iq-pi::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    height: 3px;
    width: 0;
    background: var(--yellow);
    transition: width 0.3s var(--ease);
  }
  .iq-pi.is-current::before,
  .iq-pi.is-done::before {
    width: 100%;
  }
  .iq-pi.is-done::before {
    background: var(--ink);
  }
  .iq-pi-btn {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    min-height: 52px;
    padding: 0.55rem 0 0.35rem;
    border: 0;
    background: none;
    color: var(--muted);
    text-align: left;
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.25;
  }
  .iq-pi-n {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: 600;
    transition:
      background-color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .iq-pi.is-current .iq-pi-btn {
    color: var(--fg);
    font-weight: 600;
  }
  .iq-pi.is-current .iq-pi-n {
    background: var(--yellow);
    border-color: var(--yellow);
    color: var(--ink);
  }
  .iq-pi.is-done .iq-pi-btn {
    color: var(--fg);
  }
  .iq-pi.is-done .iq-pi-n {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .iq-pi-btn:hover .iq-pi-l {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  html:not(.js) .iq-progress,
  html:not(.js) .iq-nav {
    display: none;
  }

  /* Steps */
  .js .iq-step:not(.is-active) {
