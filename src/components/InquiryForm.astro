</style>

<script>
  import { saveInquiry, readJSON, writeJSON, remove, KEYS } from '../lib/store';

  interface ProductCfg {
    family: string;
    name: string;
    full: string;
    cat: string;
  }
  interface Cfg {
    lang: 'bg' | 'en';
    demo: boolean;
    maxFiles: number;
    maxMb: number;
    defaults: Record<string, Record<string, string | string[]>>;
    products: Record<string, ProductCfg>;
    s: Record<string, string>;
  }
  type Values = Record<string, string | string[]>;
  interface Draft {
    v: 1;
    productId: string | null;
    values: Values;
    savedAt: string;
  }
  interface Dim {
    el: HTMLElement;
    id: string;
    input: HTMLInputElement;
    range: HTMLInputElement | null;
    min: number;
    max: number;
    step: number;
    unit: 'm' | 'pcs';
    label: string;
    short: string;
    last: number;
  }
  type Control = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  const CLOSE_SVG =
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"/><path d="M18 6 6 18"/></svg>';
  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const fill = (tpl: string, vars: Record<string, string | number>) =>
    tpl.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? `{${k}}`));
  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
  const isControl = (el: Element): el is Control =>
    el instanceof HTMLInputElement || el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement;

  /** "3,5" / "3.5" / "3,5 м" → 3.5 */
  function parseNum(raw: string): number {
    const s = raw.trim().replace(/\s+/g, '').replace(/(м|m|бр\.?|pcs)$/i, '').replace(',', '.');
    return /^\d*\.?\d+$/.test(s) ? parseFloat(s) : NaN;
  }
  function normPhone(raw: string): string {
    let s = raw.replace(/[\s\-().\/]/g, '');
    if (s.startsWith('00')) s = '+' + s.slice(2);
    return s;
  }
  /** Bulgarian numbers (08X XXX XXXX, 02 XXX XXXX, +359 …) or any international E.164 number */
  function validPhone(raw: string): boolean {
    const s = normPhone(raw);
    return /^0[2-9]\d{7,8}$/.test(s) || /^\+3590?[2-9]\d{7,8}$/.test(s) || /^\+(?!359)[1-9]\d{7,14}$/.test(s);
  }
  function validEmail(raw: string): boolean {
    const s = raw.trim();
    return /^[^\s@]+@[^\s@]+\.[^\s@.]{2,}$/.test(s) && !s.includes('..');
  }

  function initInquiry(root: HTMLElement) {
    const cfgEl = root.querySelector('[data-iq-config]');
    if (!cfgEl) return;
    const cfg = JSON.parse(cfgEl.textContent || '{}') as Cfg;
    const S = cfg.s;
    const locale = cfg.lang === 'bg' ? 'bg-BG' : 'en-GB';
    const nf2 = new Intl.NumberFormat(locale, { maximumFractionDigits: 2 });
    const nf1 = new Intl.NumberFormat(locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const fmtN = (v: number) => nf2.format(v);
    const $ = <T extends Element = HTMLElement>(sel: string, ctx: ParentNode = root) => ctx.querySelector<T>(sel);
    const $$ = <T extends Element = HTMLElement>(sel: string, ctx: ParentNode = root) =>
      Array.from(ctx.querySelectorAll<T>(sel));

    const form = $<HTMLFormElement>('[data-iq-form]')!;
    const progress = $('[data-iq-progress]')!;
    const stepEls = $$('section.iq-step[data-step]');
    const total = stepEls.length;
    const backBtn = $<HTMLButtonElement>('[data-iq-back]')!;
    const nextBtn = $<HTMLButtonElement>('[data-iq-next]')!;
    const submitBtn = $<HTMLButtonElement>('[data-iq-submit]')!;
    const stepText = $('[data-iq-steptext]')!;
    const demoHint = $('[data-iq-demo-hint]');
    const live = $('[data-iq-live]')!;
    const select = $<HTMLSelectElement>('[data-iq-select]')!;
    const productWrap = $('[data-iq-product-wrap]')!;
    const changeBtn = $<HTMLButtonElement>('[data-iq-change]');
    const fixedName = $('[data-iq-fixed-name]');
    const board = $('[data-iq-board]')!;
    const svg = $<SVGSVGElement>('[data-iq-svg]')!;
    const areaEl = $('[data-iq-area]')!;
    const areaDetail = $('[data-iq-area-detail]')!;
    const areaLive = $('[data-iq-area-live]')!;
    const summaryEl = $('[data-iq-summary]')!;
    const successEl = $('[data-iq-success]')!;
    const fileInput = $<HTMLInputElement>('[data-iq-file]')!;
    const drop = $('[data-iq-drop]')!;
    const thumbs = $('[data-iq-thumbs]')!;
    const photosErr = document.getElementById(`${root.id}-photos-err`)!;
    const draftNote = $('[data-iq-draft]')!;
    const P = root.id;

    let step = 1;
    let family = root.dataset.family || 'pergola';
    let productId: string | null = null;
    let files: { file: File; url: string }[] = [];
    let saveTimer = 0;
    let areaTimer = 0;
    let submitted = false;
    let lastSummaryText = '';

    // ---------------------------------------------------------------- dimensions registry
    const dims: Record<string, Dim[]> = {};
    $$('[data-family-block][data-preview]').forEach((block) => {
      const fam = block.dataset.familyBlock!;
      dims[fam] = $$('[data-dim]', block).map((el) => {
        const input = $<HTMLInputElement>('[data-dim-input]', el)!;
        const d: Dim = {
          el,
          id: el.dataset.dim!,
          input,
          range: $<HTMLInputElement>('[data-dim-range]', el),
          min: Number(el.dataset.min),
          max: Number(el.dataset.max),
          step: Number(el.dataset.inc),
          unit: el.dataset.unit === 'pcs' ? 'pcs' : 'm',
          label: el.dataset.label || '',
          short: el.dataset.short || '',
          last: parseNum(input.value),
        };
        return d;
      });
    });
    const activeDims = () => dims[family] ?? [];
    const dimsBlock = () => $(`[data-family-block="${family}"][data-preview]`)!;
    const optsBlock = () => $(`.iq-opts[data-family-block="${family}"]`)!;

    // ---------------------------------------------------------------- errors
    function errFor(el: HTMLElement) {
      return document.getElementById(`${el.id}-err`);
    }
    function setError(el: HTMLElement, msg: string) {
      const err = errFor(el);
      const ids = (el.getAttribute('aria-describedby') || '').split(/\s+/).filter(Boolean);
      if (msg) {
        el.setAttribute('aria-invalid', 'true');
        if (err) {
          err.textContent = msg;
          if (!ids.includes(err.id)) ids.push(err.id);
        }
      } else {
        el.removeAttribute('aria-invalid');
        if (err) err.textContent = '';
        const i = err ? ids.indexOf(err.id) : -1;
        if (i >= 0) ids.splice(i, 1);
      }
      if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
      else el.removeAttribute('aria-describedby');
    }
    function announce(msg: string) {
      live.textContent = '';
      window.setTimeout(() => (live.textContent = msg), 40);
    }

    // ---------------------------------------------------------------- dimension validation + sync
    function dimError(d: Dim): string {
      const raw = d.input.value.trim();
      const v = parseNum(raw);
      const range = fill(d.unit === 'pcs' ? S.rangePcs : S.range, { min: fmtN(d.min), max: fmtN(d.max) });
      if (!raw) return S.required;
      if (Number.isNaN(v)) return d.unit === 'pcs' ? range : S.number;
      if (v < d.min || v > d.max || (d.unit === 'pcs' && !Number.isInteger(v))) return range;
      return '';
    }
    function validateDim(d: Dim, show = true): boolean {
      const msg = dimError(d);
      if (show) setError(d.input, msg);
      if (!msg) {
        d.last = parseNum(d.input.value);
        syncRange(d);
      }
      return !msg;
    }
    function syncRange(d: Dim) {
      if (!d.range) return;
      d.range.value = String(d.last);
      d.range.style.setProperty('--pct', `${((d.last - d.min) / (d.max - d.min)) * 100}%`);
      d.range.setAttribute('aria-valuetext', `${fmtN(d.last)} ${S.m}`);
    }
    function setDim(d: Dim, v: number) {
      const decimals = d.step < 0.1 ? 2 : d.step < 1 ? 1 : 0;
      const value = clamp(Number(v.toFixed(decimals)), d.min, d.max);
      d.last = value;
      d.input.value = fmtN(value);
      setError(d.input, '');
      syncRange(d);
      dimsChanged();
    }
    function dimsChanged() {
      draw();
      scheduleSave();
    }

    Object.values(dims)
      .flat()
      .forEach((d) => {
        d.range?.addEventListener('input', () => setDim(d, Number(d.range!.value)));
        d.input.addEventListener('input', () => {
          const v = parseNum(d.input.value);
          if (!Number.isNaN(v) && v >= d.min && v <= d.max) {
            d.last = v;
            syncRange(d);
            draw();
          }
          if (d.input.getAttribute('aria-invalid') === 'true') validateDim(d);
        });
        d.input.addEventListener('change', () => {
          if (validateDim(d)) d.input.value = fmtN(d.last);
          else announce(errFor(d.input)?.textContent || '');
          dimsChanged();
        });
        d.input.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown') return;
          e.preventDefault();
          const base = Number.isNaN(parseNum(d.input.value)) ? d.last : parseNum(d.input.value);
          const mult = e.shiftKey ? 10 : 1;
          setDim(d, base + (e.key === 'ArrowUp' ? 1 : -1) * d.step * mult);
        });
        $$<HTMLButtonElement>('[data-stepper]', d.el).forEach((b) =>
          b.addEventListener('click', () => {
            const base = Number.isNaN(parseNum(d.input.value)) ? d.last : parseNum(d.input.value);
            setDim(d, base + Number(b.dataset.stepper) * d.step);
          }),
        );
      });

    // ---------------------------------------------------------------- product + family
    function setFamily(fam: string) {
      family = fam;
      root.dataset.family = fam;
      $$('[data-family-block]').forEach((block) => {
        const on = block.dataset.familyBlock === fam;
        block.hidden = !on;
        if (block instanceof HTMLFieldSetElement) block.disabled = !on;
        $$<HTMLFieldSetElement | Control>('fieldset, input, select, textarea', block).forEach((c) => (c.disabled = !on));
      });
    }
    function applyPreset(id: string) {
      const preset = cfg.defaults[id];
      if (!preset) return;
      Object.entries(preset).forEach(([group, val]) => {
        const vals = Array.isArray(val) ? val : [val];
        $$<HTMLInputElement>(`input[name="opt.${family}.${group}"]`).forEach((i) => (i.checked = vals.includes(i.value)));
      });
    }
    function setProduct(id: string | null, applyDefaults: boolean) {
      productId = id && cfg.products[id] ? id : null;
      if (select.value !== (productId ?? '')) select.value = productId ?? '';
      const fam = productId ? cfg.products[productId].family : family;
      if (fam !== family) setFamily(fam);
      if (productId && applyDefaults) applyPreset(productId);
      if (fixedName && productId) fixedName.textContent = cfg.products[productId].name;
      if (productId) setError(select, '');
      draw();
    }
    select.addEventListener('change', () => {
      setProduct(select.value || null, true);
      scheduleSave();
    });
    changeBtn?.addEventListener('click', () => {
      const open = changeBtn.getAttribute('aria-expanded') !== 'true';
      changeBtn.setAttribute('aria-expanded', String(open));
      productWrap.classList.toggle('is-collapsed', !open);
      if (open) select.focus();
    });
    const opt = (group: string) =>
      $<HTMLInputElement>(`input[name="opt.${family}.${group}"]:checked`)?.value ?? '';

    // ---------------------------------------------------------------- preview drawing
    function draw() {
      const block = dimsBlock();
      if (!block) return;
      const preview = block.dataset.preview === 'plan' ? 'plan' : 'elevation';
      const ds = Object.fromEntries(activeDims().map((d) => [d.id, d]));
      const hd = ds.width ?? ds.length;
      const vd = preview === 'plan' ? ds.depth : ds.height;
      if (!hd || !vd) return;
      const a = hd.last;
      const b = vd.last;
      const units = ds.units ? Math.round(ds.units.last) : 1;

      const W = Math.round(clamp(board.clientWidth || 520, 280, 760));
      const H = Math.round(clamp(W * (preview === 'plan' ? 0.68 : 0.62), 250, 420));
      const narrow = W < 420;
      const M = { l: 18, r: narrow ? 100 : 118, t: 56, b: preview === 'plan' ? 60 : 70 };
      const aw = W - M.l - M.r;
      const ah = H - M.t - M.b;
      const s = Math.min(aw / a, ah / b);
      const rw = a * s;
      const rh = b * s;
      const x0 = M.l + (aw - rw) / 2;
      const y0 = M.t + (ah - rh) / 2;
      const r = (n: number) => Math.round(n * 10) / 10;
      const line = (x1: number, y1: number, x2: number, y2: number, cls: string) =>
        `<line class="${cls}" x1="${r(x1)}" y1="${r(y1)}" x2="${r(x2)}" y2="${r(y2)}"/>`;
      const rect = (x: number, y: number, w: number, h: number, cls: string, extra = '') =>
        `<rect class="${cls}" x="${r(x)}" y="${r(y)}" width="${r(Math.max(0, w))}" height="${r(Math.max(0, h))}"${extra}/>`;
      const txt = (x: number, y: number, body: string, anchor = 'start') =>
        `<text x="${r(x)}" y="${r(y)}" text-anchor="${anchor}">${body}</text>`;
      const tk = (s1: string) => `<tspan class="t-k">${esc(s1)}</tspan>`;
      const tv = (s1: string) => `<tspan class="t-v">${esc(s1)}</tspan>`;
      const m = (v: number) => `${fmtN(v)} ${S.m}`;

      let out = `<defs>
        <pattern id="${P}-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line class="hatch-ln" x1="0" y1="0" x2="0" y2="6"/></pattern>
        <pattern id="${P}-dots" width="5" height="5" patternUnits="userSpaceOnUse"><circle class="dot" cx="2.5" cy="2.5" r="0.9"/></pattern>
      </defs>`;

      // Top row: view name (+ units) and a scale bar
      const view = preview === 'plan' ? S.planView : S.elevationView;
      out += txt(M.l, 22, tk(view + (units > 1 ? ` · ${units} ${S.pcs}` : '')));
      const unitsList = [0.1, 0.2, 0.25, 0.5, 1, 2, 5, 10];
      let u = unitsList[0];
      for (const c of unitsList) if (c * s <= 72) u = c;
      const bx2 = W - 10;
      const bx1 = bx2 - u * s;
      out += line(bx1, 18, bx2, 18, 'scale') + line(bx1, 13, bx1, 23, 'tick') + line(bx2, 13, bx2, 23, 'tick');
      out += txt(bx1 - 7, 22, tk(m(u)), 'end');

      let rightPad = 22;
      if (preview === 'plan') {
        const mount = opt('mounting');
        const wallTop = family === 'awning' ? opt('mounting') !== 'ceiling' : mount === 'wall';
        const ceiling = family === 'awning' && opt('mounting') === 'ceiling';
        const sideWalls = family === 'pergola' && mount === 'between-walls';
        if (wallTop || ceiling) {
          out += rect(x0 - 12, y0 - 10, rw + 24, 10, '', ` fill="url(#${P}-hatch)"`) + line(x0 - 12, y0, x0 + rw + 12, y0, 'ln-strong');
          out += txt(x0 - 12, y0 - 16, tk(S.facade));
        }
        if (sideWalls) {
          out += rect(x0 - 10, y0 - 8, 10, rh + 16, '', ` fill="url(#${P}-hatch)"`) + line(x0, y0 - 8, x0, y0 + rh + 8, 'ln-strong');
          out += rect(x0 + rw, y0 - 8, 10, rh + 16, '', ` fill="url(#${P}-hatch)"`) + line(x0 + rw, y0 - 8, x0 + rw, y0 + rh + 8, 'ln-strong');
          rightPad = 30;
        }
        out += rect(x0, y0, rw, rh, 'f-area');
        if (family === 'pergola') {
          const roof = opt('roofType');
          const horiz = (gap: number, cls: string) => {
            let g = '';
            for (let y = y0 + gap; y < y0 + rh - 1; y += gap) g += line(x0 + 1, y, x0 + rw - 1, y, cls);
            return g;
          };
          const vert = (gap: number, cls: string) => {
            let g = '';
            for (let x = x0 + gap; x < x0 + rw - 1; x += gap) g += line(x, y0 + 1, x, y0 + rh - 1, cls);
            return g;
          };
          if (roof === 'lamellas') out += horiz(Math.max(5, 0.22 * s), 'ln');
          else if (roof === 'pvc') out += horiz(Math.max(9, 0.55 * s), 'ln');
          else if (roof === 'glass' || roof === 'thermo') out += vert(Math.max(14, (roof === 'glass' ? 1.1 : 1) * s), 'ln');
          // posts
          const ps = 8;
          const corners: [number, number][] = [];
          if (mount === 'freestanding' || mount === 'advise' || !mount)
            corners.push([x0, y0], [x0 + rw - ps, y0], [x0, y0 + rh - ps], [x0 + rw - ps, y0 + rh - ps]);
          else if (mount === 'wall') corners.push([x0, y0 + rh - ps], [x0 + rw - ps, y0 + rh - ps]);
          corners.forEach(([x, y]) => (out += rect(x, y, ps, ps, 'f-post')));
        } else {
          // awning: cassette at the façade, fabric runs outwards, front profile
          for (let x = x0 + Math.max(10, 0.5 * s); x < x0 + rw - 1; x += Math.max(10, 0.5 * s)) out += line(x, y0 + 5, x, y0 + rh - 3, 'ln');
          out += rect(x0, y0, rw, 5, 'f-frame') + rect(x0, y0 + rh - 3, rw, 3, 'f-frame');
        }
      } else {
        // Elevation: ground line
        out += rect(x0 - 16, y0 + rh, rw + 32, 7, '', ` fill="url(#${P}-hatch)"`) + line(x0 - 16, y0 + rh, x0 + rw + 16, y0 + rh, 'ground');
        const tint = opt('tint') || opt('glass');
        const glassCls = `f-glass${tint === 'tinted' ? ' tinted' : tint === 'frosted' ? ' frosted' : ''}`;
        if (family === 'glass') {
          const sys = opt('systemType');
          const panelsOpt = opt('panels');
          out += rect(x0, y0, rw, rh, glassCls);
          if (sys === 'guillotine') {
            const mods = clamp(Math.ceil(a / 3.5), 1, 12);
            for (let i = 1; i < mods; i++) out += line(x0 + (rw * i) / mods, y0, x0 + (rw * i) / mods, y0 + rh, 'ln-strong');
            for (let i = 1; i < 3; i++) out += line(x0, y0 + (rh * i) / 3, x0 + rw, y0 + (rh * i) / 3, 'ln-strong');
          } else {
            const n = /^\d+$/.test(panelsOpt)
              ? Number(panelsOpt)
              : panelsOpt === 'more'
                ? clamp(Math.round(a / 1.1), 5, 16)
                : clamp(Math.round(a / 1.1), 2, 16);
            const pw = rw / n;
            for (let i = 0; i < n; i++) {
              const off = sys === 'sliding' && i % 2 === 1 ? 3 : 0;
              out += rect(x0 + i * pw + 1, y0 + 1 + off, pw - 2, rh - 2 - off * 2, glassCls);
              if (sys === 'folding' && i > 0) out += `<circle class="f-post" cx="${r(x0 + i * pw)}" cy="${r(y0 + 6)}" r="2.2"/>`;
            }
          }
          out += rect(x0, y0, rw, rh, 'ln-strong', ' fill="none" stroke-width="2"');
        } else if (family === 'door') {
          const hh = clamp(rh * 0.1, 7, 16);
          const n = opt('leafType') === 'telescopic' ? 6 : 4;
          const pw = rw / n;
          for (let i = 0; i < n; i++) out += rect(x0 + i * pw + 1, y0 + hh + 1, pw - 2, rh - hh - 2, glassCls);
          out += rect(x0 - 4, y0, rw + 8, hh, 'f-frame');
          const cx = x0 + rw / 2;
          const ay = y0 + hh + Math.min(18, (rh - hh) / 2);
          const al = Math.min(pw * 0.6, 26);
          out += `<path class="arrow-ln" d="M${r(cx - 4)} ${r(ay)}h${r(-al)}m5 -4l-5 4l5 4M${r(cx + 4)} ${r(ay)}h${r(al)}m-5 -4l5 4l-5 4"/>`;
          rightPad = 26;
        } else if (family === 'zip') {
          const ch = clamp(0.14 * s, 7, 18);
          const fabric = opt('fabric');
          out += rect(x0 + 3, y0 + ch, rw - 6, rh - ch - 4, `f-fabric${fabric === 'blackout' ? ' dark' : ''}`);
          if (fabric !== 'blackout') out += rect(x0 + 3, y0 + ch, rw - 6, rh - ch - 4, '', ` fill="url(#${P}-dots)"`);
          out += rect(x0, y0 + ch, 3, rh - ch, 'f-frame') + rect(x0 + rw - 3, y0 + ch, 3, rh - ch, 'f-frame');
          out += rect(x0 + 3, y0 + rh - 4, rw - 6, 4, 'f-frame') + rect(x0 - 3, y0, rw + 6, ch, 'f-frame');
          rightPad = 25;
        } else {
          // windbreak: telescopic glass, upper panel raised over the fixed lower one
          const mods = clamp(Math.ceil(a / 2), 1, 30);
          out += rect(x0, y0 + rh * 0.46, rw, rh * 0.54, glassCls);
          out += rect(x0 + 2, y0, rw - 4, rh * 0.52, glassCls);
          for (let i = 0; i <= mods; i++) {
            const x = x0 + (rw * i) / mods;
            out += rect(clamp(x - 2, x0, x0 + rw - 4), y0 + rh * 0.4, 4, rh * 0.6, 'f-post');
          }
        }
      }

      // Dimension lines: horizontal below, vertical on the right (labels live in reserved margins → no overlaps)
      const base = preview === 'plan' ? y0 + rh : y0 + rh + 7;
      const dy = base + 20;
      out += line(x0, base + 4, x0, dy + 6, 'ext') + line(x0 + rw, base + 4, x0 + rw, dy + 6, 'ext');
      out += line(x0, dy, x0 + rw, dy, 'dim') + line(x0 - 4, dy + 4, x0 + 4, dy - 4, 'tick') + line(x0 + rw - 4, dy + 4, x0 + rw + 4, dy - 4, 'tick');
      const hLabel = `${hd.short} ${m(a)}`;
      const est = hd.short.length * 6.4 + m(a).length * 8.2 + 6;
      const hcx = clamp(x0 + rw / 2, M.l + est / 2, W - 6 - est / 2);
      out += txt(hcx, dy + 20, `${tk(hd.short)} ${tv(m(a))}`, 'middle');

      const dx = x0 + rw + rightPad;
      out += line(x0 + rw + 4, y0, dx + 6, y0, 'ext') + line(x0 + rw + 4, y0 + rh, dx + 6, y0 + rh, 'ext');
      out += line(dx, y0, dx, y0 + rh, 'dim') + line(dx - 4, y0 + 4, dx + 4, y0 - 4, 'tick') + line(dx - 4, y0 + rh + 4, dx + 4, y0 + rh - 4, 'tick');
      const mid = y0 + rh / 2;
      out += `<text x="${r(dx + 10)}" y="${r(mid - 5)}">${tk(vd.short)}</text><text x="${r(dx + 10)}" y="${r(mid + 15)}">${tv(m(b))}</text>`;

      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg.innerHTML = out;

      // Area readout
      const area = a * b;
      const totalArea = area * units;
      areaEl.textContent = nf1.format(totalArea);
      areaDetail.textContent = units > 1 ? `${nf1.format(area)} ${S.m2} × ${units}` : '';
      const desc = `${view}: ${hLabel}, ${vd.short} ${m(b)}${units > 1 ? `, ${units} ${S.pcs}` : ''}. ${S.area} ${S.approx} ${nf1.format(totalArea)} ${S.m2}`;
      svg.setAttribute('aria-label', desc);
      window.clearTimeout(areaTimer);
      areaTimer = window.setTimeout(() => (areaLive.textContent = `${S.area} ${S.approx} ${nf1.format(totalArea)} ${S.m2}`), 700);
    }
    let raf = 0;
    const redraw = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(draw);
    };
    if ('ResizeObserver' in window) new ResizeObserver(redraw).observe(board);
    else window.addEventListener('resize', redraw);

    // ---------------------------------------------------------------- photos
    const fmtSize = (b: number) => (b > 1e6 ? `${nf1.format(b / 1e6)} MB` : `${Math.max(1, Math.round(b / 1e3))} KB`);
    function renderThumbs() {
      thumbs.innerHTML = files
        .map(
          (f, i) => `<li class="iq-thumb"><img src="${f.url}" alt="" width="56" height="56"/><span><span class="iq-thumb-name">${esc(f.file.name)}</span><span class="iq-thumb-size num">${fmtSize(f.file.size)}</span></span><button type="button" class="iq-thumb-rm" data-rm="${i}" aria-label="${esc(fill(S.removePhoto, { name: f.file.name }))}">${CLOSE_SVG}</button></li>`,
        )
        .join('');
    }
    function addFiles(list: FileList | File[]) {
      const errs = new Set<string>();
      for (const f of Array.from(list)) {
        const okType = /^image\/(jpeg|png|webp)$/.test(f.type) || (!f.type && /\.(jpe?g|png|webp)$/i.test(f.name));
        if (!okType) {
          errs.add(S.fileType);
          continue;
        }
        if (f.size > cfg.maxMb * 1024 * 1024) {
          errs.add(fill(S.tooLarge, { name: f.name, n: cfg.maxMb }));
          continue;
        }
        if (files.some((x) => x.file.name === f.name && x.file.size === f.size)) continue;
        if (files.length >= cfg.maxFiles) {
          errs.add(fill(S.tooMany, { n: cfg.maxFiles }));
          break;
        }
        files.push({ file: f, url: URL.createObjectURL(f) });
      }
      photosErr.textContent = [...errs].join(' ');
      renderThumbs();
    }
    function clearFiles() {
      files.forEach((f) => URL.revokeObjectURL(f.url));
      files = [];
      photosErr.textContent = '';
      renderThumbs();
    }
    fileInput.addEventListener('change', () => {
      if (fileInput.files) addFiles(fileInput.files);
      fileInput.value = '';
    });
    thumbs.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-rm]');
      if (!btn) return;
      const i = Number(btn.dataset.rm);
      URL.revokeObjectURL(files[i].url);
      files.splice(i, 1);
      photosErr.textContent = '';
      renderThumbs();
      const next = $$<HTMLButtonElement>('[data-rm]', thumbs)[Math.min(i, files.length - 1)];
      (next ?? fileInput).focus();
    });
    ['dragenter', 'dragover'].forEach((ev) =>
      drop.addEventListener(ev, (e) => {
        e.preventDefault();
        drop.classList.add('is-over');
      }),
    );
    ['dragleave', 'dragend'].forEach((ev) => drop.addEventListener(ev, () => drop.classList.remove('is-over')));
    drop.addEventListener('drop', (e) => {
      e.preventDefault();
      drop.classList.remove('is-over');
      const dt = (e as DragEvent).dataTransfer;
      if (dt?.files?.length) addFiles(dt.files);
    });

    // ---------------------------------------------------------------- contact requirements
    const nameInput = $<HTMLInputElement>('[name="contact.name"]')!;
    const phoneInput = $<HTMLInputElement>('[data-iq-phone]')!;
    const emailInput = $<HTMLInputElement>('[data-iq-email]')!;
    const consent = $<HTMLInputElement>('[data-iq-consent]')!;
    const channelValue = () => $<HTMLInputElement>('[data-iq-channel]:checked')?.value ?? 'phone';
    function updateRequired() {
      const ch = channelValue();
      const phoneReq = ch !== 'email';
      phoneInput.setAttribute('aria-required', String(phoneReq));
      emailInput.setAttribute('aria-required', String(!phoneReq));
      const pm = $('[data-opt-mark="phone"]');
      const em = $('[data-opt-mark="email"]');
      if (pm) pm.hidden = phoneReq;
      if (em) em.hidden = !phoneReq;
    }
    $$<HTMLInputElement>('[data-iq-channel]').forEach((r) =>
      r.addEventListener('change', () => {
        updateRequired();
        if (phoneInput.hasAttribute('aria-invalid')) validateField(phoneInput);
        if (emailInput.hasAttribute('aria-invalid')) validateField(emailInput);
      }),
    );
    function fieldError(el: HTMLInputElement): string {
      const v = el.value.trim();
      const ch = channelValue();
      if (el === nameInput) return v.length >= 2 ? '' : S.required;
      if (el === phoneInput) return v ? (validPhone(v) ? '' : S.phone) : ch !== 'email' ? S.required : '';
      if (el === emailInput) return v ? (validEmail(v) ? '' : S.email) : ch === 'email' ? S.required : '';
      if (el === consent) return el.checked ? '' : S.consent;
      return '';
    }
    function validateField(el: HTMLInputElement): boolean {
      const msg = fieldError(el);
      setError(el, msg);
      return !msg;
    }
    [nameInput, phoneInput, emailInput].forEach((el) => {
      el.addEventListener('blur', () => {
        if (el.value.trim() || el.hasAttribute('aria-invalid')) {
          if (!validateField(el)) announce(errFor(el)?.textContent || '');
        }
      });
      el.addEventListener('input', () => {
        if (el.hasAttribute('aria-invalid')) validateField(el);
      });
    });
    consent.addEventListener('change', () => {
      if (consent.hasAttribute('aria-invalid')) validateField(consent);
    });

    // ---------------------------------------------------------------- steps
    function validateStep(n: number): HTMLElement | null {
      let first: HTMLElement | null = null;
      const flag = (el: HTMLElement | null) => {
        if (el && !first) first = el;
      };
      if (n === 1) {
        if (!productId) {
          setError(select, S.product);
          flag(select);
        }
        activeDims().forEach((d) => {
          if (!validateDim(d)) flag(d.input);
        });
      } else if (n === total) {
        [nameInput, phoneInput, emailInput, consent].forEach((el) => {
          if (!validateField(el)) flag(el);
        });
      }
      return first;
    }
    function focusInvalid(el: HTMLElement) {
      if (el === select && productWrap.classList.contains('is-collapsed')) {
        productWrap.classList.remove('is-collapsed');
        changeBtn?.setAttribute('aria-expanded', 'true');
      }
      el.focus();
      announce(S.fixErrors);
    }
    function scrollToTop() {
      const top = root.getBoundingClientRect().top;
      if (top < 0 || top > window.innerHeight * 0.6) root.scrollIntoView({ behavior: reduceMotion() ? 'auto' : 'smooth', block: 'start' });
    }
    function show(n: number, focus = true) {
      step = n;
      stepEls.forEach((s) => {
        const on = Number(s.dataset.step) === n;
        s.classList.toggle('is-active', on);
        s.hidden = !on;
      });
      $$('[data-pi]', progress).forEach((li) => {
        const k = Number(li.dataset.pi);
        li.classList.toggle('is-current', k === n);
        li.classList.toggle('is-done', k < n);
        const b = $<HTMLButtonElement>('[data-goto]', li)!;
        if (k === n) b.setAttribute('aria-current', 'step');
        else b.removeAttribute('aria-current');
      });
      backBtn.hidden = n === 1;
      nextBtn.hidden = n === total;
      submitBtn.hidden = n !== total;
      if (demoHint) demoHint.hidden = n !== total;
      stepText.textContent = fill(S.stepOf, { n, total });
      if (n === total) renderSummary(summaryEl, false);
      if (n === 1) redraw();
      if (focus) {
        $<HTMLElement>('[data-step-title]', stepEls[n - 1])?.focus({ preventScroll: true });
        scrollToTop();
      }
    }
    function goTo(n: number) {
      if (n === step) return;
      if (n > step) {
        for (let k = step; k < n; k++) {
          const bad = validateStep(k);
          if (bad) {
            if (k !== step) show(k, false);
            focusInvalid(bad);
            return;
          }
        }
      }
      show(n);
    }
    nextBtn.addEventListener('click', () => goTo(step + 1));
    backBtn.addEventListener('click', () => goTo(step - 1));
    $$<HTMLButtonElement>('[data-goto]', progress).forEach((b) => b.addEventListener('click', () => goTo(Number(b.dataset.goto))));
    summaryEl.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-edit]');
      if (b) goTo(Number(b.dataset.edit));
    });

    // Enter in a text field moves on instead of submitting early
    form.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' || e.isComposing) return;
      const el = e.target as HTMLElement;
      if (!(el instanceof HTMLInputElement)) return;
      if (el.type === 'checkbox' || el.type === 'radio') {
        e.preventDefault();
        el.click();
        return;
      }
      if (['button', 'submit', 'file', 'range'].includes(el.type)) return;
      e.preventDefault();
      if (step < total) {
        el.dispatchEvent(new Event('change', { bubbles: true }));
        goTo(step + 1);
      }
    });

    // ---------------------------------------------------------------- collect + summary
    function collect() {
      const p = productId ? cfg.products[productId] : null;
      const dimList = activeDims().map((d) => ({ id: d.id, label: d.label, value: d.last, unit: d.unit }));
      const groupInfo = (fs: HTMLElement) => {
        const checked = $$<HTMLInputElement>('input:checked', fs);
        return {
          id: fs.dataset.group!,
          label: fs.dataset.label || '',
          multi: fs.dataset.type === 'multi',
          values: checked.map((i) => i.value),
          labels: checked.map((i) => i.nextElementSibling?.textContent?.replace(/\s+/g, ' ').trim() || i.value),
        };
      };
      const optionGroups = $$('fieldset[data-group]', optsBlock()).map(groupInfo);
      const texts = $$<HTMLInputElement>('[data-text-field]', optsBlock())
        .map((i) => ({ id: i.dataset.textField!, label: i.dataset.label || '', value: i.value.trim() }))
        .filter((x) => x.value);
      const projectGroups = $$('fieldset[data-group]', $('[data-iq-project]')!).map(groupInfo);
      const chInput = $<HTMLInputElement>('[data-iq-channel]:checked');
      const ds = Object.fromEntries(dimList.map((d) => [d.id, d.value]));
      const area = (ds.width ?? ds.length ?? 0) * (ds.depth ?? ds.height ?? 0) * (ds.units ?? 1);
      return {
        product: p,
        dimList,
        area,
        optionGroups,
        texts,
        projectGroups,
        contact: {
          name: nameInput.value.trim(),
          phone: phoneInput.value.trim(),
          email: emailInput.value.trim(),
          city: ($<HTMLInputElement>('[name="contact.city"]')?.value || '').trim(),
          channel: chInput?.value ?? 'phone',
          channelLabel: chInput?.nextElementSibling?.textContent?.replace(/\s+/g, ' ').trim() ?? '',
        },
        message: ($<HTMLTextAreaElement>('[name="message"]')?.value || '').trim(),
        files: files.map((f) => f.file.name),
      };
    }
    type Collected = ReturnType<typeof collect>;
    const dimText = (c: Collected) =>
      c.dimList.map((d) => `${d.label} ${fmtN(d.value)}${d.unit === 'pcs' ? ` ${S.pcs}` : ` ${S.m}`}`).join(' · ');
    const groupText = (g: Collected['optionGroups'][number]) => (g.labels.length ? g.labels.join(', ') : S.noneSelected);

    function renderSummary(target: HTMLElement, withContact: boolean) {
      const c = collect();
      const sec = (title: string, body: string, edit?: number) =>
        `<div class="iq-sum-sec"><dt>${esc(title)}</dt><dd>${body}</dd>${edit ? `<button type="button" class="iq-textbtn" data-edit="${edit}">${esc(S.edit)}<span class="sr-only">: ${esc(title)}</span></button>` : ''}</div>`;
      const list = (rows: [string, string][]) =>
        `<ul class="iq-sum-list">${rows.map(([k, v]) => `<li><span class="iq-sum-k">${esc(k)}:</span> ${esc(v)}</li>`).join('')}</ul>`;
      let html = '<dl class="iq-sum">';
      html += sec(S.secProduct, c.product ? `<strong>${esc(c.product.name)}</strong>\n${esc(c.product.full)}` : '—', withContact ? undefined : 1);
      html += sec(
        S.secDims,
        `${esc(dimText(c))}\n${esc(`${S.area} ${S.approx} ${nf1.format(c.area)} ${S.m2}`)}`,
        withContact ? undefined : 1,
      );
      const optRows: [string, string][] = [
        ...c.optionGroups.filter((g) => g.labels.length || !g.multi).map((g) => [g.label, groupText(g)] as [string, string]),
        ...c.texts.map((x) => [x.label, x.value] as [string, string]),
      ];
      html += sec(S.secOptions, list(optRows), withContact ? undefined : 2);
      html += sec(S.secProject, list(c.projectGroups.map((g) => [g.label, groupText(g)])), withContact ? undefined : 2);
      if (c.files.length) html += sec(`${S.secPhotos} (${c.files.length})`, esc(c.files.join(', ')), withContact ? undefined : 2);
      if (c.message) html += sec(S.secMessage, esc(c.message), withContact ? undefined : 2);
      if (withContact) {
        const lines = [c.contact.name, c.contact.phone, c.contact.email, c.contact.city].filter(Boolean).map(esc);
        lines.push(`${esc(S.channelShort)}: ${esc(c.contact.channelLabel)}`);
        html += sec(S.secContact, lines.join('\n'));
      }
      html += '</dl>';
      target.innerHTML = html;

      lastSummaryText = [
        `${S.secProduct}: ${c.product ? `${c.product.name} (${c.product.full})` : '—'}`,
        `${S.secDims}: ${dimText(c)}; ${S.area} ${S.approx} ${nf1.format(c.area)} ${S.m2}`,
        ...optRows.map(([k, v]) => `${k}: ${v}`),
        ...c.projectGroups.map((g) => `${g.label}: ${groupText(g)}`),
        c.files.length ? `${S.secPhotos}: ${c.files.join(', ')}` : '',
        c.message ? `${S.secMessage}: ${c.message}` : '',
        `${S.secContact}: ${[c.contact.name, c.contact.phone, c.contact.email, c.contact.city].filter(Boolean).join(', ')} (${S.channelShort}: ${c.contact.channelLabel})`,
      ]
        .filter(Boolean)
        .join('\n');
      return c;
    }

    // ---------------------------------------------------------------- draft (localStorage)
    function serialize(): Values {
      const out: Values = {};
      for (const el of Array.from(form.elements)) {
        if (!isControl(el) || !el.name || el.name === 'consent') continue;
        if (el instanceof HTMLInputElement && (el.type === 'file' || el.type === 'range')) continue;
        if (el instanceof HTMLInputElement && el.type === 'radio') {
          if (el.checked) out[el.name] = el.value;
        } else if (el instanceof HTMLInputElement && el.type === 'checkbox') {
          const arr = (out[el.name] as string[] | undefined) ?? [];
          if (el.checked) arr.push(el.value);
          out[el.name] = arr;
        } else out[el.name] = el.value;
      }
      return out;
    }
    function restore(values: Values, filter?: (name: string) => boolean) {
      for (const el of Array.from(form.elements)) {
        if (!isControl(el) || !el.name || !(el.name in values) || (filter && !filter(el.name))) continue;
        if (el instanceof HTMLInputElement && (el.type === 'file' || el.type === 'range')) continue;
        const v = values[el.name];
        if (el instanceof HTMLInputElement && (el.type === 'radio' || el.type === 'checkbox'))
          el.checked = Array.isArray(v) ? v.includes(el.value) : v === el.value;
        else if (typeof v === 'string') el.value = v;
      }
      Object.values(dims)
        .flat()
        .forEach((d) => validateDim(d, false));
    }
    function saveDraft() {
      if (submitted) return;
      const draft: Draft = { v: 1, productId, values: serialize(), savedAt: new Date().toISOString() };
      writeJSON(KEYS.draft, draft);
    }
    function scheduleSave() {
      window.clearTimeout(saveTimer);
      saveTimer = window.setTimeout(saveDraft, 350);
    }
    form.addEventListener('input', (e) => {
      if ((e.target as HTMLElement).matches('[data-iq-file]')) return;
      scheduleSave();
    });
    form.addEventListener('change', (e) => {
      const el = e.target as HTMLElement;
      if (el.matches('input[name^="opt."]')) draw();
      scheduleSave();
    });

    // ---------------------------------------------------------------- submit + success
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (step < total) {
        goTo(step + 1);
        return;
      }
      for (let k = 1; k <= total; k++) {
        const bad = validateStep(k);
        if (bad) {
          if (k !== step) show(k, false);
          focusInvalid(bad);
          return;
        }
      }
      const c = collect();
      const options: Values = {};
      c.optionGroups.forEach((g) => (options[g.id] = g.multi ? g.values : (g.values[0] ?? '')));
      c.projectGroups.forEach((g) => (options[g.id] = g.values[0] ?? ''));
      c.texts.forEach((x) => (options[x.id] = x.value));
      const stored = saveInquiry({
        lang: cfg.lang,
        productId,
        family,
        dims: Object.fromEntries(c.dimList.map((d) => [d.id, d.value])),
        options,
        contact: {
          name: c.contact.name,
          phone: c.contact.phone,
          email: c.contact.email,
          city: c.contact.city || undefined,
          channel: c.contact.channel,
        },
        message: c.message || undefined,
        files: c.files.length ? c.files : undefined,
      });
      submitted = true;
      window.clearTimeout(saveTimer);
      remove(KEYS.draft);
      renderSummary($('[data-iq-success-summary]')!, true);
      $('[data-iq-storage-note]')!.hidden = !!stored;
      form.hidden = true;
      progress.hidden = true;
      successEl.hidden = false;
      root.dataset.state = 'sent';
      if (stored) successEl.dataset.inquiryId = stored.id;
      $<HTMLElement>('[data-iq-success-title]')?.focus({ preventScroll: true });
      scrollToTop();
    });

    $('[data-iq-copy-summary]')?.addEventListener('click', async () => {
      const label = $('[data-iq-copy-label]')!;
      const orig = label.textContent;
      try {
        await navigator.clipboard.writeText(lastSummaryText);
        label.textContent = S.copied;
      } catch {
        label.textContent = orig;
      }
      window.setTimeout(() => (label.textContent = orig), 1800);
    });

    function resetForm(keepContact: boolean) {
      const keep = keepContact ? serialize() : {};
      form.reset();
      clearFiles();
      if (keepContact) restore(keep, (n) => n.startsWith('contact.'));
      $$<HTMLElement>('[aria-invalid]', form).forEach((el) => setError(el, ''));
      Object.values(dims)
        .flat()
        .forEach((d) => validateDim(d, false));
      const pre = initialProduct();
      setProduct(pre ?? (select.value || null), true);
      if (!productId) setFamily(root.dataset.initialFamily || family);
      updateRequired();
      draftNote.hidden = true;
      submitted = false;
    }
    $('[data-iq-new]')?.addEventListener('click', () => {
      const last = productId;
      resetForm(true);
      if (last && !initialProduct()) setProduct(last, true);
      successEl.hidden = true;
      form.hidden = false;
      progress.hidden = false;
      delete root.dataset.state;
      show(1);
    });
    $('[data-iq-reset]')?.addEventListener('click', () => {
      remove(KEYS.draft);
      resetForm(false);
      show(1);
    });

    // ---------------------------------------------------------------- init
    function initialProduct(): string | null {
      const fromProp = root.dataset.product;
      if (fromProp && cfg.products[fromProp]) return fromProp;
      const q = new URLSearchParams(window.location.search).get('product');
      return q && cfg.products[q] ? q : null;
    }
    root.dataset.initialFamily = family;
    const pre = initialProduct();
    const draft = readJSON<Draft | null>(KEYS.draft, null);
    if (draft && draft.v === 1 && draft.values && typeof draft.values === 'object') {
      let before = '';
      if (!pre || draft.productId === pre) {
        // same product (or none preselected): continue exactly where the visitor left off
        before = JSON.stringify(serialize());
        const id = pre ?? (draft.productId && cfg.products[draft.productId] ? draft.productId : null);
        if (id) setFamily(cfg.products[id].family);
        restore(draft.values);
        setProduct(id, false);
      } else {
        // another product was requested: keep only the personal details and project info
        setProduct(pre, true);
        before = JSON.stringify(serialize());
        restore(draft.values, (n) => n.startsWith('contact.') || n.startsWith('proj.') || n === 'message');
      }
      if (JSON.stringify(serialize()) !== before) draftNote.hidden = false;
    } else {
      setProduct(pre, true);
    }
    setFamily(family);
    updateRequired();
    show(1, false);
    root.classList.add('is-ready');
  }

  document.querySelectorAll<HTMLElement>('[data-inquiry]').forEach(initInquiry);
</script>
