  }
  .iq-s1-dims {
    grid-area: dims;
  }
  @container iq (min-width: 780px) {
    .iq-s1 {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
      grid-template-areas: 'product preview' 'dims preview';
      grid-template-rows: auto 1fr;
      column-gap: var(--s-7);
    }
    .iq-preview {
      align-self: start;
      position: sticky;
      top: calc(var(--header-h) + 24px);
