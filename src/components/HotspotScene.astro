---
import type { Hotspot, Lang } from '../data/types';
import { products } from '../data/products';
import { categories } from '../data/categories';
import { productUrl, categoryUrl, url, t } from '../lib/i18n';
import Img from './Img.astro';
import { img } from '../lib/images';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  image: string;
  hotspots: Hotspot[];
  /** show a numbered legend under the image */
  legend?: boolean;
  sizes?: string;
  id: string;
}
const { lang, image, hotspots, legend = true, sizes = '100vw', id } = Astro.props;

const items = hotspots.map((h, i) => {
  const p = h.productId ? products.find((x) => x.id === h.productId) : undefined;
  const c = h.categoryId ? categories.find((x) => x.id === h.categoryId) : undefined;
  return {
    ...h,
    n: i + 1,
    title: t(h.label, lang),
    text: p ? t(p.summary, lang) : c ? (t(c.intro[0], lang).split(/(?<=\.)\s/)[0] ?? t(c.tagline, lang)) : '',
    // systems without their own product page (balustrades, joinery) lead to the company's activities
    href: p ? productUrl(lang, p.category, p.id) : c ? categoryUrl(lang, c.id) : url(lang, '/about/'),
    linkLabel: p ? t(p.name, lang) : c ? t(c.name, lang) : lang === 'bg' ? 'За нас' : 'About us',
    fallback: !p && !c,
    isCategory: !p && !!c,
    // flip the card to the left/top near edges
    alignX: h.x > 62 ? 'right' : h.x < 30 ? 'left' : 'center',
    alignY: h.y > 58 ? 'up' : 'down',
  };
});
const more = lang === 'bg' ? 'Виж продукта' : 'View product';
const moreCat = lang === 'bg' ? 'Виж системите' : 'View the systems';
const meta = img(image);
const ratio = meta ? `aspect-ratio:${meta.width}/${meta.height}` : undefined;
// On a ~358px-wide phone image, would any two 30px dots overlap? Then phones rely on the numbered legend instead.
const aspect = meta ? meta.width / meta.height : 16 / 9;
const W = 358;
const crowded = hotspots.some((a, i) =>
  hotspots.slice(i + 1).some((b) => Math.hypot(((a.x - b.x) / 100) * W, ((a.y - b.y) / 100) * (W / aspect)) < 34),
);
---

<div class:list={['scene', { 'dots-crowded': crowded }]} data-scene>
  <div class="scene-stage" style={ratio}>
    <Img src={image} lang={lang} sizes={sizes} />
    {
      items.map((h) => (
        <div class="hs" style={`left:${h.x}%;top:${h.y}%`} data-align-x={h.alignX} data-align-y={h.alignY}>
          <button
            type="button"
            class="hs-dot"
            aria-expanded="false"
            aria-controls={`${id}-card-${h.n}`}
            data-hs-btn
          >
            <span aria-hidden="true">{h.n}</span>
            <span class="sr-only">{h.title}</span>
          </button>
          <div class="hs-card" id={`${id}-card-${h.n}`} role="group" aria-label={h.title} hidden data-hs-card>
            <p class="hs-title">{h.title}</p>
            {h.text && <p class="hs-text">{h.text}</p>}
            {h.href && (
              <a class="link-arrow" href={h.href}>
                {h.fallback ? h.linkLabel : h.isCategory ? moreCat : more} <Icon name="arrow-right" size={16} />
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
  {
    legend && (
      <ol class="scene-legend">
        {items.map((h) => (
          <li>
            {h.href ? (
              <a href={h.href}>
                <span class="n" aria-hidden="true">{h.n}</span>
                <span>{h.title}</span>
                <Icon name="arrow-right" size={16} />
              </a>
            ) : (
              <span>
                <span class="n" aria-hidden="true">{h.n}</span>
                {h.title}
              </span>
            )}
          </li>
        ))}
      </ol>
    )
  }
</div>

<style>
  .scene {
    display: grid;
    gap: var(--s-5);
  }
  .scene-stage {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--mist);
  }
  .scene-stage > :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hs {
    position: absolute;
    width: 0;
    height: 0;
    z-index: 2;
  }
  /* the open card sits above the image; the other dots stay above the card so they remain clickable */
  .hs:has(.hs-dot[aria-expanded='true']) {
    z-index: 3;
  }
  .scene-stage:has(.hs-dot[aria-expanded='true']) .hs:not(:has(.hs-dot[aria-expanded='true'])) {
    z-index: 4;
  }
  .scene-stage:has(.hs-dot[aria-expanded='true']) .hs:not(:has(.hs-dot[aria-expanded='true'])) .hs-dot {
    opacity: 0.75;
  }
  .hs-dot {
    position: absolute;
    left: -22px;
    top: -22px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
    box-shadow:
      0 0 0 2px var(--ink),
      0 6px 16px -6px rgba(10, 10, 8, 0.55);
    transition:
      transform 0.25s var(--ease),
      background-color 0.2s var(--ease);
  }
  .hs-dot:hover,
  .hs-dot[aria-expanded='true'] {
    transform: scale(1.08);
    background: var(--ink);
    color: var(--yellow);
  }
  .hs-dot:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }
  .hs-card {
    position: absolute;
    width: min(300px, 70vw);
    padding: var(--s-5);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 24px 60px -20px rgba(10, 10, 8, 0.45);
    display: grid;
    gap: var(--s-2);
    top: 32px;
    left: -150px;
  }
  .hs-card:not([hidden]) {
    animation: hs-in 0.28s var(--ease);
  }
  @keyframes hs-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  [data-align-x='left'] .hs-card {
    left: -22px;
  }
  [data-align-x='right'] .hs-card {
    left: auto;
    right: -22px;
  }
  [data-align-y='up'] .hs-card {
    top: auto;
    bottom: 32px;
  }
  .hs-title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.25;
  }
  .hs-text {
    font-size: var(--step--1);
    color: var(--steel);
    line-height: 1.5;
  }
  .scene-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 var(--s-6);
    border-top: 1px solid var(--hair);
  }
  .scene-legend li {
    border-bottom: 1px solid var(--hair);
  }
  .scene-legend a,
  .scene-legend li > span {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: 0.9rem 0;
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 500;
  }
  .scene-legend a :global(svg) {
    margin-left: auto;
    flex: none;
    transition: transform 0.25s var(--ease);
  }
  .scene-legend a:hover :global(svg) {
    transform: translateX(3px);
  }
  .n {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 500;
  }
  @media (max-width: 960px) {
    .scene-legend {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .scene-legend {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 720px) {
    .hs-dot {
      left: -15px;
      top: -15px;
      width: 30px;
      height: 30px;
      font-size: 0.8rem;
    }
    /* keep a 44px touch area around the smaller dot */
    .hs-dot::before {
      content: '';
      position: absolute;
      inset: -7px;
      border-radius: 50%;
    }
    .scene-legend li.is-active {
      background: var(--mist);
    }
    .dots-crowded .hs {
      display: none;
    }
    .hs-card {
      display: none !important;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-scene]').forEach((scene) => {
    const btns = Array.from(scene.querySelectorAll<HTMLButtonElement>('[data-hs-btn]'));
    const small = window.matchMedia('(max-width: 720px)');
    const closeAll = (except?: HTMLButtonElement) =>
      btns.forEach((b) => {
        if (b === except) return;
        b.setAttribute('aria-expanded', 'false');
        const card = document.getElementById(b.getAttribute('aria-controls') ?? '');
        if (card) card.hidden = true;
      });
    btns.forEach((b, i) => {
      b.addEventListener('click', () => {
        if (small.matches) {
          // On phones the cards are replaced by the legend: highlight the matching row
          const rows = Array.from(scene.querySelectorAll<HTMLElement>('.scene-legend li'));
          rows.forEach((r, k) => r.classList.toggle('is-active', k === i));
          rows[i]?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
          return;
        }
        const open = b.getAttribute('aria-expanded') !== 'true';
        closeAll(b);
        b.setAttribute('aria-expanded', String(open));
        const card = document.getElementById(b.getAttribute('aria-controls') ?? '');
        if (card) card.hidden = !open;
      });
    });
    document.addEventListener('click', (e) => {
      if (!scene.contains(e.target as Node)) closeAll();
    });
    scene.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const openBtn = btns.find((b) => b.getAttribute('aria-expanded') === 'true');
        closeAll();
        openBtn?.focus();
      }
    });
  });
</script>
