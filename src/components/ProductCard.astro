---
import type { Lang, Product } from '../data/types';
import { productUrl, t } from '../lib/i18n';
import { productImages } from '../lib/images';
import Img from './Img.astro';
import Icon from './Icon.astro';
interface Props {
  lang: Lang;
  product: Product;
  size?: 'normal' | 'large';
  headingLevel?: 'h2' | 'h3';
  sizes?: string;
}
const { lang, product, size = 'normal', headingLevel = 'h3', sizes = '(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw' } = Astro.props;
const { hero } = productImages(product.id);
const Tag = headingLevel;
---
<article class:list={['pcard', `pcard-${size}`]} data-pcard data-pid={product.id}>
  <div class="media pcard-media">
    <Img src={hero} lang={lang} sizes={sizes} widths={[480, 768, 1080, 1440]} />
  </div>
  <div class="pcard-body">
    <Tag class="pcard-title">
      <a href={productUrl(lang, product.category, product.id)} class="stretched" data-pid={product.id} data-pfield="name">{t(product.name, lang)}</a>
    </Tag>
    <p class="pcard-tag" data-pid={product.id} data-pfield="tagline">{t(product.tagline, lang)}</p>
    <p class="pcard-sum" data-pid={product.id} data-pfield="summary">{t(product.summary, lang)}</p>
    <span class="pcard-more" aria-hidden="true">{lang === 'bg' ? 'Виж продукта' : 'View product'} <Icon name="arrow-right" size={16} /></span>
  </div>
</article>
<style>
  .pcard {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--s-4);
  }
  .pcard-media { aspect-ratio: 3 / 2; }
  .pcard-large .pcard-media { aspect-ratio: 16 / 10; }
  .pcard-media :global(img) { transition: opacity 0.35s var(--ease); }
  .pcard:hover .pcard-media :global(img) { opacity: 0.88; }
  .pcard-body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-2); height: 100%; }
  .pcard-title {
    font-size: var(--step-2);
    font-weight: 400;
  }
  .pcard-title a { text-decoration: none; }
  .pcard:hover .pcard-title a {
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 2px;
  }
  .stretched::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .pcard-tag { font-family: var(--font-display); font-size: var(--step-0); color: var(--fg); opacity: 0.85; }
  .pcard-sum { color: var(--muted); font-size: var(--step--1); line-height: 1.55; max-width: 48ch; }
  .pcard-more {
    display: inline-flex; align-items: center; gap: 0.4rem;
    margin-top: auto;
    padding-top: var(--s-2);
    font-size: var(--step--1); font-weight: 600;
  }
  .pcard-more :global(svg) { transition: transform 0.25s var(--ease); }
  .pcard:hover .pcard-more :global(svg) { transform: translateX(3px); }
  .pcard:focus-within { outline: 2px solid var(--focus); outline-offset: 6px; }
  @media (max-width: 640px) {
    .pcard-sum { font-size: var(--step-0); }
  }
  .pcard .stretched:focus-visible { outline: none; }
</style>
