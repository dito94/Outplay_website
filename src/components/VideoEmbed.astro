---
// Video.
// - YouTube URLs (youtube.com / youtu.be): poster (or a dark plate when there is no poster) + play button;
//   the youtube-nocookie iframe loads only on click.
// - Any other URL (e.g. the catalogue's generic outplay.bg/video page): a compact, honest link row
//   ("Video on outplay.bg ↗") that opens the page in a new tab. No poster, no play button.
import type { Lang } from '../data/types';
import Img from './Img.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  url: string;
  title: string;
  /** poster image path relative to src/assets/img (YouTube only; omitted = dark plate) */
  poster?: string;
  /** print the title in the link row (external-link variant); turn off when the page shows it nearby */
  showTitle?: boolean;
  id?: string;
}
const { lang, url, title, poster, showTitle = true, id = 'video' } = Astro.props;

function youtubeId(u: string): string | undefined {
  try {
    const x = new URL(u);
    const host = x.hostname.replace(/^(www|m)\./, '');
    if (host === 'youtu.be') return x.pathname.slice(1).split('/')[0] || undefined;
    if (host === 'youtube.com' || host === 'youtube-nocookie.com') {
      const v = x.searchParams.get('v');
      if (v) return v;
      return x.pathname.match(/\/(?:embed|shorts|live|v)\/([\w-]{6,})/)?.[1];
    }
  } catch {
    /* not a URL */
  }
  return undefined;
}

const yt = youtubeId(url);
const host = (() => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
})();
const embed = yt ? `https://www.youtube-nocookie.com/embed/${yt}?autoplay=1&rel=0&modestbranding=1&playsinline=1` : undefined;
const T = {
  play: { bg: 'Пусни видеото', en: 'Play video' },
  videoOn: { bg: `Видео на ${host}`, en: `Video on ${host}` },
  youtube: { bg: 'Отвори в YouTube', en: 'Open on YouTube' },
  newWindow: { bg: 'отваря се в нов прозорец', en: 'opens in a new window' },
};
---

{
  embed ? (
    <figure class="vid" data-video data-embed={embed} data-title={title} id={id}>
      <div class:list={['vid-frame', 'media', { 'no-poster': !poster }]} data-video-frame>
        {poster && <Img src={poster} lang={lang} alt="" sizes="(min-width: 1440px) 900px, (min-width: 900px) 64vw, 100vw" />}
        {poster && <span class="vid-scrim" aria-hidden="true" />}
        <button type="button" class="vid-play" data-video-play aria-label={`${T.play[lang]}: ${title}`}>
          <span class="vid-disc" aria-hidden="true">
            <Icon name="play" size={26} />
          </span>
          <span class="vid-label" aria-hidden="true">
            {T.play[lang]}
          </span>
        </button>
      </div>
      <figcaption class="vid-cap">
        <span>{title}</span>
        <a class="vid-ext" href={url} target="_blank" rel="noopener">
          {T.youtube[lang]}
          <Icon name="external" size={15} />
          <span class="sr-only">({T.newWindow[lang]})</span>
        </a>
      </figcaption>
    </figure>
  ) : (
    <p class="vid-row" id={id}>
      {showTitle && <span class="vid-row-title">{title}</span>}
      <a class="vid-row-link" href={url} target="_blank" rel="noopener">
        <span>{T.videoOn[lang]}</span>
        <Icon name="external" size={16} />
        <span class="sr-only">{showTitle ? `(${T.newWindow[lang]})` : `(${title}, ${T.newWindow[lang]})`}</span>
      </a>
    </p>
  )
}

<style>
  .vid {
    display: grid;
    gap: var(--s-3);
    margin: 0;
  }
  /* External link row */
  .vid-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-6);
    margin: 0;
    padding-top: var(--s-4);
    border-top: 1px solid var(--hair);
  }
  .vid-row-title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.3;
  }
  .vid-row-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }
  .vid-row-link:hover {
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 2px;
  }
  .vid-frame {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--ink);
  }
  .vid-frame :global(img),
  .vid-frame :global(.img-missing) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vid-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .vid-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 10, 8, 0.72) 0%, rgba(10, 10, 8, 0.25) 50%, rgba(10, 10, 8, 0.15) 100%);
    transition: background-color 0.3s var(--ease);
  }
  .vid-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--s-3);
    width: 100%;
    border: 0;
    padding: 0;
    background: transparent;
    color: #fff;
  }
  .vid-disc {
    display: grid;
    place-items: center;
    width: clamp(64px, 5vw + 40px, 92px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
    box-shadow: 0 16px 40px -14px rgba(10, 10, 8, 0.6);
    transition:
      transform 0.3s var(--ease),
      background-color 0.2s var(--ease);
  }
  .vid-disc :global(svg) {
    margin-left: 4px;
    fill: currentColor;
  }
  .vid-label {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .vid-play:hover .vid-disc {
    transform: scale(1.06);
    background: #fff;
  }
  .vid-play:focus-visible {
    outline: none;
  }
  .vid-play:focus-visible .vid-disc {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }
  .vid-frame.no-poster {
    background: var(--ink-2);
  }
  .vid-cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .vid-ext {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    color: var(--fg);
  }
  .vid.is-playing .vid-scrim,
  .vid.is-playing .vid-play {
    display: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-video-play]');
    const frame = root.querySelector<HTMLElement>('[data-video-frame]');
    btn?.addEventListener('click', () => {
      if (!frame || !root.dataset.embed) return;
      const iframe = document.createElement('iframe');
      iframe.src = root.dataset.embed;
      iframe.title = root.dataset.title ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.querySelectorAll('picture, img, .img-missing').forEach((el) => el.remove());
      frame.appendChild(iframe);
      root.classList.add('is-playing');
      iframe.focus();
    });
  });
</script>
