---
// Video facade.
// - YouTube URLs (youtube.com / youtu.be): poster + play button; the youtube-nocookie iframe loads only on click.
// - Any other URL (e.g. the catalogue's outplay.bg/video page): poster card that opens the page in a new tab.
import type { Lang } from '../data/types';
import Img from './Img.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  url: string;
  title: string;
  /** poster image path relative to src/assets/img */
  poster?: string;
  /** print the title over the poster (external-link variant); turn off when the page shows it nearby */
  showTitle?: boolean;
  id?: string;
}
const { lang, url, title, poster, showTitle = true, id = 'video' } = Astro.props;

function youtubeId(u: string): string | undefined {
  try {
    const x = new URL(u);
    const host = x.hostname.replace(/^(www|m)\./, '');
    if (host === 'youtu.be') return x.pathname.slice(1).split('/')[0] || undefined;
    if (host === 'youtube.com' || host === 'youtube-nocookie.com') {
      const v = x.searchParams.get('v');
      if (v) return v;
      return x.pathname.match(/\/(?:embed|shorts|live|v)\/([\w-]{6,})/)?.[1];
    }
  } catch {
    /* not a URL */
  }
  return undefined;
}

const yt = youtubeId(url);
const host = (() => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
})();
const embed = yt ? `https://www.youtube-nocookie.com/embed/${yt}?autoplay=1&rel=0&modestbranding=1&playsinline=1` : undefined;
const T = {
  play: { bg: 'Пусни видеото', en: 'Play video' },
  watchOn: { bg: `Гледайте видео на ${host}`, en: `Watch the video on ${host}` },
  youtube: { bg: 'Отвори в YouTube', en: 'Open on YouTube' },
  newWindow: { bg: 'отваря се в нов прозорец', en: 'opens in a new window' },
};
---

{
  embed ? (
    <figure class="vid" data-video data-embed={embed} data-title={title} id={id}>
      <div class="vid-frame media" data-video-frame>
        <Img src={poster} lang={lang} alt="" sizes="(min-width: 1440px) 900px, (min-width: 900px) 64vw, 100vw" />
        <span class="vid-scrim" aria-hidden="true" />
        <button type="button" class="vid-play" data-video-play aria-label={`${T.play[lang]}: ${title}`}>
          <span class="vid-disc" aria-hidden="true">
            <Icon name="play" size={26} />
          </span>
          <span class="vid-label" aria-hidden="true">
            {T.play[lang]}
          </span>
        </button>
      </div>
      <figcaption class="vid-cap">
        <span>{title}</span>
        <a class="vid-ext" href={url} target="_blank" rel="noopener">
          {T.youtube[lang]}
          <Icon name="external" size={15} />
          <span class="sr-only">({T.newWindow[lang]})</span>
        </a>
      </figcaption>
    </figure>
  ) : (
    <a class="vid vid-link" href={url} target="_blank" rel="noopener" id={id}>
      <span class="vid-frame media">
        <Img src={poster} lang={lang} alt="" sizes="(min-width: 1440px) 900px, (min-width: 900px) 64vw, 100vw" />
        <span class="vid-scrim" aria-hidden="true" />
        <span class="vid-play" aria-hidden="true">
          <span class="vid-disc">
            <Icon name="play" size={26} />
          </span>
        </span>
        <span class="vid-over">
          {showTitle ? <span class="vid-title">{title}</span> : <span class="sr-only">{title}</span>}
          <span class="vid-go">
            {T.watchOn[lang]}
            <Icon name="external" size={16} />
          </span>
        </span>
      </span>
      <span class="sr-only">({T.newWindow[lang]})</span>
    </a>
  )
}

<style>
  .vid {
    display: grid;
    gap: var(--s-3);
    margin: 0;
  }
  .vid-link {
    display: block;
    text-decoration: none;
    color: #fff;
  }
  .vid-frame {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--ink);
  }
  .vid-frame :global(img),
  .vid-frame :global(.img-missing) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vid-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .vid-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 10, 8, 0.72) 0%, rgba(10, 10, 8, 0.25) 50%, rgba(10, 10, 8, 0.15) 100%);
    transition: background-color 0.3s var(--ease);
  }
  .vid-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--s-3);
    width: 100%;
    border: 0;
    padding: 0;
    background: transparent;
    color: #fff;
  }
  .vid-disc {
    display: grid;
    place-items: center;
    width: clamp(64px, 5vw + 40px, 92px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
    box-shadow: 0 16px 40px -14px rgba(10, 10, 8, 0.6);
    transition:
      transform 0.3s var(--ease),
      background-color 0.2s var(--ease);
  }
  .vid-disc :global(svg) {
    margin-left: 4px;
    fill: currentColor;
  }
  .vid-label {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .vid-play:hover .vid-disc,
  .vid-link:hover .vid-disc {
    transform: scale(1.06);
    background: #fff;
  }
  .vid-play:focus-visible {
    outline: none;
  }
  .vid-play:focus-visible .vid-disc,
  .vid-link:focus-visible .vid-disc {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }
  .vid-link:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }
  .vid-over {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-2) var(--s-5);
    padding: clamp(1rem, 0.6rem + 1.6vw, 2rem);
  }
  .vid-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 300;
    line-height: 1.15;
    max-width: 24ch;
  }
  .vid-go {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-bottom: 2px;
    border-bottom: 1px solid currentColor;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .vid-cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .vid-ext {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    color: var(--fg);
  }
  .vid.is-playing .vid-scrim,
  .vid.is-playing .vid-play {
    display: none;
  }
  @media (max-width: 600px) {
    .vid-title {
      font-size: var(--step-1);
    }
    .vid-link .vid-play {
      align-content: start;
      padding-top: 18%;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-video-play]');
    const frame = root.querySelector<HTMLElement>('[data-video-frame]');
    btn?.addEventListener('click', () => {
      if (!frame || !root.dataset.embed) return;
      const iframe = document.createElement('iframe');
      iframe.src = root.dataset.embed;
      iframe.title = root.dataset.title ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.querySelectorAll('picture, img, .img-missing').forEach((el) => el.remove());
      frame.appendChild(iframe);
      root.classList.add('is-playing');
      iframe.focus();
    });
  });
</script>
