---
// In-page section navigation for product pages. Sticky under the header at every width (a horizontally
// scrollable strip on phones). It follows the header: `--header-offset` (set by the header script) is 0px
// while the header is hidden on scroll-down and the header height while it is shown.
// The current section is highlighted on scroll: the last section whose top has passed a line just under
// the bar wins; any element with data-sn-section="<item id>" counts towards that item.
import type { Lang } from '../data/types';
import { products } from '../data/products';
import { routeOf } from '../lib/i18n';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  items: { id: string; label: string }[];
  /** product name shown at the start of the bar on desktop */
  title?: string;
  cta?: { label: string; href: string };
}
const { lang, items, title, cta } = Astro.props;
const label = lang === 'bg' ? 'Съдържание на страницата' : 'On this page';
// on a catalogue product page the title is the product name: hook for admin-demo renames (src/lib/custom-products.ts)
const routeMatch = routeOf(Astro.url.pathname).match(/^\/products\/([^/]+)\/([^/]+)\/$/);
const pagePid = routeMatch && products.some((p) => p.category === routeMatch[1] && p.id === routeMatch[2]) ? routeMatch[2] : undefined;
---

<nav class="subnav" aria-label={label} data-subnav>
  <div class="wrap sn-inner">
    {
      title && (
        <span class="sn-title" aria-hidden="true" data-pid={pagePid} data-pfield={pagePid ? 'name' : undefined}>
          {title}
        </span>
      )
    }
    <ul class="sn-list" data-sn-list>
      {
        items.map((it) => (
          <li>
            <a href={`#${it.id}`} class="sn-link" data-sn-link={it.id}>
              {it.label}
            </a>
          </li>
        ))
      }
    </ul>
    {
      cta && (
        <a class="btn btn-sm sn-cta" href={cta.href}>
          {cta.label}
          <Icon name="arrow-right" class="arrow" />
        </a>
      )
    }
  </div>
</nav>

<style>
  .subnav {
    position: sticky;
    top: var(--header-offset, var(--header-h));
    z-index: 40;
    background: var(--paper);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .sn-inner {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    min-height: 60px;
  }
  /* The name uses the free space first; it only shortens (faster than the links) when the bar is full */
  .sn-title {
    flex: 0 6 auto;
    min-width: 6ch;
    max-width: 34ch;
    font-family: var(--font-display);
    font-size: var(--step-1);
    padding-right: var(--s-6);
    border-right: 1px solid var(--line);
    line-height: 1.6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sn-list {
    flex: 0 1 auto;
    display: flex;
    gap: var(--s-1);
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .sn-list::-webkit-scrollbar {
    display: none;
  }
  .sn-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 60px;
    padding: 0 var(--s-3);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--steel);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s var(--ease);
  }
  .sn-link::after {
    content: '';
    position: absolute;
    left: var(--s-3);
    right: var(--s-3);
    bottom: -1px;
    height: 2px;
    background: var(--yellow);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .sn-link:hover {
    color: var(--ink);
  }
  .sn-link[aria-current='true'] {
    color: var(--ink);
  }
  .sn-link[aria-current='true']::after {
    transform: scaleX(1);
  }
  .sn-link:focus-visible {
    outline-offset: -4px;
  }
  .sn-cta {
    margin-left: auto;
    flex: none;
  }
  @media (max-width: 1100px) {
    .sn-title {
      display: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .subnav {
      transition: top 0.3s var(--ease);
    }
  }
  @media (max-width: 900px) {
    .sn-inner {
      padding-inline: 0;
      min-height: 52px;
    }
    .sn-list {
      padding-inline: max(var(--gutter), env(safe-area-inset-left, 0px));
      scroll-padding-inline: var(--gutter);
    }
    .sn-link {
      min-height: 52px;
      padding-inline: var(--s-3);
    }
    .sn-list li:first-child .sn-link {
      padding-left: 0;
    }
    .sn-list li:first-child .sn-link::after {
      left: 0;
    }
    .sn-cta {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-subnav]').forEach((nav) => {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-sn-link]'));
    const list = nav.querySelector<HTMLElement>('[data-sn-list]');
    const ids = links.map((a) => a.dataset.snLink ?? '');
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-sn-section]')).filter((el) =>
      ids.includes(el.dataset.snSection ?? ''),
    );
    if (!sections.length) return;

    let current = '';
    const setCurrent = (id: string) => {
      if (id === current) return;
      current = id;
      links.forEach((a) => {
        if (a.dataset.snLink === id) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
      // keep the active link visible in the horizontal strip without moving the page
      const active = links.find((a) => a.dataset.snLink === id);
      if (list && active && list.scrollWidth > list.clientWidth) {
        const l = active.offsetLeft - list.offsetLeft;
        const target = l - (list.clientWidth - active.offsetWidth) / 2;
        list.scrollTo({ left: Math.max(0, target), behavior: 'smooth' });
      }
    };

    // Detection line: header height + bar height + 24px. It does not move with the hiding header, so a
    // section scrolled to by its anchor (html scroll-padding + scroll-margin) is always past it.
    const update = () => {
      const header = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 72;
      const line = header + nav.offsetHeight + 24;
      let id = '';
      for (const s of sections) {
        if (s.getBoundingClientRect().top <= line + 1) id = s.dataset.snSection ?? '';
      }
      // At the very end of the page the last sections may never reach the line: take the lowest one in view
      const doc = document.documentElement;
      if (window.scrollY + window.innerHeight >= doc.scrollHeight - 2) {
        const inView = sections.filter((s) => s.getBoundingClientRect().top < window.innerHeight * 0.6);
        const last = inView[inView.length - 1];
        if (last) id = last.dataset.snSection ?? id;
      }
      setCurrent(id);
    };

    let frame = 0;
    const schedule = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        update();
      });
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('scrollend', update);
    window.addEventListener('resize', schedule);
    window.addEventListener('hashchange', schedule);
    window.addEventListener('load', update);
    update();
  });
</script>
