---
import type { BeforeAfterPair, Lang } from '../data/types';
import { t } from '../lib/i18n';
import Img from './Img.astro';

interface Props {
  lang: Lang;
  pair: BeforeAfterPair;
  sizes?: string;
  start?: number;
}
const { lang, pair, sizes = '(min-width: 1100px) 66vw, 100vw', start = 50 } = Astro.props;
const label = lang === 'bg' ? 'Плъзнете, за да сравните' : 'Drag to compare';
const uid = `ba-${pair.id}-${Math.random().toString(36).slice(2, 7)}`;
---

<figure class="ba" data-ba style={`--pos:${start}%`}>
  <div class="ba-stage">
    <div class="ba-layer ba-after">
      <Img src={pair.after} lang={lang} sizes={sizes} />
    </div>
    <div class="ba-layer ba-before" aria-hidden="true">
      <Img src={pair.before} lang={lang} sizes={sizes} />
    </div>
    <span class="ba-tag ba-tag-before" aria-hidden="true">{t(pair.beforeLabel, lang)}</span>
    <span class="ba-tag ba-tag-after" aria-hidden="true">{t(pair.afterLabel, lang)}</span>
    <span class="ba-handle" aria-hidden="true">
      <span class="ba-knob">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
          ><path d="m9 6-6 6 6 6"></path><path d="m15 6 6 6-6 6"></path></svg
        >
      </span>
    </span>
    <input
      class="ba-range"
      type="range"
      min="0"
      max="100"
      step="0.5"
      value={start}
      id={uid}
      aria-label={`${label}: ${t(pair.beforeLabel, lang)} / ${t(pair.afterLabel, lang)}`}
      data-ba-range
    />
  </div>
  <figcaption class="ba-cap">
    <span class="ba-title">{t(pair.title, lang)}</span>
    <span class="muted">{t(pair.caption, lang)}</span>
  </figcaption>
</figure>

<style>
  .ba {
    display: grid;
    gap: var(--s-4);
  }
  .ba-stage {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--graphite);
    user-select: none;
    touch-action: pan-y;
  }
  .ba-layer {
    position: absolute;
    inset: 0;
  }
  .ba-layer :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ba-before {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .ba-tag {
    position: absolute;
    top: 16px;
    max-width: calc(50% - 32px);
    line-height: 1.3;
    padding: 6px 12px;
    background: rgba(10, 10, 8, 0.72);
    color: #fff;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.02em;
    pointer-events: none;
    transition: opacity 0.2s var(--ease);
  }
  .ba-tag-before {
    left: 16px;
  }
  .ba-tag-after {
    right: 16px;
    background: var(--yellow);
    color: var(--ink);
  }
  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(10, 10, 8, 0.15);
    pointer-events: none;
  }
  .ba-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 52px;
    height: 52px;
    margin: -26px 0 0 -26px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    box-shadow: 0 8px 24px -6px rgba(10, 10, 8, 0.45);
    transition: transform 0.2s var(--ease);
  }
  /* The range input stays for keyboard and screen readers; pointer and touch are handled on the stage */
  .ba-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    -webkit-appearance: none;
    appearance: none;
  }
  .ba-stage {
    cursor: ew-resize;
  }
  .ba-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 52px;
    height: 100vh;
  }
  .ba-range::-moz-range-thumb {
    width: 52px;
    height: 100vh;
    border: 0;
  }
  .ba-stage:has(.ba-range:focus-visible) .ba-knob {
    outline: 3px solid var(--yellow);
    outline-offset: 3px;
  }
  .ba-stage.is-dragging .ba-knob {
    transform: scale(0.94);
  }
  @media (max-width: 600px) {
    .ba-tag {
      top: 10px;
      padding: 5px 9px;
      font-size: 0.8rem;
    }
    .ba-tag-before {
      left: 10px;
    }
    .ba-tag-after {
      right: 10px;
    }
  }
  .ba-cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    font-size: var(--step--1);
  }
  .ba-title {
    font-weight: 600;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((fig) => {
    const range = fig.querySelector<HTMLInputElement>('[data-ba-range]');
    const stage = fig.querySelector<HTMLElement>('.ba-stage');
    if (!range || !stage) return;
    const update = () => {
      fig.style.setProperty('--pos', `${range.value}%`);
      range.setAttribute('aria-valuetext', `${Math.round(Number(range.value))}%`);
    };
    const setFromX = (clientX: number) => {
      const r = stage.getBoundingClientRect();
      const pct = Math.min(100, Math.max(0, ((clientX - r.left) / r.width) * 100));
      range.value = String(Math.round(pct * 2) / 2);
      update();
    };
    range.addEventListener('input', update);
    // arrow keys move 5% (Shift: 10%) instead of the 0.5% step
    range.addEventListener('keydown', (e) => {
      const dir = e.key === 'ArrowRight' || e.key === 'ArrowUp' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowDown' ? -1 : 0;
      if (!dir) return;
      e.preventDefault();
      range.value = String(Math.min(100, Math.max(0, Number(range.value) + dir * (e.shiftKey ? 10 : 5))));
      update();
    });

    // Mouse drags right away; touch moves the divider only on a horizontal swipe or a tap,
    // so a vertical scroll that starts on the image keeps scrolling the page.
    let id: number | null = null;
    let x0 = 0;
    let y0 = 0;
    let dragging = false;
    stage.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      id = e.pointerId;
      x0 = e.clientX;
      y0 = e.clientY;
      dragging = e.pointerType === 'mouse';
      if (dragging) {
        stage.setPointerCapture(id);
        stage.classList.add('is-dragging');
        setFromX(e.clientX);
        e.preventDefault();
      }
    });
    stage.addEventListener('pointermove', (e) => {
      if (e.pointerId !== id) return;
      if (!dragging) {
        const dx = Math.abs(e.clientX - x0);
        const dy = Math.abs(e.clientY - y0);
        if (dx > 8 && dx > dy) {
          dragging = true;
          stage.setPointerCapture(e.pointerId);
          stage.classList.add('is-dragging');
        } else return;
      }
      setFromX(e.clientX);
    });
    const end = (e: PointerEvent, tap: boolean) => {
      if (e.pointerId !== id) return;
      if (tap && !dragging && Math.abs(e.clientX - x0) < 6 && Math.abs(e.clientY - y0) < 6) setFromX(e.clientX);
      id = null;
      dragging = false;
      stage.classList.remove('is-dragging');
    };
    stage.addEventListener('pointerup', (e) => end(e, true));
    stage.addEventListener('pointercancel', (e) => end(e, false));
    update();
  });
</script>
