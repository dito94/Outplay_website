---
// Site-wide search palette (combobox + listbox in a modal dialog). Opens from any [data-search-open]
// element, Ctrl/⌘+K, or "/" outside text fields. The index is fetched on first open.
import type { Lang } from '../data/types';
import { ui } from '../data/ui';
import { pages } from '../data/pages';
import { categories } from '../data/categories';
import { url, categoryUrl, t } from '../lib/i18n';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = (v: { bg: string; en: string }) => t(v, lang);

const T = {
  allResults: { bg: 'Виж всички резултати', en: 'See all results' },
  browse: { bg: 'Разгледайте', en: 'Browse' },
  error: { bg: 'Търсенето не успя да се зареди. Опитайте отново.', en: 'Search could not load. Please try again.' },
  results: { bg: 'Резултати от търсенето', en: 'Search results' },
  /** phones: the full placeholder would be cut off */
  placeholderShort: { bg: 'Търсете продукт', en: 'Search products' },
  cancel: { bg: 'Отказ', en: 'Cancel' },
};
const cats = [...categories].sort((a, b) => a.order - b.order);
const config = {
  index: url(lang, '/search-index.json'),
  page: url(lang, '/search/'),
  s: {
    noResults: tx(ui.search.noResults),
    noResultsHint: tx(ui.search.noResultsHint),
    count: tx(ui.search.resultsCount),
    one: tx(ui.search.resultOne),
    loading: tx(ui.a11y.loading),
    error: tx(T.error),
    groups: {
      product: tx(ui.search.groups.products),
      category: tx(ui.search.groups.categories),
      faq: tx(ui.search.groups.faq),
      page: tx(ui.search.groups.pages),
    },
  },
};
---

<dialog class="sp" aria-labelledby="sp-label" data-sp>
  <div class="sp-panel">
    <form class="sp-bar" role="search" action={url(lang, '/search/')} method="get" data-sp-form>
      <label for="sp-input" id="sp-label" class="sr-only">{tx(ui.search.label)}</label>
      <Icon name="search" size={22} class="sp-icon" />
      <input
        id="sp-input"
        class="sp-input"
        name="q"
        type="search"
        role="combobox"
        aria-expanded="false"
        aria-controls="sp-list"
        aria-autocomplete="list"
        aria-describedby="sp-help"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
        placeholder={tx(ui.search.placeholder)}
        data-ph-short={tx(T.placeholderShort)}
        data-sp-input
      />
      <button type="button" class="sp-clear" data-sp-clear hidden aria-label={tx(ui.actions.clear)}>
        <Icon name="close" size={18} />
      </button>
      <button type="button" class="sp-close" data-sp-close>
        <span class="sp-esc" aria-hidden="true">Esc</span>
        <span class="sr-only sp-close-sr">{tx(ui.a11y.closeSearch)}</span>
        <span class="sp-close-m">{tx(T.cancel)}</span>
      </button>
    </form>

    <div class="sp-body" data-sp-body>
      <div class="sp-empty" data-sp-empty>
        <p class="sp-h">{tx(ui.search.suggestions)}</p>
        <ul class="sp-suggest">
          {
            pages.search.suggestions.map((s) => (
              <li>
                <button type="button" class="sp-chip" data-sp-suggest={t(s, lang)}>
                  <Icon name="search" size={14} />
                  {t(s, lang)}
                </button>
              </li>
            ))
          }
        </ul>
        <p class="sp-h">{tx(T.browse)}</p>
        <ul class="sp-cats">
          {
            cats.map((c) => (
              <li>
                <a href={categoryUrl(lang, c.id)}>
                  {t(c.name, lang)}
                  <Icon name="arrow-right" size={16} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div id="sp-list" class="sp-list" role="listbox" aria-label={tx(T.results)} data-sp-list hidden></div>
      <div class="sp-none" data-sp-none hidden></div>
    </div>

    <div class="sp-foot">
      <p id="sp-help" class="sp-help">{tx(ui.search.navigateHint)}</p>
      <a class="link-arrow sp-all" href={url(lang, '/search/')} data-sp-all hidden>
        {tx(T.allResults)}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
    <p class="sr-only" aria-live="polite" data-sp-status></p>
  </div>
  <script type="application/json" data-sp-config set:html={JSON.stringify(config)} />
</dialog>

<style is:global>
  .sp {
    --bg: var(--paper);
    --fg: var(--ink);
    --muted: var(--steel);
    --hair: var(--line);
    --focus: var(--ink);
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 9vh var(--gutter) var(--s-6);
    border: 0;
    background: transparent;
    color: var(--fg);
    overflow: hidden;
  }
  .sp:not([open]) {
    display: none;
  }
  .sp::backdrop {
    background: rgba(10, 10, 8, 0.6);
  }
  .sp[open] .sp-panel {
    animation: sp-in 0.24s var(--ease);
  }
  .sp[open]::backdrop {
    animation: sp-fade 0.24s var(--ease);
  }
  @keyframes sp-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  @keyframes sp-fade {
    from {
      opacity: 0;
    }
  }
  .sp-panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 760px;
    max-height: min(680px, 100%);
    margin: 0 auto;
    background: var(--paper);
    border-top: 3px solid var(--yellow);
    box-shadow: 0 40px 80px -30px rgba(10, 10, 8, 0.55);
  }
  .sp-bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: 0 var(--s-3) 0 var(--s-5);
    border-bottom: 1px solid var(--line);
  }
  .sp-icon {
    flex: none;
    color: var(--steel);
  }
  .sp-input {
    flex: 1;
    min-width: 0;
    height: 68px;
    border: 0;
    background: none;
    font-size: var(--step-1);
    outline: none;
  }
  .sp-input::-webkit-search-cancel-button {
    display: none;
  }
  .sp-input::placeholder {
    color: color-mix(in srgb, var(--steel) 80%, transparent);
  }
  .sp-clear,
  .sp-close {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 44px;
    padding: 0 0.5rem;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--fg);
  }
  .sp-clear:hover,
  .sp-close:hover {
    background: var(--mist);
  }
  .sp-esc {
    padding: 3px 7px;
    border: 1px solid var(--line);
    border-radius: 3px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--steel);
  }
  .sp-close-m {
    display: none;
  }
  .sp-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--s-3) 0 var(--s-4);
  }
  .sp-h {
    padding: var(--s-3) var(--s-5) var(--s-2);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--steel);
  }
  .sp-suggest {
    list-style: none;
    margin: 0;
    padding: 0 var(--s-5) var(--s-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .sp-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
    border-radius: var(--radius);
    background: none;
    font-size: var(--step--1);
    font-weight: 500;
  }
  .sp-chip:hover {
    border-color: var(--ink);
  }
  .sp-chip svg {
    color: var(--steel);
  }
  .sp-cats {
    list-style: none;
    margin: 0;
    padding: 0 var(--s-5);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--s-5);
  }
  .sp-cats a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: var(--step-0);
    text-decoration: none;
  }
  .sp-cats a:hover {
    text-decoration: underline;
    text-decoration-color: var(--yellow-deep);
    text-decoration-thickness: 2px;
  }
  .sp-group + .sp-group {
    margin-top: var(--s-2);
  }
  .sp-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sp-opt a {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-4);
    min-height: 52px;
    padding: 0.55rem var(--s-5);
    text-decoration: none;
    color: inherit;
  }
  .sp-opt[aria-selected='true'] a {
    background: var(--mist);
  }
  .sp-opt[aria-selected='true'] a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--yellow);
  }
  .sp-thumb {
    width: 64px;
    height: 48px;
    object-fit: cover;
    background: var(--graphite);
  }
  .sp-ico {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    color: var(--steel);
  }
  .sp-t {
    display: block;
    font-weight: 500;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sp-opt-faq .sp-t {
    white-space: normal;
  }
  .sp-s {
    display: block;
    font-size: var(--step--1);
    color: var(--steel);
    line-height: 1.35;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sp mark {
    background: color-mix(in srgb, var(--yellow) 55%, transparent);
    color: inherit;
    padding: 0 1px;
    border-radius: 1px;
  }
  .sp-go {
    color: var(--steel);
    opacity: 0;
    transition: opacity 0.15s var(--ease);
  }
  .sp-opt[aria-selected='true'] .sp-go,
  .sp-opt a:hover .sp-go {
    opacity: 1;
  }
  .sp-none {
    padding: var(--s-5);
    display: grid;
    gap: var(--s-2);
  }
  .sp-none p:first-child {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .sp-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 52px;
    padding: var(--s-2) var(--s-5);
    border-top: 1px solid var(--line);
    background: var(--mist);
  }
  .sp-help {
    font-size: var(--step--2);
    color: var(--steel);
  }
  .sp-all {
    margin-left: auto;
  }
  @media (max-width: 640px), (max-height: 520px) {
    .sp {
      padding: 0;
    }
    .sp-panel {
      max-width: none;
      max-height: none;
      height: 100%;
      border-top: 0;
    }
    .sp-bar {
      padding-left: var(--s-4);
    }
    .sp-esc,
    .sp-close-sr {
      display: none;
    }
    .sp-close-m {
      display: inline;
    }
    /* close becomes a text button so it can't be mistaken for the clear × next to it */
    .sp-close {
      padding: 0 var(--s-3);
      font-size: var(--step--1);
      font-weight: 600;
    }
    .sp-help {
      display: none;
    }
    .sp-cats {
      grid-template-columns: minmax(0, 1fr);
    }
    .sp-opt a,
    .sp-h,
    .sp-suggest,
    .sp-cats,
    .sp-foot {
      padding-left: var(--s-4);
      padding-right: var(--s-4);
    }
  }
  @media (hover: none) {
    .sp-help {
      display: none;
    }
  }
  body.sp-lock {
    overflow: hidden;
  }
</style>

<script>
  import { loadIndex, search, groupHits, highlight, snippet, escapeHtml, type Prepared, type SearchHit } from '../lib/search';

  interface Cfg {
    index: string;
    page: string;
    s: {
      noResults: string;
      noResultsHint: string;
      count: string;
      one: string;
      loading: string;
      error: string;
      groups: Record<string, string>;
    };
  }

  const dialog = document.querySelector<HTMLDialogElement>('[data-sp]');
  if (dialog) {
    const cfg = JSON.parse(dialog.querySelector('[data-sp-config]')?.textContent || '{}') as Cfg;
    const input = dialog.querySelector<HTMLInputElement>('[data-sp-input]')!;
    const form = dialog.querySelector<HTMLFormElement>('[data-sp-form]')!;
    const list = dialog.querySelector<HTMLElement>('[data-sp-list]')!;
    const empty = dialog.querySelector<HTMLElement>('[data-sp-empty]')!;
    const none = dialog.querySelector<HTMLElement>('[data-sp-none]')!;
    const all = dialog.querySelector<HTMLAnchorElement>('[data-sp-all]')!;
    const clear = dialog.querySelector<HTMLButtonElement>('[data-sp-clear]')!;
    const status = dialog.querySelector<HTMLElement>('[data-sp-status]')!;
    // the full placeholder is cut off on phones: swap in the short one there
    const phLong = input.placeholder;
    const phShort = input.dataset.phShort || phLong;
    const phMq = window.matchMedia('(max-width: 640px)');
    const setPlaceholder = () => (input.placeholder = phMq.matches ? phShort : phLong);
    setPlaceholder();
    phMq.addEventListener?.('change', setPlaceholder);
    const LIMIT: Record<string, number> = { product: 6, category: 4, faq: 4, page: 3 };
    const ICONS: Record<string, string> = {
      faq: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M9.6 9.4a2.5 2.5 0 0 1 4.8.9c0 1.7-2.4 2.1-2.4 3.5"/><path d="M12 16.8h.01"/></svg>',
      page: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.5h8l4 4V20a.5.5 0 0 1-.5.5h-11A.5.5 0 0 1 6 20z"/><path d="M14 3.5V8h4M9 12.5h6M9 16h6"/></svg>',
      category: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="4" width="7" height="7"/><rect x="13" y="4" width="7" height="7"/><rect x="4" y="13" width="7" height="7"/><rect x="13" y="13" width="7" height="7"/></svg>',
    };
    const ARROW =
      '<svg class="sp-go" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15"/><path d="m13 6 6 6-6 6"/></svg>';

    let prepared: Prepared[] | null = null;
    let loading: Promise<void> | null = null;
    let opener: HTMLElement | null = null;
    let active = -1;
    let options: HTMLElement[] = [];
    let timer = 0;

    const load = () => {
      if (prepared) return Promise.resolve();
      if (!loading) {
        loading = loadIndex(cfg.index)
          .then((p) => {
            prepared = p;
          })
          .catch(() => {
            loading = null;
            throw new Error('index');
          });
      }
      return loading;
    };

    function setActive(i: number, scroll = true) {
      options.forEach((o, k) => o.setAttribute('aria-selected', String(k === i)));
      active = i;
      const el = options[i];
      if (el) {
        input.setAttribute('aria-activedescendant', el.id);
        if (scroll) el.scrollIntoView({ block: 'nearest' });
      } else input.removeAttribute('aria-activedescendant');
    }

    function render() {
      const q = input.value.trim();
      clear.hidden = !q;
      all.hidden = !q;
      all.href = `${cfg.page}?q=${encodeURIComponent(q)}`;
      if (!q) {
        empty.hidden = false;
        list.hidden = true;
        none.hidden = true;
        list.innerHTML = '';
        options = [];
        setActive(-1);
        input.setAttribute('aria-expanded', 'false');
        status.textContent = '';
        return;
      }
      empty.hidden = true;
      if (!prepared) {
        list.hidden = true;
        none.hidden = false;
        none.innerHTML = `<p class="sp-s">${escapeHtml(cfg.s.loading)}</p>`;
        load()
          .then(render)
          .catch(() => {
            none.innerHTML = `<p>${escapeHtml(cfg.s.error)}</p>`;
          });
        return;
      }
      const hits = search(prepared, q);
      const groups = groupHits(hits);
      if (!groups.length) {
        all.hidden = true; // nothing to see on the results page either
        list.hidden = true;
        list.innerHTML = '';
        options = [];
        setActive(-1);
        input.setAttribute('aria-expanded', 'false');
        none.hidden = false;
        none.innerHTML = `<p>${escapeHtml(cfg.s.noResults.replace('{query}', q))}</p><p class="sp-s" style="white-space:normal">${escapeHtml(cfg.s.noResultsHint)}</p>`;
        status.textContent = cfg.s.noResults.replace('{query}', q);
        return;
      }
      none.hidden = true;
      let n = 0;
      list.innerHTML = groups
        .map((g, gi) => {
          const items = g.hits.slice(0, LIMIT[g.type] ?? 4);
          return `<div class="sp-group" role="group" aria-labelledby="sp-g${gi}"><p class="sp-h" id="sp-g${gi}" role="presentation">${escapeHtml(cfg.s.groups[g.type])}</p><ul role="presentation">${items.map((h) => option(h, q, n++)).join('')}</ul></div>`;
        })
        .join('');
      options = Array.from(list.querySelectorAll<HTMLElement>('[role="option"]'));
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      setActive(0, false);
      list.parentElement!.scrollTop = 0;
      const shown = groups.reduce((n, g) => n + g.hits.length, 0);
      status.textContent = shown === 1 ? cfg.s.one : cfg.s.count.replace('{count}', String(shown));
    }

    function option(h: SearchHit, q: string, i: number): string {
      const d = h.doc;
      const lead = d.img
        ? `<img class="sp-thumb" src="${escapeHtml(d.img)}" alt="" width="64" height="48" loading="lazy" decoding="async">`
        : `<span class="sp-ico">${ICONS[d.type] ?? ICONS.page}</span>`;
      const sub = d.type === 'faq' ? snippet(d.text, q, 110) : d.type === 'page' ? d.text : d.sub;
      return `<li role="option" id="sp-o${i}" class="sp-opt sp-opt-${d.type}" aria-selected="false"><a href="${escapeHtml(d.url)}" tabindex="-1">${lead}<span><span class="sp-t">${highlight(d.title, q)}</span>${sub ? `<span class="sp-s">${highlight(sub, q)}</span>` : ''}</span>${ARROW}</a></li>`;
    }

    function open(from?: HTMLElement | null) {
      if (dialog!.open) return;
      opener = from ?? (document.activeElement as HTMLElement | null);
      try {
        dialog!.showModal();
      } catch {
        dialog!.setAttribute('open', '');
      }
      document.body.classList.add('sp-lock');
      input.focus();
      input.select();
      load().then(() => input.value.trim() && render()).catch(() => {});
      render();
    }
    function close() {
      if (!dialog!.open) return;
      dialog!.close();
    }
    dialog.addEventListener('close', () => {
      document.body.classList.remove('sp-lock');
      const el = opener;
      opener = null;
      if (el && document.contains(el) && el.offsetParent !== null) el.focus();
      else document.querySelector<HTMLElement>('[data-search-open]')?.focus();
    });
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    // click on the backdrop (outside the panel) closes
    dialog.addEventListener('mousedown', (e) => {
      if (e.target === dialog) close();
    });
    dialog.querySelector('[data-sp-close]')?.addEventListener('click', close);
    clear.addEventListener('click', () => {
      input.value = '';
      render();
      input.focus();
    });
    dialog.querySelectorAll<HTMLButtonElement>('[data-sp-suggest]').forEach((b) =>
      b.addEventListener('click', () => {
        input.value = b.dataset.spSuggest || '';
        render();
        input.focus();
      }),
    );
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(render, prepared ? 0 : 60);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        if (!options.length) return;
        e.preventDefault();
        const dir = e.key === 'ArrowDown' ? 1 : -1;
        setActive((active + dir + options.length) % options.length);
      } else if (e.key === 'Home' && e.ctrlKey && options.length) {
        e.preventDefault();
        setActive(0);
      } else if (e.key === 'End' && e.ctrlKey && options.length) {
        e.preventDefault();
        setActive(options.length - 1);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const a = options[active]?.querySelector('a');
        if (a) {
          if (e.metaKey || e.ctrlKey) window.open(a.href, '_blank');
          else window.location.href = a.href;
        } else if (input.value.trim()) window.location.href = all.href;
      }
    });
    list.addEventListener('mousemove', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
      const i = li ? options.indexOf(li) : -1;
      if (i >= 0 && i !== active) setActive(i, false);
    });
    form.addEventListener('submit', (e) => {
      if (!input.value.trim()) e.preventDefault();
    });
    // focus trap (the modal dialog makes the page inert; keep Tab inside the panel too)
    dialog.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const f = Array.from(dialog.querySelectorAll<HTMLElement>('input, button, a[href]')).filter(
        (el) => !el.hidden && el.offsetParent !== null && el.tabIndex >= 0,
      );
      if (!f.length) return;
      const first = f[0];
      const last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Openers
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-search-open]');
      if (!btn) return;
      e.preventDefault();
      // the mobile drawer closes itself on the same click: open after it has restored focus to its toggle
      if (btn.closest('[data-drawer]')) window.setTimeout(() => open(document.querySelector<HTMLElement>('[data-drawer-open]')), 0);
      else open(btn);
    });
    document.addEventListener(
      'pointerenter',
      (e) => {
        const el = e.target as HTMLElement;
        if (el instanceof HTMLElement && el.matches('[data-search-open]')) load().catch(() => {});
      },
      true,
    );
    document.addEventListener('keydown', (e) => {
      if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey) && !e.altKey) {
        e.preventDefault();
        if (dialog.open) close();
        else open();
        return;
      }
      if (e.key === '/' && !dialog.open && !e.metaKey && !e.ctrlKey && !e.altKey) {
        const el = e.target as HTMLElement;
        const typing = el.closest('input, textarea, select, [contenteditable=""], [contenteditable="true"]');
        if (typing) return;
        e.preventDefault();
        open();
      }
    });
  }
</script>
