---
// Shows products added in the admin demo (localStorage, see src/lib/store.ts) on public pages, in this
// browser only: a card in the product grid of their category (wherever that category is listed in full),
// and a link in the header mega-menu and the mobile drawer. Include once per page (in Base.astro): <CustomProducts />
// It reads the existing markup and clones it, so it keeps working when other components change their styles.
import { products } from '../data/products';
import { categories } from '../data/categories';
import { url } from '../lib/i18n';

const data = {
  /** catalogue product id → category id, to recognise which category a grid lists */
  cats: Object.fromEntries(products.map((p) => [p.id, p.category])),
  /** catalogue product ids per category */
  byCat: Object.fromEntries(categories.map((c) => [c.id, products.filter((p) => p.category === c.id).map((p) => p.id)])),
  /** public page of a custom product, per language: <item>?id=c-… */
  item: { bg: url('bg', '/products/item/'), en: url('en', '/products/item/') },
};
---

<script type="application/json" id="cp-data" is:inline set:html={JSON.stringify(data)}></script>
<script>
  import { injectCustomProducts, type CustomProductsConfig } from '../lib/custom-products';
  try {
    const el = document.getElementById('cp-data');
    if (el) injectCustomProducts(JSON.parse(el.textContent || '{}') as CustomProductsConfig);
  } catch {
    /* never break a page for a demo feature */
  }
</script>
