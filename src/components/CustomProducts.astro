---
// Applies the admin demo's browser-local catalogue changes on public pages (see src/lib/custom-products.ts):
// edited and hidden catalogue products, products added in the admin (cards, menu links), balanced product grids
// and updated product counts. Included once per page by src/layouts/Base.astro.
import { products } from '../data/products';
import { categories } from '../data/categories';
import { url } from '../lib/i18n';

const data = {
  /** catalogue product id → category id, to recognise which category a grid lists */
  cats: Object.fromEntries(products.map((p) => [p.id, p.category])),
  /** catalogue product ids per category */
  byCat: Object.fromEntries(categories.map((c) => [c.id, products.filter((p) => p.category === c.id).map((p) => p.id)])),
  /** public page of a custom product, per language: <item>?id=c-… */
  item: { bg: url('bg', '/products/item/'), en: url('en', '/products/item/') },
  /** catalogue names, to rename them inside longer texts (page title, aria-labels) */
  names: Object.fromEntries(products.map((p) => [p.id, p.name])),
  /** mid-sentence forms ("стационарен стъклен покрив") and full catalogue names, also renamed on the product's page */
  inline: Object.fromEntries(products.filter((p) => p.nameInline).map((p) => [p.id, p.nameInline])),
  full: Object.fromEntries(products.map((p) => [p.id, p.fullName])),
  /** subgroups per category with their catalogue product ids (added products can join one) */
  subgroups: Object.fromEntries(
    categories.map((c) => [c.id, (c.subgroups ?? []).map((sg) => ({ id: sg.id, productIds: sg.productIds }))]),
  ),
};
---

<script type="application/json" id="cp-data" is:inline set:html={JSON.stringify(data)}></script>
<script>
  import { applyCatalogue, type CustomProductsConfig } from '../lib/custom-products';
  try {
    const el = document.getElementById('cp-data');
    if (el) applyCatalogue(JSON.parse(el.textContent || '{}') as CustomProductsConfig);
  } catch {
    /* never break a page for a demo feature */
  }
</script>
