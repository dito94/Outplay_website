---
// Applies the admin demo's browser-local catalogue changes on public pages (see src/lib/custom-products.ts):
// edited and hidden catalogue products, products added in the admin (cards, menu links), balanced product grids
// and updated product counts. Included once per page by src/layouts/Base.astro.
// Only a browser with admin-demo data stored loads the code and the catalogue map (src/pages/catalogue-config.json.ts);
// for everyone else this is a few bytes of inline-checked script and nothing else.
import { asset } from '../lib/i18n';
---

<template id="cp-data" data-src={asset('catalogue-config.json')}></template>
<script>
  // same keys as KEYS.overrides / KEYS.customProducts in src/lib/store.ts (not imported, to keep this entry tiny)
  const stored = (() => {
    try {
      const ls = window.localStorage;
      return (ls.getItem('outplay.overrides.v1') || '').length > 2 || (ls.getItem('outplay.customProducts.v1') || '').length > 2;
    } catch {
      return false;
    }
  })();
  // set by the inline check in Base.astro while stored changes are pending
  const reveal = () => document.documentElement.removeAttribute('data-cp');
  const src = document.getElementById('cp-data')?.dataset.src;
  if (stored && src) {
    Promise.all([import('../lib/custom-products'), fetch(src).then((r) => r.json())])
      .then(([m, cfg]) => m.applyCatalogue(cfg as import('../lib/custom-products').CustomProductsConfig))
      .catch(() => {
        /* never break a page for a demo feature */
      })
      .finally(reveal);
  } else reveal();
</script>

<style is:global>
  .cp-notice {
    margin-top: var(--s-5);
    padding: 12px 16px;
    background: var(--mist);
    color: var(--graphite);
    font-size: var(--step--1);
  }
</style>
