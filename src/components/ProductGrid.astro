---
// Responsive grid of ProductCards (3 / 2 / 1 columns) that never leaves an orphan row.
// The first card grows only when that balances the grid:
//   3 columns: n % 3 === 2 → spans 2 columns;  n % 3 === 1 → spans the full row as a horizontal feature.
//   2 columns: n odd → spans the full row as a horizontal feature.
// Cards in one row share the image height and title size; their "View product" links line up at the bottom.
// `compact`: on phones (≤ 600px) the cards become an index list (112px thumbnail, name + tagline).
import type { Lang, Product } from '../data/types';
import ProductCard from './ProductCard.astro';
import { img, productImages } from '../lib/images';

interface Props {
  lang: Lang;
  products: Product[];
  headingLevel?: 'h2' | 'h3';
  /** phones: compact row list instead of full-width cards */
  compact?: boolean;
  class?: string;
}
const { lang, products: items, headingLevel = 'h3', compact = false, class: cls } = Astro.props;
const n = items.length;
const lead3 = n % 3 === 2 ? 'span2' : n % 3 === 1 ? 'full' : 'none';
const lead2 = n % 2 === 1 ? 'full' : 'none';
const hasLead = lead3 !== 'none' || lead2 !== 'none';

/**
 * `sizes` per card. Photos are cropped (object-fit: cover), so a photo wider than its box must be rendered
 * at box height × photo ratio, not just box width, or the browser picks a file that gets upscaled.
 * Boxes: [width, width/height] at ≥1440 (px) and 1100–1439 (vw); 700–1099 and phones in vw.
 */
type Box = [number, number];
const BOX = {
  normal: { xl: [427, 1.5], lg: [31, 1.5] },
  span2: { xl: [877, 2.09], lg: [62, 2.2] }, // fixed shared height clamp(260px, 28vw, 420px)
  beside: { xl: [427, 1.02], lg: [31, 1.1] }, // the card next to a 2-column lead, same height
  full: { xl: [751, 1.6], lg: [54, 1.6] }, // horizontal feature, 16:10 photo
} satisfies Record<string, { xl: Box; lg: Box }>;
function sizesFor(p: Product, i: number): string {
  const m = img(productImages(p.id).hero);
  const ar = m ? m.width / m.height : 1.5;
  const need = ([w, r]: Box) => Math.ceil(w * Math.max(1, ar / r));
  const role = i === 0 && lead3 !== 'none' ? lead3 : i === 1 && lead3 === 'span2' ? 'beside' : 'normal';
  const md: Box = i === 0 && lead2 === 'full' ? [51, 4 / 3] : [46, 1.5];
  const phone = compact ? `(min-width: 601px) ${need([92, 1.5])}vw, ${need([112, 4 / 3])}px` : `${need([92, 1.5])}vw`;
  return `(min-width: 1440px) ${need(BOX[role].xl)}px, (min-width: 1100px) ${need(BOX[role].lg)}vw, (min-width: 700px) ${need(md)}vw, ${phone}`;
}
---

<div class:list={['pgrid', { compact }, cls]} data-lead3={lead3} data-lead2={lead2}>
  {
    items.map((p, i) => (
      <div class="pg-item">
        <ProductCard
          lang={lang}
          product={p}
          size={i === 0 && hasLead ? 'large' : 'normal'}
          headingLevel={headingLevel}
          sizes={sizesFor(p, i)}
        />
      </div>
    ))
  }
</div>

<style>
  .pgrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-8) var(--s-5);
  }
  .pg-item {
    display: grid;
    min-width: 0;
  }
  /* Same image proportion everywhere unless a lead card is promoted */
  .pgrid > .pg-item :global(.pcard .pcard-media) {
    aspect-ratio: 3 / 2;
  }

  @media (min-width: 1100px) {
    .pgrid[data-lead3='span2'] > .pg-item:first-child {
      grid-column: span 2;
    }
    /* Lead row (2-column lead + 1 card): one shared photo height, same title size, so the photos and
       the titles start and end on the same lines */
    .pgrid[data-lead3='span2'] > .pg-item:nth-child(-n + 2) :global(.pcard .pcard-media) {
      aspect-ratio: auto;
      height: clamp(260px, 28vw, 420px);
    }
    .pgrid[data-lead3='full'] > .pg-item:first-child {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 1099px) {
    .pgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-7) var(--s-5);
    }
    .pgrid[data-lead2='full'] > .pg-item:first-child {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 699px) {
    .pgrid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-7);
    }
  }

  /* Compact index list on phones: thumbnail left, name + tagline right, hairlines between rows */
  @media (max-width: 600px) {
    .pgrid.compact {
      gap: 0;
      border-top: 1px solid var(--hair);
    }
    .pgrid.compact > .pg-item {
      border-bottom: 1px solid var(--hair);
    }
    .pgrid.compact > .pg-item :global(.pcard) {
      grid-template-columns: 112px minmax(0, 1fr);
      grid-template-rows: none;
      align-items: center;
      gap: var(--s-4);
      padding-block: var(--s-4);
    }
    .pgrid.compact > .pg-item :global(.pcard .pcard-media) {
      aspect-ratio: 4 / 3;
    }
    .pgrid.compact > .pg-item :global(.pcard-body) {
      height: auto;
      gap: var(--s-1);
    }
    .pgrid.compact > .pg-item :global(.pcard-title) {
      font-size: var(--step-1);
      line-height: 1.2;
    }
    .pgrid.compact > .pg-item :global(.pcard-tag) {
      font-size: var(--step--1);
      line-height: 1.4;
    }
    .pgrid.compact > .pg-item :global(.pcard-sum),
    .pgrid.compact > .pg-item :global(.pcard-more) {
      display: none;
    }
    .pgrid.compact > .pg-item :global(.pcard:focus-within) {
      outline-offset: 2px;
    }
  }

  /* Horizontal feature card: the promoted card while it spans the whole row */
  @media (min-width: 1100px) {
    .pgrid[data-lead3='full'] > .pg-item:first-child :global(.pcard) {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      grid-template-rows: none;
      gap: var(--s-6) clamp(2rem, 1rem + 3vw, 4.5rem);
      align-items: center;
    }
    .pgrid[data-lead3='full'] > .pg-item:first-child :global(.pcard .pcard-media) {
      aspect-ratio: 16 / 10;
    }
    .pgrid[data-lead3='full'] > .pg-item:first-child :global(.pcard-title) {
      font-size: var(--step-3);
      font-weight: 300;
    }
    .pgrid[data-lead3='full'] > .pg-item:first-child :global(.pcard-tag) {
      font-size: var(--step-1);
    }
    .pgrid[data-lead3='full'] > .pg-item:first-child :global(.pcard-sum) {
      font-size: var(--step-0);
      max-width: 44ch;
    }
    /* Alone in its row: the text block is centred beside the photo, the link follows the summary */
    .pgrid[data-lead3='full'] > .pg-item:first-child :global(.pcard-body) {
      height: auto;
    }
    .pgrid[data-lead3='full'] > .pg-item:first-child :global(.pcard-more) {
      margin-top: var(--s-3);
    }
  }
  @media (min-width: 700px) and (max-width: 1099px) {
    .pgrid[data-lead2='full'] > .pg-item:first-child :global(.pcard) {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      grid-template-rows: none;
      gap: var(--s-5) var(--s-6);
      align-items: center;
    }
    .pgrid[data-lead2='full'] > .pg-item:first-child :global(.pcard .pcard-media) {
      aspect-ratio: 4 / 3;
    }
    .pgrid[data-lead2='full'] > .pg-item:first-child :global(.pcard-body) {
      height: auto;
    }
    .pgrid[data-lead2='full'] > .pg-item:first-child :global(.pcard-more) {
      margin-top: var(--s-3);
    }
  }
</style>
