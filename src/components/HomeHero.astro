---
// Full-bleed hero. Signature moment: the photo is seen through a closed bioclimatic roof whose lamellas all rotate
// together (one motor) to the fully open position, hold for a beat, then fade away while the light comes in.
// Pure CSS; skipped entirely with reduced motion.
import type { Lang } from '../data/types';
import Img from './Img.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  image: string;
  title: string;
  lead: string;
  primary: { label: string; href: string };
  secondary: { label: string; href: string };
}
const { lang, image, title, lead, primary, secondary } = Astro.props;
const SLATS = 12;
---

<section class="hero night" aria-labelledby="hero-title">
  <div class="hero-media">
    <Img src={image} lang={lang} priority sizes="(max-width: 600px) 300vw, (max-width: 1100px) 160vw, 100vw" class="hero-img" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="louvre-shade" aria-hidden="true"></div>
    <div class="louvres" aria-hidden="true">
      {Array.from({ length: SLATS }, () => <span />)}
    </div>
  </div>
  <div class="wrap hero-content">
    <h1 id="hero-title" class="display hero-title">{title}</h1>
    <p class="hero-lead">{lead}</p>
    <div class="btn-row hero-ctas">
      <a class="btn" href={primary.href}>{primary.label} <Icon name="arrow-right" class="arrow" /></a>
      <a class="btn btn-ghost" href={secondary.href}>{secondary.label}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(560px, 92svh, 940px);
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero-media :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(10, 10, 8, 0.82) 0%, rgba(10, 10, 8, 0.35) 38%, rgba(10, 10, 8, 0) 62%),
      linear-gradient(to right, rgba(10, 10, 8, 0.45) 0%, rgba(10, 10, 8, 0) 55%);
  }
  .hero-content {
    position: relative;
    padding-top: calc(var(--header-h) + var(--s-8));
    padding-bottom: clamp(3rem, 2rem + 5vw, 6.5rem);
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .hero-title {
    max-width: 15ch;
    color: #fff;
    font-size: clamp(2.7rem, 1.6rem + 4.8vw, 6rem);
  }
  .hero-lead {
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.86);
  }
  .hero-ctas {
    margin-top: var(--s-2);
  }
  .hero .btn-ghost {
    --btn-fg: #fff;
    --btn-bd: rgba(255, 255, 255, 0.5);
  }
  .hero .btn-ghost:hover {
    --btn-bg: #fff;
    --btn-fg: var(--ink);
    --btn-bd: #fff;
  }

  .louvres,
  .louvre-shade {
    display: none;
  }
  /* The lamella angle drives the motion: a lamella seen from below is its full height × cos(angle), so the
     projection can never turn past open or show its back face. */
  @property --louvre-angle {
    syntax: '<angle>';
    inherits: true;
    initial-value: 0deg;
  }
  @media (prefers-reduced-motion: no-preference) {
    .louvres {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-rows: repeat(12, 1fr);
      pointer-events: none;
      /* one motor: every lamella turns together, then the open roof fades away */
      animation:
        louvre-turn 1.05s cubic-bezier(0.45, 0.05, 0.25, 1) 0.12s both,
        louvre-away 0.5s cubic-bezier(0.4, 0, 0.2, 1) 1.5s forwards;
    }
    .louvres span {
      position: relative;
      display: block;
      margin-bottom: -1px; /* no hairline seams while the roof is closed */
      background: linear-gradient(to bottom, #474c51 0%, #2c3034 42%, #17191b 100%);
      transform-origin: 50% 50%;
      transform: scaleY(cos(var(--louvre-angle)));
      will-change: transform;
    }
    /* the lit front edge catches more light as the lamella opens towards the sky */
    .louvres span::after {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 2px;
      background: linear-gradient(to right, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.55) 45%, rgba(255, 255, 255, 0.12));
      opacity: calc(0.25 + 0.75 * sin(var(--louvre-angle)));
      transform: scaleY(calc(1 / max(0.14, cos(var(--louvre-angle)))));
      transform-origin: 50% 0;
    }
    @keyframes louvre-turn {
      from {
        --louvre-angle: 0deg;
      }
      to {
        --louvre-angle: 82deg;
      }
    }
    @keyframes louvre-away {
      to {
        opacity: 0;
        visibility: hidden;
      }
    }
    /* under a closed roof the scene is in shade; light floods in as the lamellas open */
    .louvre-shade {
      position: absolute;
      inset: 0;
      display: block;
      background: rgba(10, 10, 8, 0.55);
      pointer-events: none;
      animation: shade-lift 1.3s cubic-bezier(0.45, 0.05, 0.25, 1) 0.12s forwards;
    }
    @keyframes shade-lift {
      to {
        opacity: 0;
        visibility: hidden;
      }
    }
    .hero-content > * {
      animation: hero-rise 0.7s var(--ease) both;
    }
    .hero-title {
      animation-delay: 0.85s !important;
    }
    .hero-lead {
      animation-delay: 0.97s !important;
    }
    .hero-ctas {
      animation-delay: 1.09s !important;
    }
    @keyframes hero-rise {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
    }
  }
</style>
