---
// Full-bleed hero. Signature moment: the photo is seen through a closed bioclimatic roof whose lamellas all rotate
// together (one motor) to the fully open position, hold for a beat, then fade away while the light comes in.
// The roof is drawn on a canvas at device resolution (no scaled textures, so nothing shimmers); a static CSS copy of
// the closed roof covers the first paint. Skipped entirely without JS or with reduced motion.
import type { Lang } from '../data/types';
import Img from './Img.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  image: string;
  title: string;
  lead: string;
  primary: { label: string; href: string };
  secondary: { label: string; href: string };
}
const { lang, image, title, lead, primary, secondary } = Astro.props;
const SLATS = 12;
---

<section class="hero night" aria-labelledby="hero-title">
  <div class="hero-media">
    <Img src={image} lang={lang} priority sizes="(max-width: 600px) 300vw, (max-width: 1100px) 160vw, 100vw" class="hero-img" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="roof" aria-hidden="true" data-roof data-slats={SLATS}>
      <div class="roof-cover" data-roof-cover>
        {Array.from({ length: SLATS }, () => <span />)}
      </div>
      <canvas class="roof-canvas" data-roof-canvas></canvas>
    </div>
  </div>
  <div class="wrap hero-content">
    <h1 id="hero-title" class="display hero-title">{title}</h1>
    <p class="hero-lead">{lead}</p>
    <div class="btn-row hero-ctas">
      <a class="btn" href={primary.href}>{primary.label} <Icon name="arrow-right" class="arrow" /></a>
      <a class="btn btn-ghost" href={secondary.href}>{secondary.label}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(560px, 92svh, 940px);
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero-media :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(10, 10, 8, 0.82) 0%, rgba(10, 10, 8, 0.35) 38%, rgba(10, 10, 8, 0) 62%),
      linear-gradient(to right, rgba(10, 10, 8, 0.45) 0%, rgba(10, 10, 8, 0) 55%);
  }
  .hero-content {
    position: relative;
    padding-top: calc(var(--header-h) + var(--s-8));
    padding-bottom: clamp(3rem, 2rem + 5vw, 6.5rem);
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .hero-title {
    max-width: 15ch;
    color: #fff;
    font-size: clamp(2.7rem, 1.6rem + 4.8vw, 6rem);
  }
  .hero-lead {
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.86);
  }
  .hero-ctas {
    margin-top: var(--s-2);
  }
  .hero .btn-ghost {
    /* a faint fill keeps the outline button steady over any photo */
    --btn-bg: rgba(10, 10, 8, 0.35);
    --btn-fg: #fff;
    --btn-bd: rgba(255, 255, 255, 0.5);
  }
  .hero .btn-ghost:hover {
    --btn-bg: #fff;
    --btn-fg: var(--ink);
    --btn-bd: #fff;
  }

  .roof {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* only with JS: the canvas script runs the opening; the cover is the closed roof for the first paint */
    :global(html.js) .roof {
      position: absolute;
      inset: 0;
      display: block;
      pointer-events: none;
    }
    .roof-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    .roof-cover {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-rows: repeat(12, 1fr);
      /* safety net: never leave the photo covered if the script can't run */
      animation: roof-cover-away 0.4s ease 3s forwards;
    }
    .roof-cover span {
      background: linear-gradient(to bottom, #4a4f54 0%, #2a2e32 46%, #16181a 100%);
    }
    @keyframes roof-cover-away {
      to {
        opacity: 0;
        visibility: hidden;
      }
    }
    .hero-content > * {
      animation: hero-rise 0.7s var(--ease) both;
    }
    .hero-title {
      animation-delay: 0.55s !important;
    }
    .hero-lead {
      animation-delay: 0.68s !important;
    }
    /* the buttons appear once the roof has cleared (the roof script adds .is-open), with a plain fade:
       nothing moves behind or inside them. Fallback when the script can't run: after 2.6s. */
    :global(html.js) .hero-content > .hero-ctas {
      animation: hero-appear 0.45s ease-out 2.6s both;
    }
    :global(html.js) .hero.is-open .hero-content > .hero-ctas {
      animation: hero-appear 0.45s ease-out both;
    }
    @keyframes hero-appear {
      from {
        opacity: 0;
      }
    }
    @keyframes hero-rise {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
    }
  }
</style>

<script>
  // Bioclimatic roof opening, drawn per frame at device resolution.
  // Each lamella is a profile of depth = pitch and thickness T, turning about its centre. Seen from below
  // (orthographic), it covers pitch·cos(θ) of underside plus T·sin(θ) of its front edge, so near the open position
  // a solid edge remains instead of a vanishing sliver.
  const roof = document.querySelector<HTMLElement>('[data-roof]');
  const hero = roof?.closest<HTMLElement>('.hero');
  const reveal = () => hero?.classList.add('is-open');
  const canvas = roof?.querySelector<HTMLCanvasElement>('[data-roof-canvas]');
  const cover = roof?.querySelector<HTMLElement>('[data-roof-cover]');
  const ctx = canvas?.getContext('2d');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (roof && canvas && ctx && !reduce && getComputedStyle(roof).display !== 'none') {
    const N = Number(roof.dataset.slats) || 12;
    const OPEN = (86 * Math.PI) / 180; // fully open angle
    // timeline (ms)
    const T_START = 60;
    const T_TURN = 850;
    const T_HOLD = 180;
    const T_FADE = 420;
    const TOTAL = T_START + T_TURN + T_HOLD + T_FADE;
    const sineInOut = (x: number) => 0.5 - 0.5 * Math.cos(Math.PI * x);
    const easeOut = (x: number) => 1 - (1 - x) * (1 - x);
    const clamp = (x: number) => Math.min(1, Math.max(0, x));

    let W = 0;
    let H = 0;
    let dpr = 1;
    const size = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const r = roof.getBoundingClientRect();
      W = Math.max(1, Math.round(r.width * dpr));
      H = Math.max(1, Math.round(r.height * dpr));
      canvas.width = W;
      canvas.height = H;
    };

    const draw = (angle: number, shade: number, alpha: number) => {
      ctx.clearRect(0, 0, W, H);
      ctx.globalAlpha = alpha;
      // the scene stays in shade while the roof is closed; light floods in as it opens
      if (shade > 0.001) {
        ctx.fillStyle = `rgba(10, 10, 8, ${shade})`;
        ctx.fillRect(0, 0, W, H);
      }
      const pitch = H / N;
      const thick = Math.max(2.5 * dpr, pitch * 0.07);
      const c = Math.cos(angle);
      const sn = Math.sin(angle);
      const face = pitch * c + (angle < 0.02 ? 1 : 0); // overlap while closed: no seams
      const edge = thick * sn;
      const total = face + edge;
      // underside turns away from the light: a touch darker as it opens
      const dim = 0.28 * sn;
      for (let i = 0; i < N; i++) {
        const top = pitch * (i + 0.5) - total / 2;
        // front edge (catches the sky light)
        if (edge > 0.25) {
          const eg = ctx.createLinearGradient(0, top, 0, top + edge);
          eg.addColorStop(0, '#727980');
          eg.addColorStop(1, '#4a4f55');
          ctx.fillStyle = eg;
          ctx.fillRect(0, top, W, edge);
        }
        // underside
        if (face > 0.25) {
          const fy = top + edge;
          const g = ctx.createLinearGradient(0, fy, 0, fy + face);
          g.addColorStop(0, '#4a4f54');
          g.addColorStop(0.46, '#2a2e32');
          g.addColorStop(1, '#16181a');
          ctx.fillStyle = g;
          ctx.fillRect(0, fy, W, face);
          if (dim > 0.002) {
            ctx.fillStyle = `rgba(10, 10, 8, ${dim})`;
            ctx.fillRect(0, fy, W, face);
          }
        }
        // soft crease light where edge meets underside
        if (sn > 0.05) {
          ctx.fillStyle = `rgba(255, 255, 255, ${0.1 * sn})`;
          ctx.fillRect(0, top + edge - dpr * 0.5, W, dpr);
        }
      }
      ctx.globalAlpha = 1;
    };

    let t0 = 0;
    const frame = (now: number) => {
      if (!t0) t0 = now;
      const t = now - t0;
      const turn = sineInOut(clamp((t - T_START) / T_TURN));
      const fade = sineInOut(clamp((t - T_START - T_TURN - T_HOLD) / T_FADE));
      draw(turn * OPEN, 0.5 * (1 - easeOut(turn)), 1 - fade);
      if (fade > 0.85) reveal(); // the roof is almost gone: bring in the buttons
      if (t < TOTAL) requestAnimationFrame(frame);
      else {
        window.removeEventListener('resize', size);
        roof.remove();
      }
    };

    const start = () => {
      size();
      draw(0, 0.5, 1); // identical to the CSS cover, so the hand-over is invisible
      cover?.remove();
      requestAnimationFrame(frame);
    };
    window.addEventListener('resize', size, { passive: true });
    // a tab opened in the background starts the opening when it is first shown
    if (document.hidden) document.addEventListener('visibilitychange', start, { once: true });
    else start();
  } else {
    roof?.remove();
    reveal();
  }
</script>
