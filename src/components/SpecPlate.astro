---
// Product highlights as an aluminium data plate: a riveted hairline panel, big light numerals with units,
// labels underneath, hairline separators. 2–4 cells; on phones the cells become rows (value | label).
// Only real figures are shown: a value must contain a digit and not be a bare "0" (so "RAL", "LED" or
// "0 floor guides" stay in the copy, not on the plate). With fewer than 2 figures the plate is not rendered.
import type { Highlight, Lang } from '../data/types';
import { t } from '../lib/i18n';

interface Props {
  lang: Lang;
  highlights: Highlight[];
  /** product name printed on the plate's identity strip */
  name: string;
  /** accessible heading for the plate */
  title: string;
  id?: string;
}
const { lang, highlights: all, name, title, id = 'spec-plate' } = Astro.props;
const isFigure = (v: string) => /\d/.test(v) && !/^\s*0\s*$/.test(v);
const highlights = all.filter((h) => isFigure(h.value)).slice(0, 4);
const n = Math.max(1, highlights.length);
---

{
  highlights.length >= 2 && (
    <section class="plate" aria-labelledby={`${id}-title`} style={`--n:${n}`}>
      <h2 id={`${id}-title`} class="sr-only">
        {title}
      </h2>
      <div class="plate-strip" aria-hidden="true">
        <span class="plate-brand">OUTPLAY</span>
        <span class="plate-name">{name}</span>
      </div>
      <dl class="plate-grid">
        {highlights.map((h) => (
          <div class="cell">
            <dt class="label">{t(h.label, lang)}</dt>
            <dd class="value num">
              <span class="v">{h.value}</span>
              {h.unit && <span class="unit">{t(h.unit, lang)}</span>}
            </dd>
          </div>
        ))}
      </dl>
      <span class="rivet r1" aria-hidden="true" />
      <span class="rivet r2" aria-hidden="true" />
      <span class="rivet r3" aria-hidden="true" />
      <span class="rivet r4" aria-hidden="true" />
    </section>
  )
}

<style>
  .plate {
    position: relative;
    background: var(--mist);
    border: 1px solid var(--line);
    color: var(--ink);
  }
  .plate-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    padding: 0.7rem clamp(1.25rem, 0.8rem + 1.6vw, 2.25rem);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: var(--step--2);
    letter-spacing: 0.22em;
    color: var(--steel);
  }
  .plate-brand {
    font-weight: 500;
    color: var(--ink);
  }
  .plate-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    letter-spacing: 0.08em;
  }
  .plate-grid {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    margin: 0;
  }
  .cell {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: clamp(1.4rem, 1rem + 1.4vw, 2.25rem) clamp(1.25rem, 0.8rem + 1.6vw, 2.25rem);
    min-width: 0;
  }
  .cell + .cell {
    border-left: 1px solid var(--line);
  }
  .value {
    order: -1;
    margin: 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 0.4rem;
    font-family: var(--font-display);
    line-height: 1;
  }
  .v {
    font-weight: 300;
    font-size: clamp(2.3rem, 1.7rem + 2.2vw, 3.6rem);
    letter-spacing: -0.02em;
  }
  .unit {
    font-size: var(--step-1);
    font-weight: 400;
    color: var(--steel);
  }
  .label {
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--steel);
    max-width: 30ch;
  }
  .rivet {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #d4d6d8;
    box-shadow: inset 0 0 0 1px #b9bcbf;
  }
  .r1 {
    top: 8px;
    left: 8px;
  }
  .r2 {
    top: 8px;
    right: 8px;
  }
  .r3 {
    bottom: 8px;
    left: 8px;
  }
  .r4 {
    bottom: 8px;
    right: 8px;
  }
  @media (max-width: 760px) {
    .plate-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .cell {
      display: grid;
      grid-template-columns: minmax(6.5rem, 0.8fr) minmax(0, 1.2fr);
      align-items: center;
      gap: var(--s-4);
      padding-block: 1.1rem;
    }
    .cell + .cell {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .value {
      grid-column: 1;
      grid-row: 1;
    }
    .label {
      grid-column: 2;
      grid-row: 1;
    }
    .v {
      font-size: 2.1rem;
    }
    .unit {
      font-size: var(--step-0);
    }
  }
</style>
