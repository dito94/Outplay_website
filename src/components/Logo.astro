---
// The vectorised logo stays crisp as inline SVG. The plain logo references the page's single <symbol>
// (src/components/LogoSymbol.astro, emitted by Base) instead of repeating 11 KB of path data per use;
// `tone` sets the ink colour for light or dark grounds. The tagline version is still inlined.
interface Props {
  tone?: 'dark' | 'light';
  class?: string;
  tagline?: boolean;
}
const { tone = 'dark', class: cls, tagline = false } = Astro.props;

const svgs = import.meta.glob<string>('/src/assets/img/brand/logo-tagline*.svg', { query: '?raw', import: 'default', eager: true });
let raw = tagline ? svgs['/src/assets/img/brand/logo-tagline.svg'] : undefined;
const ink = tone === 'light' ? '#FFFFFF' : '#0A0A08';
if (raw && tagline && tone === 'light') {
  raw = raw.replace(/#0a0a08|#000000|#000\b|black/gi, '#ffffff');
}
if (raw) {
  raw = raw
    .replace(/<\?xml[^>]*>/, '')
    .replace(/<!--[\s\S]*?-->/g, '')
    .replace(/\s(width|height)="[^"]*"/g, '')
    .replace('<svg', '<svg aria-hidden="true" focusable="false" preserveAspectRatio="xMinYMid meet"');
}
---

<span class:list={['logo', `logo-${tone}`, cls]}>
  {
    raw ? (
      <Fragment set:html={raw} />
    ) : (
      <svg viewBox="0 0 317.23 187.77" aria-hidden="true" focusable="false" preserveAspectRatio="xMinYMid meet" style={`--logo-ink:${ink}`}>
        <use href="#op-logo" />
      </svg>
    )
  }
  <span class="sr-only">OUTPLAY</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }
  .logo :global(svg) {
    height: 100%;
    width: auto;
    max-width: none;
  }
</style>
