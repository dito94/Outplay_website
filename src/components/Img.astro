---
import type { Lang } from '../data/types';
import { altOf, focalOf } from '../lib/images';
import { responsive, DEFAULT_WIDTHS, type Crop } from '../lib/responsive';

interface Props {
  src: string | undefined;
  lang: Lang;
  alt?: string;
  sizes?: string;
  widths?: number[];
  /** cropped rendition for small screens (see src/lib/responsive.ts); renders a <picture> */
  crop?: Crop;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  class?: string;
  /** class of the <picture> wrapper (only rendered with `crop`) */
  pictureClass?: string;
  position?: string;
}

const {
  src,
  lang,
  alt,
  sizes = '100vw',
  widths = DEFAULT_WIDTHS,
  crop,
  loading,
  priority = false,
  class: cls,
  pictureClass,
  position,
} = Astro.props;

const r = await responsive(src, { sizes, widths, crop });
const focal = position ?? focalOf(src);
const altText = alt ?? altOf(src, lang);
const attrs = r && {
  src: r.main.src,
  srcset: r.main.srcSet.attribute,
  sizes,
  alt: altText,
  loading: priority ? ('eager' as const) : (loading ?? ('lazy' as const)),
  decoding: priority ? ('sync' as const) : ('async' as const),
  fetchpriority: priority ? ('high' as const) : ('auto' as const),
  style: focal ? `object-position:${focal}` : undefined,
  width: r.main.attributes.width,
  height: r.main.attributes.height,
};
---

{
  r && attrs ? (
    r.crop ? (
      <picture class={pictureClass}>
        <source media={r.crop.media} srcset={r.crop.srcset} sizes={r.crop.sizes} type="image/webp" />
        <img {...attrs} class={cls} />
      </picture>
    ) : (
      <img {...attrs} class={cls} />
    )
  ) : (
    <div class:list={['img-missing', cls]} role="img" aria-label={altText} />
  )
}

<style>
  /* the wrapper must not change layout: the <img> keeps sizing against the same parent as without a crop */
  picture {
    display: contents;
  }
  .img-missing {
    width: 100%;
    height: 100%;
    min-height: 160px;
    background:
      linear-gradient(135deg, transparent 49.5%, rgba(255, 255, 255, 0.08) 50%, transparent 50.5%),
      var(--graphite);
  }
</style>
