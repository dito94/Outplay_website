---
import { Picture } from 'astro:assets';
import type { Lang } from '../data/types';
import { img, altOf, focalOf } from '../lib/images';

interface Props {
  src: string | undefined;
  lang: Lang;
  alt?: string;
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  class?: string;
  pictureClass?: string;
  position?: string;
}

const {
  src,
  lang,
  alt,
  sizes = '100vw',
  widths = [480, 768, 1080, 1440, 1920, 2400],
  loading,
  priority = false,
  class: cls,
  pictureClass,
  position,
} = Astro.props;

const image = img(src);
const usable = image ? widths.filter((w) => w <= image.width) : [];
if (image && (usable.length === 0 || usable[usable.length - 1] < image.width)) usable.push(image.width);
const focal = position ?? focalOf(src);
const altText = alt ?? altOf(src, lang);
---

{
  image ? (
    <Picture
      src={image}
      formats={['webp']}
      widths={usable}
      sizes={sizes}
      alt={altText}
      loading={priority ? 'eager' : (loading ?? 'lazy')}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : 'auto'}
      class={cls}
      style={focal ? `object-position:${focal}` : undefined}
      pictureAttributes={{ class: pictureClass }}
    />
  ) : (
    <div class:list={['img-missing', cls]} role="img" aria-label={altText} />
  )
}

<style>
  .img-missing {
    width: 100%;
    height: 100%;
    min-height: 160px;
    background:
      linear-gradient(135deg, transparent 49.5%, rgba(255, 255, 255, 0.08) 50%, transparent 50.5%),
      var(--graphite);
  }
  picture {
    display: contents;
  }
</style>
